{
  "kind": "collectionType",
  "collectionName": "compositions",
  "info": {
    "singularName": "composition",
    "pluralName": "compositions",
    "displayName": "compositions (OLD)"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "Set": {
      "type": "enumeration",
      "required": true,
      "default": "set17",
      "enum": [
        "set16",
        "set17"
      ]
    },
    "slug": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "tier": {
      "type": "enumeration",
      "enum": [
        "S Tier",
        "A Tier",
        "B Tier",
        "C Tier"
      ]
    },
    "author": {
      "type": "string",
      "default": "AKAWonder"
    },
    "tags": {
      "type": "string"
    },
    "description": {
      "type": "blocks"
    },
    "gameplayMode": {
      "type": "text"
    },
    "compCode": {
      "type": "string"
    },
    "board": {
      "type": "json",
      "required": false
    },
    "coreItems": {
      "type": "json"
    },
    "augments": {
      "type": "json"
    }
  }
}
