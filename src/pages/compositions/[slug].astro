---
import Layout from "../../layouts/Layout.astro";
import TFTBoardFromData from "../../components/TFTBoardFromData.astro";
import { getCompositions, getComposition } from "../../lib/directus";
import ItemWithImage from "../../components/ItemWithImage.astro";
import AugmentGrid from "../../components/AugmentGrid.astro";
import dayjs from "dayjs";
import utc from "dayjs/plugin/utc";
import relativeTime from "dayjs/plugin/relativeTime";
import es from "dayjs/locale/es";
import {getChampionImage, getChampionNames, getItemImage, getItemNames} from "../../utils/assets.ts";
dayjs.locale(es);
dayjs.extend(utc);
dayjs.extend(relativeTime);

export async function getStaticPaths() {
    const { data: compositions } = await getCompositions();

    return compositions ? compositions.map((composition: any) => ({
        params: { slug: composition.slug },
        props: { composition },
    })) : [];
}

const { composition } = Astro.props;
const { slug } = Astro.params;

// Fallback para SSR si no se encontró en getStaticPaths
if (!composition && slug) {
  const { data: fetchedComposition, error } = await getComposition(slug as string);
  if (error || !fetchedComposition) {
    return Astro.redirect('/404');
  }
  Astro.props.composition = fetchedComposition;
}

const currentComposition = Astro.props.composition;

if (!currentComposition) {
  return Astro.redirect('/404');
}

const lastModified = dayjs(currentComposition.date_updated || currentComposition.date_created).utc().fromNow();

export function parseImages(description: string): string {
    let result = description;
    const allKeywords = getItemNames().concat(getChampionNames());
    for (const matchName of allKeywords) {
        result = result.replace(new RegExp(`${matchName}`, 'gi'), `<b>${matchName}</b> <img src="${getChampionNames().includes(matchName) ? getChampionImage(matchName) : getItemImage(matchName)}.png" alt="${matchName}" class="rounded-full aspect-square h-7 inline align-middle border-2 border-primary object-fill drop-shadow-md"/>`);
    }
    return result;
}
---

<Layout title={`${currentComposition.tier} - ${currentComposition.title}`}>
    <main class="flex-grow container mx-auto px-2 sm:px-4 lg:px-6 py-6 md:py-8">
        <div class="max-w-6xl mx-auto">
            <div class="mb-6">
                <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-3">
                    <div>
                        <h1 class="text-3xl md:text-4xl font-bold  text-white">
                            <span class="text-primary">{currentComposition.tier}</span> - {currentComposition.title}
                        </h1>
                        <p class="text-sm text-slate-400 mt-2">
                            Actualizado {lastModified} por
                            <a class="font-medium text-primary hover:underline" href="#">{currentComposition.author}</a>
                        </p>
                    </div>
                    <button class="flex items-center justify-center gap-2 px-4 py-2 rounded-lg bg-primary text-white text-sm font-bold shadow-lg shadow-primary/30 hover:bg-primary/90 transition-all">
                        <span class="material-symbols-outlined">content_copy</span>
                        Copiar enlace
                    </button>
                </div>
                <div class="mt-4 flex flex-wrap gap-2">
                    {currentComposition.tags && currentComposition.tags.map((tag: string) => (
                            <span class="px-3 py-1 text-xs font-semibold rounded-full bg-primary/10 text-primary">
              {tag}
            </span>
                    ))}
                </div>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-3 gap-4 lg:gap-6">
                <div class="lg:col-span-2">
                    <h2 class="text-2xl font-bold text-white mb-4">Composición</h2>
                    {currentComposition.board ? (
                      <div class="relative  bg-slate-800/20 rounded-xl p-4 border border-slate-800">
                          <TFTBoardFromData boardSize="large" boardData={currentComposition.board}/>
                      </div>
                    ) : (
                      <div class="relative bg-slate-800/20 rounded-xl p-4 border border-slate-800 text-center">
                        <p class="text-slate-400">Board no configurado aún</p>
                      </div>
                    )}

                    <div class="mt-6 space-y-5">
                        <div>
                            <h3 class="text-xl font-bold text-white mb-3">Cuándo jugarla</h3>
                            <p class="text-sm text-slate-300 leading-relaxed">
                                <Fragment set:html={parseImages(currentComposition.description)}/>
                            </p>
                        </div>
                        <div>
                            <h3 class="text-xl font-bold text-white mb-3">Modo de juego</h3>
                            <p class="text-sm text-slate-300 leading-relaxed">
                                <Fragment set:html={parseImages(currentComposition.gameplayMode)}/>
                            </p>
                        </div>
                    </div>
                </div>

                <div class="space-y-6">
                    <!-- Core Items -->
                    {currentComposition.coreItems && currentComposition.coreItems.length > 0 && (
                      <div>
                          <h2 class="text-2xl font-bold text-white mb-4">Core Items</h2>
                          <div class="space-y-3">
                              {currentComposition.coreItems.map((item: any) => (
                                      <div class="p-4 rounded-lg bg-slate-800/50 border border-slate-800">
                                          <ItemWithImage itemName={item.name} description={item.description}
                                                         size="medium"/>
                                      </div>
                              ))}
                          </div>
                      </div>
                    )}

                    <!-- Recommended Augments -->
                    {currentComposition.augments && currentComposition.augments.length > 0 && (
                      <div>
                          <h2 class="text-2xl font-bold text-white mb-4">Recommended Augments</h2>
                          <AugmentGrid augments={currentComposition.augments}/>
                      </div>
                    )}
                </div>
            </div>
        </div>
    </main>
</Layout>