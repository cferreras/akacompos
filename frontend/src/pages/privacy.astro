---
import Layout from "../layouts/Layout.astro";
import LegalPage from "../components/legal/LegalPage.astro";

export const prerender = true;

const sections = [
    {
        id: "datos-minimos",
        title: "Qué información técnica usamos",
        body: [
            "AKACompos está planteado para consumir la menor cantidad posible de información del visitante. No pedimos registro, no abrimos perfiles personales y no convertimos la navegación en un sistema de seguimiento invasivo.",
            "La web puede utilizar almacenamiento local del navegador para recordar preferencias de visualización o mejoras de experiencia, y usa analítica agregada para entender qué composiciones interesan más a la comunidad.",
        ],
        bullets: [
            "Preferencias guardadas en el navegador para mejorar la experiencia de uso.",
            "Medición anónima y agregada de visitas, páginas vistas y contenidos más consultados.",
            "Información técnica básica necesaria para servir la web con seguridad y estabilidad.",
        ],
    },
    {
        id: "lo-que-no-hacemos",
        title: "Lo que no hacemos con tus datos",
        body: [
            "El objetivo del sitio es ofrecer información útil sobre TFT, no construir perfiles de usuario. Por eso evitamos prácticas que no aportan valor real a quien visita AKACompos.",
        ],
        bullets: [
            "No vendemos datos a terceros.",
            "No hacemos seguimiento publicitario fuera de AKACompos.",
            "No te pedimos correo, contraseña ni datos personales para consultar composiciones.",
        ],
        note: "La filosofía general es simple: recoger lo mínimo, explicar lo necesario y no complicar al usuario con capas innecesarias de rastreo.",
    },
    {
        id: "base-y-contacto",
        title: "Finalidad y contexto del tratamiento",
        body: [
            "La información técnica que pueda generarse se usa exclusivamente para operar la plataforma, detectar errores, entender tendencias generales de uso y mejorar el contenido publicado por AKAWonder.",
            "Si en el futuro se añadieran nuevas funcionalidades que cambien este alcance, la política se actualizará para reflejarlo de forma expresa y visible.",
        ],
        note: "AKACompos está hecho por y para la comunidad. La privacidad no se trata como letra pequeña, sino como parte del producto.",
    },
];
---

<Layout 
    title="Política de Privacidad - AKACompos"
    description="Información clara sobre cómo tratamos los datos técnicos mínimos en AKACompos."
>
    <LegalPage
        eyebrow="Privacidad"
        title="Política de Privacidad"
        intro="Transparencia directa sobre la información técnica mínima que utiliza AKACompos para funcionar, medir el interés del meta y mantener una experiencia limpia para la comunidad."
        outro="Privacidad clara, sin humo y sin mecánicas innecesarias."
        sections={sections}
    />
</Layout>