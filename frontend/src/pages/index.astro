---
import Layout from "../layouts/Layout.astro";
import Container from "../components/ui/Container.astro";
import { Image } from "astro:assets";
import akaWonderImage from "../assets/akawonder.png";
import { getCompositionsByTier, getCompositionsCount } from "../lib/strapi";

export const prerender = true;

const { data: featuredCompositions } = await getCompositionsByTier("S Tier");
const topCompositions = featuredCompositions?.slice(0, 3) || [];
const { data: totalCompositions } = await getCompositionsCount();

const lastUpdate = featuredCompositions?.[0]?.updatedAt
    ? new Date(featuredCompositions[0].updatedAt).toLocaleDateString('es-ES', { day: 'numeric', month: 'long' })
    : null;
---

<Layout>
    <!-- HERO SECTION -->
    <section class="relative min-h-[90vh] flex items-center pt-20 overflow-hidden bg-[#0c0a09]">
        <!-- Abstract magical background elements -->
        <div class="absolute right-[-10%] top-0 w-[60vw] h-[60vw] bg-[#d4af37] rounded-full mix-blend-screen filter blur-[200px] opacity-[0.08] animate-pulse pointer-events-none"></div>
        <div class="absolute left-[-10%] bottom-[-20%] w-[50vw] h-[50vw] bg-[#7f1d1d] rounded-full mix-blend-screen filter blur-[200px] opacity-[0.15] pointer-events-none"></div>

        <Container maxWidth="xl" className="relative z-10">
            <div class="grid lg:grid-cols-12 gap-16 items-center">
                
                <!-- Hero Text -->
                <div class="lg:col-span-7 space-y-10">
                    {lastUpdate && (
                        <div class="inline-flex items-center gap-3 border border-[#d4af37]/30 px-5 py-2 bg-[#1c1917]/80 backdrop-blur-md">
                            <span class="w-1.5 h-1.5 bg-[#d4af37] animate-ping"></span>
                            <span class="text-[10px] tracking-[0.25em] text-[#d4af37] uppercase font-bold">Códice actualizado: {lastUpdate}</span>
                        </div>
                    )}

                    <h1 class="font-serif text-7xl md:text-[7rem] lg:text-[8rem] leading-[0.85] text-[#f5f5f4] tracking-tight drop-shadow-2xl">
                        EL ARTE<br/>
                        <span class="italic text-[#d4af37] font-light">DE VENCER</span><br/>
                        EN TFT.
                    </h1>

                    <p class="text-xl md:text-2xl text-[#a8a29e] max-w-xl font-light leading-relaxed border-l-2 border-[#d4af37] pl-6">
                        Desbloquea el conocimiento arcano del meta actual. Estrategias curadas y perfeccionadas por el Gran Maestro <span class="text-[#f5f5f4] font-medium">AKAWonder</span>.
                    </p>

                    <div class="flex flex-col sm:flex-row gap-8 pt-6 items-center">
                        <a href="/compositions" class="w-full sm:w-auto relative group inline-flex items-center justify-center px-10 py-5 bg-[#d4af37] text-[#0c0a09] text-sm tracking-[0.2em] font-bold uppercase overflow-hidden transition-all hover:scale-105 shadow-[0_0_40px_rgba(212,175,55,0.2)]">
                            <span class="relative z-10 flex items-center gap-3">
                                Leer el Tomo
                                <i class="fa-solid fa-book-open"></i>
                            </span>
                            <div class="absolute inset-0 bg-white/30 translate-y-full group-hover:translate-y-0 transition-transform duration-300 ease-out"></div>
                        </a>
                        
                        <div class="flex items-center gap-8 text-[#a8a29e] w-full sm:w-auto justify-center sm:justify-start">
                            <div class="flex flex-col items-center sm:items-start">
                                <span class="font-serif text-4xl text-[#f5f5f4]">{totalCompositions}+</span>
                                <span class="text-[9px] tracking-[0.2em] uppercase mt-1">Estrategias</span>
                            </div>
                            <div class="w-px h-12 bg-[#292524]"></div>
                            <div class="flex flex-col items-center sm:items-start">
                                <span class="font-serif text-4xl text-[#d4af37]">S-Tier</span>
                                <span class="text-[9px] tracking-[0.2em] uppercase mt-1">Poder Bruto</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Hero Image -->
                <div class="lg:col-span-5 relative hidden lg:block">
                    <!-- Layered Frames -->
                    <div class="absolute inset-0 border border-[#d4af37]/40 translate-x-6 -translate-y-6 z-0"></div>
                    <div class="absolute inset-0 border border-[#292524] -translate-x-6 translate-y-6 bg-[#1c1917] z-0"></div>
                    
                    <div class="relative z-10 overflow-hidden filter grayscale contrast-125 brightness-90 hover:grayscale-0 hover:contrast-100 transition-all duration-1000 group">
                        <Image
                            src={akaWonderImage}
                            alt="AKAWonder"
                            class="w-full h-[700px] object-cover object-top opacity-90 group-hover:scale-105 transition-transform duration-1000"
                            width={700}
                            height={900}
                            quality={100}
                            loading="eager"
                        />
                        <!-- Vignette -->
                        <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,transparent_0%,#0c0a09_120%)]"></div>
                        <div class="absolute inset-0 bg-gradient-to-t from-[#0c0a09] via-transparent to-transparent opacity-90"></div>
                    </div>

                    <!-- Floating Badge -->
                    <div class="absolute -bottom-10 -left-16 bg-[#0c0a09] border border-[#d4af37]/40 p-8 z-20 shadow-2xl backdrop-blur-md flex items-center gap-6">
                        <div class="w-16 h-16 border border-[#d4af37] rounded-full flex items-center justify-center text-[#d4af37]">
                            <i class="fa-solid fa-crown text-2xl"></i>
                        </div>
                        <div>
                            <p class="font-serif text-2xl text-[#f5f5f4] mb-1">AKAWonder</p>
                            <p class="text-[10px] tracking-[0.25em] text-[#d4af37] uppercase font-bold">Gran Maestro</p>
                        </div>
                    </div>
                </div>
            </div>
        </Container>
    </section>

    <!-- FEATURED COMPOSITIONS SECTION -->
    {topCompositions.length > 0 && (
        <section class="py-32 relative bg-[#1c1917] border-t border-[#292524]">
            <Container maxWidth="xl">
                <div class="flex flex-col md:flex-row justify-between items-end mb-20 gap-8">
                    <div class="max-w-2xl">
                        <div class="flex items-center gap-4 mb-6">
                            <span class="w-12 h-px bg-[#d4af37]"></span>
                            <span class="text-[10px] tracking-[0.3em] uppercase text-[#d4af37] font-bold">Selección del Maestro</span>
                        </div>
                        <h2 class="font-serif text-5xl md:text-6xl text-[#f5f5f4] mb-6">Reliquias del Meta</h2>
                        <p class="text-[#a8a29e] font-light text-xl leading-relaxed">Las configuraciones más destructivas del parche actual. Dominio absoluto garantizado.</p>
                    </div>
                    <a href="/compositions" class="text-xs tracking-[0.2em] font-bold uppercase text-[#d4af37] border-b border-[#d4af37]/30 pb-2 hover:border-[#d4af37] hover:text-[#f5f5f4] transition-all flex items-center gap-3 group">
                        Explorar el Tomo Completo
                        <i class="fa-solid fa-arrow-right-long group-hover:translate-x-3 transition-transform duration-300"></i>
                    </a>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
                    {topCompositions.map((comp, index) => (
                        <a href={`/compositions/${encodeURIComponent(comp.slug)}`} class="group relative block bg-[#0c0a09] border border-[#292524] hover:border-[#d4af37] transition-all duration-500 hover:-translate-y-2 hover:shadow-[0_20px_40px_rgba(0,0,0,0.5)]">
                            <!-- Number Indicator -->
                            <div class="absolute -top-6 -right-4 z-20 font-serif text-[8rem] leading-none text-[#f5f5f4]/5 font-bold italic group-hover:text-[#d4af37]/10 transition-colors pointer-events-none">
                                0{index + 1}
                            </div>
                            
                            <!-- Image -->
                            <div class="relative h-72 overflow-hidden border-b border-[#292524] group-hover:border-[#d4af37] transition-colors">
                                {comp.cover ? (
                                    <img
                                        src={comp.cover}
                                        alt={comp.title}
                                        class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-110 filter grayscale group-hover:grayscale-0"
                                    />
                                ) : (
                                    <div class="w-full h-full bg-[#1c1917] flex items-center justify-center">
                                        <i class="fa-solid fa-chess-knight text-6xl text-[#292524]"></i>
                                    </div>
                                )}
                                <div class="absolute inset-0 bg-gradient-to-t from-[#0c0a09] via-[#0c0a09]/50 to-transparent opacity-90"></div>
                                
                                <div class="absolute top-6 left-6">
                                    <span class={`text-[10px] tracking-[0.25em] font-bold uppercase px-4 py-2 bg-black/50 backdrop-blur-md border ${
                                        comp.tier === 'S Tier' ? 'border-[#d4af37] text-[#d4af37]' : 
                                        comp.tier === 'A Tier' ? 'border-[#9ca3af] text-[#9ca3af]' : 
                                        'border-[#b45309] text-[#b45309]'
                                    }`}>
                                        Clase: {comp.tier}
                                    </span>
                                </div>
                            </div>

                            <!-- Content -->
                            <div class="relative p-8 z-10">
                                <h3 class="font-serif text-3xl text-[#f5f5f4] group-hover:text-[#d4af37] transition-colors mb-4 line-clamp-2 leading-tight">
                                    {comp.title}
                                </h3>
                                
                                <p class="text-[#a8a29e] font-light leading-relaxed line-clamp-3 mb-8">
                                    {comp.description}
                                </p>

                                <div class="flex items-center gap-4 text-[#d4af37]">
                                    <span class="w-8 h-px bg-[#d4af37] group-hover:w-16 transition-all duration-300"></span>
                                    <span class="text-[9px] tracking-[0.3em] font-bold uppercase">Inspeccionar</span>
                                </div>
                            </div>
                        </a>
                    ))}
                </div>
            </Container>
        </section>
    )}

    <!-- PHILOSOPHY SECTION -->
    <section class="py-40 relative bg-[#0c0a09] overflow-hidden">
        <div class="absolute left-0 top-1/2 -translate-y-1/2 w-1/3 h-[80%] bg-[#d4af37]/5 blur-[150px] rounded-full pointer-events-none"></div>

        <Container maxWidth="xl">
            <div class="grid md:grid-cols-2 gap-20 items-center">
                <div class="relative">
                    <div class="absolute inset-0 border border-[#d4af37]/20 translate-x-8 translate-y-8 pointer-events-none"></div>
                    <div class="relative p-12 bg-[#1c1917] border border-[#292524] z-10 shadow-2xl">
                        <i class="fa-solid fa-quote-left text-6xl text-[#d4af37]/20 mb-8 absolute top-8 left-8"></i>
                        <p class="font-serif text-3xl md:text-4xl text-[#f5f5f4] leading-snug mb-10 relative z-10 pt-10">
                            "La victoria no se encuentra en la suerte de la tienda, sino en la elegancia de la ejecución."
                        </p>
                        <div class="flex items-center gap-6 pt-8 border-t border-[#292524]">
                            <div class="w-16 h-16 rounded-none overflow-hidden grayscale border border-[#d4af37]">
                                <Image src={akaWonderImage} alt="AKAWonder" width={64} height={64} class="object-cover h-full" />
                            </div>
                            <div>
                                <p class="font-serif text-2xl text-[#d4af37] mb-1">AKAWonder</p>
                                <p class="text-[9px] tracking-[0.2em] text-[#a8a29e] uppercase">Estratega Jefe</p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="space-y-12">
                    <div class="flex items-center gap-4">
                        <span class="w-12 h-px bg-[#d4af37]"></span>
                        <h2 class="text-[10px] tracking-[0.3em] uppercase text-[#d4af37] font-bold">La Doctrina</h2>
                    </div>
                    
                    <h3 class="font-serif text-5xl md:text-6xl text-[#f5f5f4] leading-none">
                        TRES PILARES<br/>DEL DOMINIO
                    </h3>
                    
                    <div class="space-y-10">
                        <div class="flex gap-6 group">
                            <div class="text-[#292524] font-serif text-5xl group-hover:text-[#d4af37] transition-colors duration-500">I</div>
                            <div>
                                <h4 class="font-serif text-2xl text-[#f5f5f4] mb-3">Curación Experta</h4>
                                <p class="text-[#a8a29e] font-light leading-relaxed">Solo las composiciones probadas en el fragor de la batalla de alto ELO merecen ser registradas en este tomo.</p>
                            </div>
                        </div>
                        <div class="flex gap-6 group">
                            <div class="text-[#292524] font-serif text-5xl group-hover:text-[#d4af37] transition-colors duration-500">II</div>
                            <div>
                                <h4 class="font-serif text-2xl text-[#f5f5f4] mb-3">Sincronía Eterna</h4>
                                <p class="text-[#a8a29e] font-light leading-relaxed">A medida que las runas cambian y el meta evoluciona, el códice se actualiza. Nunca quedarás obsoleto.</p>
                            </div>
                        </div>
                        <div class="flex gap-6 group">
                            <div class="text-[#292524] font-serif text-5xl group-hover:text-[#d4af37] transition-colors duration-500">III</div>
                            <div>
                                <h4 class="font-serif text-2xl text-[#f5f5f4] mb-3">Visión Táctica</h4>
                                <p class="text-[#a8a29e] font-light leading-relaxed">No solo te decimos qué comprar, te enseñamos cómo pensar. Posicionamiento, economía y flexibilidad total.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </Container>
    </section>

    <!-- TWITCH BANNER -->
    <section class="py-40 relative bg-[#1c1917] overflow-hidden border-t border-[#292524]">
        <div class="absolute inset-0 bg-gradient-to-br from-[#9146FF]/10 via-transparent to-transparent opacity-80"></div>
        <div class="absolute right-0 bottom-0 w-1/2 h-full bg-[#9146FF]/5 blur-[200px] pointer-events-none"></div>

        <Container maxWidth="lg" className="relative z-10 text-center">
            <div class="inline-flex items-center justify-center w-24 h-24 rounded-full border border-[#9146FF]/30 bg-[#9146FF]/10 mb-10 text-[#9146FF]">
                <i class="fa-brands fa-twitch text-4xl"></i>
            </div>
            
            <h2 class="font-serif text-5xl md:text-7xl text-[#f5f5f4] mb-8">Testigo de la Magia</h2>
            
            <p class="text-xl text-[#a8a29e] mb-12 max-w-2xl mx-auto font-light leading-relaxed">
                Únete a la academia en vivo. Observa la toma de decisiones en tiempo real, interactúa y eleva tu nivel de juego observando a AKAWonder en directo.
            </p>
            
            <a href="https://www.twitch.tv/akawonder" target="_blank" class="inline-flex items-center gap-4 px-10 py-5 bg-transparent border border-[#9146FF] text-[#f5f5f4] text-xs tracking-[0.25em] font-bold uppercase hover:bg-[#9146FF] transition-all duration-300 shadow-[0_0_40px_rgba(145,70,255,0.1)] hover:shadow-[0_0_60px_rgba(145,70,255,0.4)] hover:-translate-y-1 group">
                Conectar al Stream
                <i class="fa-solid fa-arrow-right-long group-hover:translate-x-2 transition-transform"></i>
            </a>
        </Container>
    </section>
</Layout>
