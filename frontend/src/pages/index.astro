---
import Layout from "../layouts/Layout.astro";
import Container from "../components/ui/Container.astro";
import Card from "../components/ui/Card.astro";
import Badge from "../components/ui/Badge.astro";
import { Image } from "astro:assets";
import akaWonderImage from "../assets/akawonder.png";
import { getCompositionsByTier, getCompositionsCount } from "../lib/strapi";

export const prerender = true;

const { data: featuredCompositions } = await getCompositionsByTier("S Tier");
const topCompositions = featuredCompositions?.slice(0, 3) || [];
const { data: totalCompositions } = await getCompositionsCount();

const lastUpdate = featuredCompositions?.[0]?.updatedAt 
    ? new Date(featuredCompositions[0].updatedAt).toLocaleDateString('es-ES', { day: 'numeric', month: 'long' })
    : null;
---

<Layout
    title="AKACompos - Las mejores composiciones de TFT"
    description="Descubre las mejores composiciones de Teamfight Tactics (TFT) actualizadas para el meta actual. Estrategias probadas por AKAWonder."
>
    <!-- Hero Section -->
    <section class="relative py-16 md:py-24 lg:py-32 overflow-hidden">
        <!-- Subtle background -->
        <div class="absolute inset-0 bg-gradient-to-b from-slate-900 to-slate-950"></div>
        
        <Container maxWidth="xl" className="relative">
            <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
                <!-- Content -->
                <div class="text-center lg:text-left space-y-6">
                    <!-- Badge -->
                    <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-primary/10 border border-primary/20 text-primary text-xs font-medium">
                        <span class="w-1.5 h-1.5 rounded-full bg-primary animate-pulse"></span>
                        {lastUpdate ? `Actualizado el ${lastUpdate}` : 'Meta actual'}
                    </div>

                    <!-- Title -->
                    <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white leading-tight">
                        Las mejores composiciones de
                        <span class="text-gradient"> TFT</span>
                    </h1>

                    <!-- Subtitle -->
                    <p class="text-lg md:text-xl text-slate-400 leading-relaxed max-w-xl">
                        Bienvenido a <span class="text-white font-medium">AKACompos</span>, 
                        tu fuente de referencia para las composiciones más potentes de 
                        Teamfight Tactics, directamente de <span class="text-white font-medium">AKAWonder</span>.
                    </p>

                    <!-- CTA Buttons -->
                    <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start pt-2">
                        <a
                            href="/compositions"
                            class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-lg bg-primary text-white font-medium hover:bg-primary-dark transition-colors"
                        >
                            Ver Composiciones
                            <i class="fa-solid fa-arrow-right text-sm"></i>
                        </a>
                        <a
                            href="https://www.twitch.tv/akawonder"
                            target="_blank"
                            class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-lg bg-white/5 text-white font-medium border border-white/10 hover:bg-white/10 transition-colors"
                        >
                            <i class="fa-brands fa-twitch text-purple-400"></i>
                            Canal de Twitch
                        </a>
                    </div>
                </div>

                <!-- Image -->
                <div class="relative flex justify-center">
                    <div class="relative">
                        <!-- Subtle glow -->
                        <div class="absolute inset-0 bg-primary/20 blur-3xl rounded-full scale-75"></div>
                        
                        <Image
                            src={akaWonderImage}
                            alt="AKAWonder"
                            class="relative w-64 h-64 md:w-80 md:h-80 lg:w-96 lg:h-96 object-cover rounded-2xl shadow-2xl object-top"
                            width={400}
                            height={400}
                            quality={95}
                            loading="eager"
                        />
                    </div>
                </div>
            </div>
        </Container>
    </section>

    <!-- Stats Section -->
    <section class="py-12 border-y border-white/5 bg-slate-900/50">
        <Container maxWidth="xl">
            <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
                <div>
                    <div class="text-3xl md:text-4xl font-bold text-white">{totalCompositions}+</div>
                    <div class="text-sm text-slate-500 mt-1">Composiciones</div>
                </div>
                <div>
                    <div class="text-3xl md:text-4xl font-bold text-white">S Tier</div>
                    <div class="text-sm text-slate-500 mt-1">Estrategias Top</div>
                </div>
                <div>
                    <div class="text-3xl md:text-4xl font-bold text-white">Pro</div>
                    <div class="text-sm text-slate-500 mt-1">Consejos</div>
                </div>
                <div>
                    <div class="text-3xl md:text-4xl font-bold text-white">24/7</div>
                    <div class="text-sm text-slate-500 mt-1">Actualizado</div>
                </div>
            </div>
        </Container>
    </section>

    <!-- Featured Compositions -->
    {topCompositions.length > 0 && (
        <section class="py-16 md:py-24">
            <Container maxWidth="xl">
                <div class="text-center mb-12">
                    <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">
                        Composiciones Destacadas
                    </h2>
                    <p class="text-slate-400 max-w-2xl mx-auto">
                        Las estrategias más dominantes del meta actual, seleccionadas por AKAWonder.
                    </p>
                </div>

                <div class="grid md:grid-cols-3 gap-6">
                    {topCompositions.map((comp) => (
                        <a
                            href={`/compositions/${comp.slug}`}
                            class="group block"
                        >
                            <Card
                                variant="default"
                                padding="none"
                                className="overflow-hidden hover-lift"
                            >
                                <div class="aspect-video relative overflow-hidden">
                                    {comp.cover ? (
                                        <img
                                            src={comp.cover}
                                            alt={comp.title}
                                            class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
                                        />
                                    ) : (
                                        <div class="w-full h-full bg-slate-800 flex items-center justify-center">
                                            <i class="fa-solid fa-image text-3xl text-slate-700"></i>
                                        </div>
                                    )}
                                    <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-transparent to-transparent"></div>
                                    <div class="absolute top-3 left-3">
                                        <Badge variant="primary" size="sm">
                                            {comp.tier}
                                        </Badge>
                                    </div>
                                </div>
                                <div class="p-5">
                                    <h3 class="text-lg font-semibold text-white group-hover:text-primary transition-colors mb-2">
                                        {comp.title}
                                    </h3>
                                    <p class="text-sm text-slate-400 line-clamp-2">
                                        {comp.description}
                                    </p>
                                    <div class="mt-4 flex items-center text-sm text-primary font-medium">
                                        Ver detalles
                                        <i class="fa-solid fa-arrow-right ml-2 transition-transform group-hover:translate-x-1"></i>
                                    </div>
                                </div>
                            </Card>
                        </a>
                    ))}
                </div>

                <div class="mt-12 text-center">
                    <a
                        href="/compositions"
                        class="inline-flex items-center gap-2 px-6 py-3 rounded-lg border border-white/10 text-white font-medium hover:bg-white/5 transition-colors"
                    >
                        Ver todas las composiciones
                        <i class="fa-solid fa-table-cells-large"></i>
                    </a>
                </div>
            </Container>
        </section>
    )}

    <!-- Features Section -->
    <section class="py-16 md:py-24 bg-slate-900/30">
        <Container maxWidth="xl">
            <div class="text-center mb-12">
                <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">
                    ¿Por qué AKACompos?
                </h2>
                <p class="text-slate-400 max-w-2xl mx-auto">
                    La herramienta definitiva para subir de elo en Teamfight Tactics.
                </p>
            </div>

            <div class="grid md:grid-cols-3 gap-6">
                <!-- Feature 1 -->
                <Card variant="glass" padding="xl" className="text-center">
                    <div class="w-14 h-14 rounded-xl bg-primary/10 flex items-center justify-center mx-auto mb-5">
                        <i class="fa-solid fa-chess text-2xl text-primary"></i>
                    </div>
                    <h3 class="text-lg font-semibold text-white mb-2">
                        Composiciones Expertas
                    </h3>
                    <p class="text-sm text-slate-400 leading-relaxed">
                        Estrategias probadas y optimizadas por AKAWonder para dominar el meta actual.
                    </p>
                </Card>

                <!-- Feature 2 -->
                <Card variant="glass" padding="xl" className="text-center">
                    <div class="w-14 h-14 rounded-xl bg-primary/10 flex items-center justify-center mx-auto mb-5">
                        <i class="fa-solid fa-clock-rotate-left text-2xl text-primary"></i>
                    </div>
                    <h3 class="text-lg font-semibold text-white mb-2">
                        Siempre Actualizado
                    </h3>
                    <p class="text-sm text-slate-400 leading-relaxed">
                        Contenido actualizado constantemente para reflejar los últimos parches.
                    </p>
                </Card>

                <!-- Feature 3 -->
                <Card variant="glass" padding="xl" className="text-center">
                    <div class="w-14 h-14 rounded-xl bg-primary/10 flex items-center justify-center mx-auto mb-5">
                        <i class="fa-solid fa-trophy text-2xl text-primary"></i>
                    </div>
                    <h3 class="text-lg font-semibold text-white mb-2">
                        Nivel Competitivo
                    </h3>
                    <p class="text-sm text-slate-400 leading-relaxed">
                        Aprende de un jugador profesional y mejora tu toma de decisiones.
                    </p>
                </Card>
            </div>
        </Container>
    </section>

    <!-- CTA Section -->
    <section class="py-16 md:py-24">
        <Container maxWidth="xl">
            <div class="relative rounded-2xl bg-gradient-to-br from-slate-800 to-slate-900 p-8 md:p-12 lg:p-16 text-center border border-white/5">
                <div class="relative z-10 max-w-2xl mx-auto space-y-6">
                    <h2 class="text-3xl md:text-4xl font-bold text-white">
                        Únete a la comunidad
                    </h2>
                    <p class="text-lg text-slate-400">
                        No te pierdas ninguna actualización y aprende en directo con AKAWonder en su canal de Twitch.
                    </p>
                    <div class="flex flex-col sm:flex-row justify-center gap-4 pt-2">
                        <a
                            href="https://www.twitch.tv/akawonder"
                            target="_blank"
                            class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-lg bg-purple-600 text-white font-medium hover:bg-purple-700 transition-colors"
                        >
                            <i class="fa-brands fa-twitch"></i>
                            Ver en Twitch
                        </a>
                        <a
                            href="https://x.com/aka_wonder"
                            target="_blank"
                            class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-lg bg-white/5 text-white font-medium border border-white/10 hover:bg-white/10 transition-colors"
                        >
                            <i class="fa-brands fa-x-twitter"></i>
                            Seguir en X
                        </a>
                    </div>
                </div>
            </div>
        </Container>
    </section>
</Layout>
