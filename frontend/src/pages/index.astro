---
import Layout from "../layouts/Layout.astro";
import Container from "../components/ui/Container.astro";
import Section from "../components/ui/Section.astro";
import Card from "../components/ui/Card.astro";
import Badge from "../components/ui/Badge.astro";
import Button from "../components/ui/Button.astro";
import { Image } from "astro:assets";
import akaWonderImage from "../assets/akawonder.png";
import { getCompositionsByTier, getCompositionsCount } from "../lib/strapi";
import { championAssets } from "../utils/assets";

export const prerender = true;

// Obtener composiciones destacadas (S Tier)
const { data: featuredCompositions } = await getCompositionsByTier("S Tier");
const topCompositions = featuredCompositions?.slice(0, 3) || [];

// Obtener el número total de composiciones
const { data: totalCompositions } = await getCompositionsCount();

// Obtener la fecha de la última actualización
const lastUpdate = featuredCompositions?.[0]?.updatedAt 
    ? new Date(featuredCompositions[0].updatedAt).toLocaleDateString('es-ES', { day: 'numeric', month: 'long' })
    : null;
---

<Layout
    title="AKACompos - Las mejores composiciones de TFT"
    description="Descubre las mejores composiciones de Teamfight Tactics (TFT) actualizadas para el meta actual. Estrategias probadas por AKAWonder."
>
    <!-- Animated Background -->
    <div class="fixed inset-0 -z-10 overflow-hidden">
        <div class="absolute inset-0 bg-gradient-animated animate-gradient">
        </div>
        <div
            class="absolute top-0 left-1/4 w-96 h-96 bg-primary/10 rounded-full blur-3xl animate-float"
        >
        </div>
        <div
            class="absolute bottom-0 right-1/4 w-96 h-96 bg-purple-500/10 rounded-full blur-3xl animate-float"
            style="animation-delay: -1.5s;"
        >
        </div>
    </div>

    <!-- Hero Section -->
    <div class="relative overflow-hidden py-12 md:py-24 lg:py-32">
        <Container maxWidth="xl">
            <div class="grid md:grid-cols-2 gap-12 lg:gap-16 items-center">
                <!-- Content -->
                <div
                    class="text-center md:text-left space-y-8 animate-fade-in-up"
                >
                    <!-- Badge -->
                    <div
                        class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-primary/10 border border-primary/20 text-primary text-sm font-medium backdrop-blur-sm"
                    >
                        <span class="relative flex h-2 w-2">
                            <span
                                class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary opacity-75"
                            ></span>
                            <span
                                class="relative inline-flex rounded-full h-2 w-2 bg-primary"
                            ></span>
                        </span>
                        {lastUpdate ? `Actualizado el ${lastUpdate}` : 'Actualizado para el meta actual'}
                    </div>

                    <!-- Title -->
                    <h1
                        class="text-4xl md:text-6xl lg:text-7xl font-bold text-white leading-tight"
                    >
                        Las mejores composiciones de
                        <span class="text-gradient-prismatic text-shadow-glow">
                            TFT
                        </span>
                    </h1>

                    <!-- Subtitle -->
                    <p
                        class="text-xl md:text-2xl text-slate-300 leading-relaxed max-w-2xl"
                    >
                        Bienvenido a <span class="text-primary font-semibold"
                            >AKACompos</span
                        >, tu fuente de referencia para las composiciones más
                        potentes y actualizadas de Teamfight Tactics,
                        directamente desde la mente del maestro estratega, <span
                            class="text-primary font-semibold">AKAWonder</span
                        >.
                    </p>

                    <!-- CTA Buttons -->
                    <div
                        class="flex flex-col sm:flex-row gap-4 justify-center md:justify-start"
                    >
                        <a
                            class="group relative inline-flex items-center justify-center px-8 py-4 rounded-xl bg-gradient-primary text-white text-lg font-bold shadow-elevation-3 hover:shadow-elevation-4 hover:shadow-glow-md transition-all duration-300 overflow-hidden"
                            href="/compositions"
                        >
                            <span class="relative z-10 flex items-center gap-2">
                                Ver Composiciones
                                <span
                                    class="material-symbols-outlined transition-transform group-hover:translate-x-1"
                                >
                                    arrow_forward
                                </span>
                            </span>
                            <div
                                class="absolute inset-0 bg-gradient-to-r from-primary to-purple-500 opacity-0 group-hover:opacity-100 transition-opacity"
                            >
                            </div>
                        </a>

                        <a
                            class="group inline-flex items-center justify-center px-8 py-4 rounded-xl glass-card glass-card-hover text-slate-200 text-lg font-bold transition-all duration-300"
                            href="https://www.twitch.tv/akawonder"
                            target="_blank"
                        >
                            <i
                                class="fa-brands fa-twitch mr-2 text-purple-400 transition-transform group-hover:scale-110"
                            ></i>
                            Canal de Twitch
                        </a>
                    </div>
                </div>

                <!-- Profile Image -->
                <div
                    class="relative flex justify-center items-center animate-fade-in"
                    style="animation-delay: 0.2s;"
                >
                    <!-- Glow Effects -->
                    <div
                        class="absolute inset-0 bg-gradient-to-r from-primary/30 via-purple-500/30 to-primary/30 blur-3xl rounded-full animate-glow-pulse"
                    >
                    </div>
                    <div
                        class="absolute inset-0 bg-primary/10 blur-2xl rounded-full animate-pulse"
                    >
                    </div>

                    <!-- Image Container -->
                    <div class="relative group">
                        <div
                            class="absolute -inset-1 bg-gradient-to-r from-primary via-purple-500 to-primary rounded-full blur opacity-75 group-hover:opacity-100 transition duration-1000 group-hover:duration-200 animate-gradient"
                        >
                        </div>
                        <Image
                            src={akaWonderImage}
                            alt="AKAWonder"
                            class="relative w-64 h-64 md:w-96 md:h-96 lg:w-[28rem] lg:h-[28rem] object-cover rounded-full border-4 border-background-dark shadow-elevation-4 object-top transition-transform duration-300 group-hover:scale-105"
                            width={448}
                            height={448}
                            quality={95}
                            loading="eager"
                            decoding="async"
                        />
                    </div>
                </div>
            </div>
        </Container>
    </div>

    <!-- Featured Compositions Section -->
    {topCompositions.length > 0 && (
        <Section 
            title="Composiciones Destacadas" 
            subtitle="Las estrategias más dominantes del meta actual, seleccionadas por AKAWonder."
            variant="gradient"
            spacing="xl"
        >
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                {topCompositions.map((comp, index) => (
                    <Card
                        as="a"
                        href={`/compositions/${comp.slug}`}
                        variant="gradient"
                        hover={true}
                        rounded="2xl"
                        shadow="xl"
                        padding="none"
                        tier="prismatic"
                        className="group animate-fade-in-up"
                        style={`animation-delay: ${index * 0.1}s;`}
                    >
                        <div class="relative aspect-[16/9] overflow-hidden rounded-t-2xl">
                            {comp.cover ? (
                                <img
                                    src={comp.cover}
                                    alt={comp.title}
                                    class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110"
                                />
                            ) : (
                                <div class="h-full w-full bg-slate-800 flex items-center justify-center">
                                    <i class="fa-solid fa-image text-4xl text-slate-700"></i>
                                </div>
                            )}
                            <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-transparent to-transparent opacity-60"></div>
                            <div class="absolute top-4 left-4">
                                <Badge variant="primary" icon="star" size="sm">
                                    {comp.tier}
                                </Badge>
                            </div>
                        </div>
                        <div class="p-6 space-y-3">
                            <h3 class="text-xl font-bold text-white group-hover:text-primary transition-colors line-clamp-1">
                                {comp.title}
                            </h3>
                            <p class="text-slate-400 text-sm line-clamp-2">
                                {comp.description}
                            </p>
                            <div class="pt-4 flex items-center justify-between">
                                <span class="text-xs text-slate-500 font-medium uppercase tracking-wider">
                                    Ver detalles
                                </span>
                                <i class="fa-solid fa-arrow-right text-primary transition-transform group-hover:translate-x-1"></i>
                            </div>
                        </div>
                    </Card>
                ))}
            </div>
            <div class="mt-12 text-center">
                <Button 
                    as="a" 
                    href="/compositions" 
                    variant="outline" 
                    size="lg"
                    icon="table-cells-large"
                >
                    Ver todas las composiciones
                </Button>
            </div>
        </Section>
    )}

    <!-- Stats Section -->
    <div class="relative py-12 border-y border-white/5 bg-white/[0.02] backdrop-blur-sm">
        <Container maxWidth="xl">
            <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
                <div class="space-y-1">
                    <div class="text-3xl md:text-4xl font-bold text-white text-gradient-primary">{totalCompositions}+</div>
                    <div class="text-sm text-slate-400 font-medium uppercase tracking-widest">Composiciones</div>
                </div>
                <div class="space-y-1">
                    <div class="text-3xl md:text-4xl font-bold text-white text-gradient-primary">Bisemanales</div>
                    <div class="text-sm text-slate-400 font-medium uppercase tracking-widest">Actualizaciones</div>
                </div>
                <div class="space-y-1">
                    <div class="text-3xl md:text-4xl font-bold text-white text-gradient-primary">Top 1</div>
                    <div class="text-sm text-slate-400 font-medium uppercase tracking-widest">Estrategias</div>
                </div>
                <div class="space-y-1">
                    <div class="text-3xl md:text-4xl font-bold text-white text-gradient-primary">Pro</div>
                    <div class="text-sm text-slate-400 font-medium uppercase tracking-widest">Consejos</div>
                </div>
            </div>
        </Container>
    </div>

    <!-- Features Section -->
    <Section 
        title="¿Por qué AKACompos?" 
        subtitle="La herramienta definitiva para subir de elo en Teamfight Tactics."
        spacing="xl"
    >
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <!-- Feature Card 1 -->
            <Card
                variant="glass"
                padding="xl"
                className="text-center space-y-6 animate-fade-in-up"
                style="animation-delay: 0.1s;"
            >
                <div
                    class="inline-flex items-center justify-center w-20 h-20 rounded-3xl bg-gradient-primary shadow-glow-md mx-auto"
                >
                    <i class="fa-solid fa-chess text-4xl text-white"></i>
                </div>
                <div class="space-y-3">
                    <h3 class="text-2xl font-bold text-white">
                        Composiciones Expertas
                    </h3>
                    <p class="text-slate-400 leading-relaxed">
                        Estrategias probadas y optimizadas por AKAWonder para
                        dominar el meta actual en los niveles más altos.
                    </p>
                </div>
            </Card>

            <!-- Feature Card 2 -->
            <Card
                variant="glass"
                padding="xl"
                className="text-center space-y-6 animate-fade-in-up"
                style="animation-delay: 0.2s;"
            >
                <div
                    class="inline-flex items-center justify-center w-20 h-20 rounded-3xl bg-gradient-primary shadow-glow-md mx-auto"
                >
                    <i
                        class="fa-solid fa-clock-rotate-left text-4xl text-white"
                    ></i>
                </div>
                <div class="space-y-3">
                    <h3 class="text-2xl font-bold text-white">
                        Siempre Actualizado
                    </h3>
                    <p class="text-slate-400 leading-relaxed">
                        Contenido actualizado constantemente para reflejar los
                        últimos parches y cambios de balance del juego.
                    </p>
                </div>
            </Card>

            <!-- Feature Card 3 -->
            <Card
                variant="glass"
                padding="xl"
                className="text-center space-y-6 animate-fade-in-up"
                style="animation-delay: 0.3s;"
            >
                <div
                    class="inline-flex items-center justify-center w-20 h-20 rounded-3xl bg-gradient-primary shadow-glow-md mx-auto"
                >
                    <i class="fa-solid fa-trophy text-4xl text-white"></i>
                </div>
                <div class="space-y-3">
                    <h3 class="text-2xl font-bold text-white">
                        Nivel Competitivo
                    </h3>
                    <p class="text-slate-400 leading-relaxed">
                        Aprende de un jugador profesional y mejora tu toma de
                        decisiones en cada fase de la partida.
                    </p>
                </div>
            </Card>
        </div>
    </Section>

    <!-- Community CTA -->
    <Section spacing="xl" className="overflow-hidden">
        <Card 
            variant="gradient" 
            padding="2xl" 
            rounded="3xl" 
            className="relative overflow-hidden border-primary/20"
        >
            <div class="absolute top-0 right-0 -mt-20 -mr-20 w-64 h-64 bg-primary/20 rounded-full blur-3xl"></div>
            <div class="absolute bottom-0 left-0 -mb-20 -ml-20 w-64 h-64 bg-purple-500/20 rounded-full blur-3xl"></div>
            
            <div class="relative z-10 text-center space-y-8">
                <h2 class="text-3xl md:text-5xl font-bold text-white">
                    Únete a la comunidad
                </h2>
                <p class="text-xl text-slate-300 max-w-2xl mx-auto">
                    No te pierdas ninguna actualización y aprende en directo con AKAWonder en su canal de Twitch.
                </p>
                <div class="flex flex-wrap justify-center gap-4">
                    <Button 
                        as="a" 
                        href="https://www.twitch.tv/akawonder" 
                        target="_blank"
                        variant="primary" 
                        size="xl"
                        icon="fa-brands fa-twitch"
                    >
                        Ver en Twitch
                    </Button>
                    <Button 
                        as="a" 
                        href="https://x.com/aka_wonder" 
                        target="_blank"
                        variant="outline" 
                        size="xl"
                        icon="fa-brands fa-x-twitter"
                    >
                        Seguir en X
                    </Button>
                </div>
            </div>
        </Card>
    </Section>
</Layout>

<style>
    /* Ensure animations respect user preferences */
    @media (prefers-reduced-motion: reduce) {
        .animate-float,
        .animate-glow-pulse,
        .animate-gradient,
        .animate-ping {
            animation: none;
        }
    }
</style>

<style>
    /* Ensure animations respect user preferences */
    @media (prefers-reduced-motion: reduce) {
        .animate-float,
        .animate-glow-pulse,
        .animate-gradient,
        .animate-ping {
            animation: none;
        }
    }
</style>
