---
import Layout from "../layouts/Layout.astro";
import Container from "../components/ui/Container.astro";
import { Image } from "astro:assets";
import akaWonderImage from "../assets/akawonder.png";
import { getCompositionsByTier, getCompositionsCount } from "../lib/strapi";
import { tierStyles, type TierLevel } from "../utils/tierStyles.ts";

export const prerender = true;

const { data: featuredCompositions } = await getCompositionsByTier("S Tier");
const topCompositions = featuredCompositions?.slice(0, 3) || [];
const { data: totalCompositions } = await getCompositionsCount();

const lastUpdate = featuredCompositions?.[0]?.updatedAt
    ? new Date(featuredCompositions[0].updatedAt).toLocaleDateString('es-ES', { day: 'numeric', month: 'long' })
    : null;
---

<Layout
    title="AKACompos - Las mejores composiciones de TFT"
    description="Descubre las mejores composiciones de Teamfight Tactics (TFT) actualizadas para el meta actual. Estrategias probadas por AKAWonder."
>
    <!-- ═══════════════════════════════════════════
         HERO — Asymmetric editorial layout
         ═══════════════════════════════════════════ -->
    <section class="relative min-h-[90vh] flex items-center overflow-hidden">
        <!-- Background layers -->
        <div class="absolute inset-0 bg-[rgb(10,10,12)]"></div>
        <!-- Radial glow behind image area -->
        <div class="absolute top-1/2 right-0 w-[600px] h-[600px] -translate-y-1/2 bg-amber-500/[0.04] rounded-full blur-[120px]"></div>
        <!-- Diagonal line accent -->
        <div class="absolute top-0 right-[40%] w-px h-full bg-gradient-to-b from-transparent via-amber-500/10 to-transparent hidden lg:block"></div>
        <!-- Grid pattern overlay -->
        <div class="absolute inset-0 opacity-[0.015]" style="background-image: linear-gradient(rgba(255,255,255,.1) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.1) 1px, transparent 1px); background-size: 60px 60px;"></div>

        <Container maxWidth="xl" className="relative z-10">
            <div class="grid lg:grid-cols-12 gap-8 lg:gap-6 items-center py-20 md:py-28">
                <!-- Content — takes 7 columns on desktop -->
                <div class="lg:col-span-7 space-y-8">
                    <!-- Eyebrow -->
                    <div class="animate-fade-in-up flex items-center gap-3">
                        {lastUpdate && (
                            <span class="inline-flex items-center gap-2 text-xs font-medium tracking-widest uppercase text-amber-400/80">
                                <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse"></span>
                                Actualizado {lastUpdate}
                            </span>
                        )}
                    </div>

                    <!-- Headline — oversized, editorial -->
                    <div class="animate-fade-in-up stagger-1">
                        <h1 class="font-display text-[clamp(2.5rem,6vw,5rem)] leading-[0.95] tracking-tight text-[rgb(245,245,245)]">
                            Domina el meta
                            <br />
                            <span class="text-gradient-warm">de TFT</span>
                        </h1>
                    </div>

                    <!-- Subhead — clean, restrained -->
                    <div class="animate-fade-in-up stagger-2">
                        <p class="text-base md:text-lg leading-relaxed text-[rgb(113,113,122)] max-w-lg">
                            Composiciones probadas por <span class="text-[rgb(245,245,245)] font-medium">AKAWonder</span>,
                            actualizadas cada parche. Sin teorías, solo lo que funciona para subir de elo.
                        </p>
                    </div>

                    <!-- CTAs -->
                    <div class="animate-fade-in-up stagger-3 flex flex-col sm:flex-row gap-3 pt-2">
                        <a
                            href="/compositions"
                            class="group inline-flex items-center justify-center gap-2.5 px-6 py-3 rounded-md bg-amber-500 text-[rgb(10,10,12)] text-sm font-semibold hover:bg-amber-400 transition-all hover:shadow-[0_0_24px_-4px_rgba(234,179,8,0.4)]"
                        >
                            Ver composiciones
                            <i class="fa-solid fa-arrow-right text-xs transition-transform group-hover:translate-x-0.5"></i>
                        </a>
                        <a
                            href="https://www.twitch.tv/akawonder"
                            target="_blank"
                            class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-md text-sm font-medium text-[rgb(163,163,170)] border border-white/[0.08] hover:border-white/20 hover:text-[rgb(245,245,245)] transition-all"
                        >
                            <i class="fa-brands fa-twitch text-purple-400 text-xs"></i>
                            Ver en Twitch
                        </a>
                    </div>

                    <!-- Inline stats — editorial row -->
                    <div class="animate-fade-in-up stagger-4 flex items-center gap-8 pt-6 border-t border-white/[0.04]">
                        <div>
                            <span class="font-display text-2xl text-[rgb(245,245,245)]">{totalCompositions}+</span>
                            <span class="block text-[11px] uppercase tracking-widest text-[rgb(82,82,91)] mt-0.5">Composiciones</span>
                        </div>
                        <div class="w-px h-8 bg-white/[0.06]"></div>
                        <div>
                            <span class="font-display text-2xl text-amber-400">S Tier</span>
                            <span class="block text-[11px] uppercase tracking-widest text-[rgb(82,82,91)] mt-0.5">Estrategias top</span>
                        </div>
                        <div class="w-px h-8 bg-white/[0.06] hidden sm:block"></div>
                        <div class="hidden sm:block">
                            <span class="font-display text-2xl text-[rgb(245,245,245)]">Pro</span>
                            <span class="block text-[11px] uppercase tracking-widest text-[rgb(82,82,91)] mt-0.5">Nivel</span>
                        </div>
                    </div>
                </div>

                <!-- Image — takes 5 columns, overlapping composition -->
                <div class="lg:col-span-5 relative flex justify-center lg:justify-end">
                    <div class="relative animate-fade-in-up stagger-2">
                        <!-- Decorative frame -->
                        <div class="absolute -inset-3 rounded-2xl border border-amber-500/[0.08]"></div>
                        <div class="absolute -inset-6 rounded-3xl border border-white/[0.03] hidden md:block"></div>

                        <!-- Corner accents -->
                        <div class="absolute -top-3 -left-3 w-6 h-6 border-t-2 border-l-2 border-amber-500/30 rounded-tl-lg"></div>
                        <div class="absolute -bottom-3 -right-3 w-6 h-6 border-b-2 border-r-2 border-amber-500/30 rounded-br-lg"></div>

                        <Image
                            src={akaWonderImage}
                            alt="AKAWonder — Jugador profesional de TFT"
                            class="relative w-64 h-72 md:w-72 md:h-80 lg:w-80 lg:h-[380px] object-cover object-top rounded-xl"
                            width={400}
                            height={480}
                            quality={95}
                            loading="eager"
                        />

                        <!-- Name label overlapping image -->
                        <div class="absolute -bottom-4 left-4 right-4 bg-[rgb(18,18,22)] border border-white/[0.06] rounded-lg px-4 py-2.5 flex items-center justify-between">
                            <div>
                                <span class="text-sm font-semibold text-[rgb(245,245,245)]">AKAWonder</span>
                                <span class="block text-[11px] text-[rgb(82,82,91)]">Pro Player & Streamer</span>
                            </div>
                            <div class="flex gap-2">
                                <a href="https://www.twitch.tv/akawonder" target="_blank" class="w-7 h-7 rounded-md bg-purple-500/10 flex items-center justify-center text-purple-400 hover:bg-purple-500/20 transition-colors">
                                    <i class="fa-brands fa-twitch text-xs"></i>
                                </a>
                                <a href="https://x.com/aka_wonder" target="_blank" class="w-7 h-7 rounded-md bg-white/5 flex items-center justify-center text-[rgb(163,163,170)] hover:bg-white/10 transition-colors">
                                    <i class="fa-brands fa-x-twitter text-xs"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </Container>
    </section>

    <!-- ═══════════════════════════════════════════
         DIVIDER
         ═══════════════════════════════════════════ -->
    <div class="divider-glow"></div>

    <!-- ═══════════════════════════════════════════
         FEATURED COMPOSITIONS — Magazine-style cards
         ═══════════════════════════════════════════ -->
    {topCompositions.length > 0 && (
        <section class="relative py-20 md:py-28">
            <Container maxWidth="xl">
                <!-- Section header — left-aligned editorial -->
                <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-12">
                    <div>
                        <span class="text-[11px] font-medium uppercase tracking-[0.2em] text-amber-400/70 mb-3 block">Selección del meta</span>
                        <h2 class="font-display text-3xl md:text-4xl text-[rgb(245,245,245)] tracking-tight">
                            Composiciones destacadas
                        </h2>
                    </div>
                    <a
                        href="/compositions"
                        class="group inline-flex items-center gap-2 text-sm font-medium text-[rgb(113,113,122)] hover:text-amber-400 transition-colors"
                    >
                        Ver todas
                        <i class="fa-solid fa-arrow-right text-xs transition-transform group-hover:translate-x-0.5"></i>
                    </a>
                </div>

                <!-- Cards grid — first card larger -->
                <div class="grid md:grid-cols-12 gap-5">
                    {topCompositions.map((comp, i) => (
                        <a
                            href={`/compositions/${comp.slug}`}
                            class={`group block ${i === 0 ? 'md:col-span-6' : 'md:col-span-3'}`}
                        >
                            <div class="relative h-full rounded-xl overflow-hidden bg-[rgb(18,18,22)] border border-white/[0.04] hover:border-amber-500/20 transition-all duration-300 hover:shadow-[0_0_40px_-12px_rgba(234,179,8,0.1)]">
                                <!-- Cover image -->
                                <div class={`relative overflow-hidden ${i === 0 ? 'aspect-[16/10]' : 'aspect-video'}`}>
                                    {comp.cover ? (
                                        <img
                                            src={comp.cover}
                                            alt={comp.title}
                                            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
                                        />
                                    ) : (
                                        <div class="w-full h-full bg-[rgb(26,26,32)] flex items-center justify-center">
                                            <i class="fa-solid fa-chess text-2xl text-[rgb(42,42,52)]"></i>
                                        </div>
                                    )}
                                    <!-- Gradient overlay -->
                                    <div class="absolute inset-0 bg-gradient-to-t from-[rgb(18,18,22)] via-[rgb(18,18,22)]/30 to-transparent"></div>

                                    <!-- Tier badge -->
                                    <div class="absolute top-3 left-3">
                                        <span class={`px-2.5 py-1 rounded-md text-[11px] font-bold uppercase tracking-wider border ${tierStyles[comp.tier as TierLevel]?.bgSoft || 'bg-white/5'} ${tierStyles[comp.tier as TierLevel]?.text || 'text-[rgb(163,163,170)]'} border-white/10`}>
                                            {comp.tier}
                                        </span>
                                    </div>
                                </div>

                                <!-- Content -->
                                <div class="p-5">
                                    <h3 class={`font-display tracking-tight text-[rgb(245,245,245)] group-hover:text-amber-400 transition-colors mb-2 ${i === 0 ? 'text-xl' : 'text-base'}`}>
                                        {comp.title}
                                    </h3>
                                    <p class={`text-[rgb(82,82,91)] leading-relaxed ${i === 0 ? 'text-sm line-clamp-3' : 'text-xs line-clamp-2'}`}>
                                        {comp.description}
                                    </p>
                                    <div class="mt-4 flex items-center gap-1.5 text-xs font-medium text-amber-400/70 group-hover:text-amber-400 transition-colors">
                                        <span>Ver detalles</span>
                                        <i class="fa-solid fa-arrow-right text-[10px] transition-transform group-hover:translate-x-0.5"></i>
                                    </div>
                                </div>
                            </div>
                        </a>
                    ))}
                </div>
            </Container>
        </section>
    )}

    <!-- ═══════════════════════════════════════════
         FEATURES — Horizontal editorial blocks
         ═══════════════════════════════════════════ -->
    <section class="relative py-20 md:py-28 overflow-hidden">
        <!-- Subtle background shift -->
        <div class="absolute inset-0 bg-[rgb(14,14,16)]"></div>
        <!-- Accent line -->
        <div class="absolute top-0 inset-x-0 h-px bg-gradient-to-r from-transparent via-white/[0.04] to-transparent"></div>
        <div class="absolute bottom-0 inset-x-0 h-px bg-gradient-to-r from-transparent via-white/[0.04] to-transparent"></div>

        <Container maxWidth="xl" className="relative">
            <!-- Section header -->
            <div class="mb-16">
                <span class="text-[11px] font-medium uppercase tracking-[0.2em] text-amber-400/70 mb-3 block">Ventajas</span>
                <h2 class="font-display text-3xl md:text-4xl text-[rgb(245,245,245)] tracking-tight max-w-md">
                    Todo lo que necesitas para subir de elo
                </h2>
            </div>

            <!-- Feature blocks — asymmetric grid -->
            <div class="grid md:grid-cols-3 gap-px bg-white/[0.04] rounded-xl overflow-hidden">
                <!-- Feature 1 -->
                <div class="bg-[rgb(14,14,16)] p-8 md:p-10 group hover:bg-[rgb(18,18,22)] transition-colors">
                    <div class="w-10 h-10 rounded-lg bg-amber-500/10 flex items-center justify-center mb-6 group-hover:bg-amber-500/15 transition-colors">
                        <i class="fa-solid fa-chess text-amber-400 text-sm"></i>
                    </div>
                    <h3 class="font-display text-lg text-[rgb(245,245,245)] mb-3">
                        Nivel profesional
                    </h3>
                    <p class="text-sm text-[rgb(82,82,91)] leading-relaxed">
                        Composiciones creadas y probadas por AKAWonder en partidas de alto elo. No son teorías, son resultados.
                    </p>
                </div>

                <!-- Feature 2 -->
                <div class="bg-[rgb(14,14,16)] p-8 md:p-10 group hover:bg-[rgb(18,18,22)] transition-colors">
                    <div class="w-10 h-10 rounded-lg bg-amber-500/10 flex items-center justify-center mb-6 group-hover:bg-amber-500/15 transition-colors">
                        <i class="fa-solid fa-bolt text-amber-400 text-sm"></i>
                    </div>
                    <h3 class="font-display text-lg text-[rgb(245,245,245)] mb-3">
                        Siempre al día
                    </h3>
                    <p class="text-sm text-[rgb(82,82,91)] leading-relaxed">
                        Cada parche trae cambios. Las composiciones se actualizan para que siempre juegues lo más fuerte del momento.
                    </p>
                </div>

                <!-- Feature 3 -->
                <div class="bg-[rgb(14,14,16)] p-8 md:p-10 group hover:bg-[rgb(18,18,22)] transition-colors">
                    <div class="w-10 h-10 rounded-lg bg-amber-500/10 flex items-center justify-center mb-6 group-hover:bg-amber-500/15 transition-colors">
                        <i class="fa-solid fa-graduation-cap text-amber-400 text-sm"></i>
                    </div>
                    <h3 class="font-display text-lg text-[rgb(245,245,245)] mb-3">
                        Aprende jugando
                    </h3>
                    <p class="text-sm text-[rgb(82,82,91)] leading-relaxed">
                        Cada composición incluye posicionamiento, items y variantes. Entiende el porqué, no solo el qué.
                    </p>
                </div>
            </div>
        </Container>
    </section>

    <!-- ═══════════════════════════════════════════
         CTA — Minimal, high-contrast band
         ═══════════════════════════════════════════ -->
    <section class="relative py-20 md:py-28">
        <Container maxWidth="xl">
            <div class="relative overflow-hidden rounded-2xl bg-[rgb(18,18,22)] border border-white/[0.04]">
                <!-- Inner glow -->
                <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[400px] h-[200px] bg-amber-500/[0.06] blur-[100px] rounded-full"></div>

                <div class="relative px-8 py-16 md:px-16 md:py-20">
                    <div class="max-w-2xl mx-auto text-center space-y-6">
                        <span class="text-[11px] font-medium uppercase tracking-[0.2em] text-amber-400/70">Comunidad</span>
                        <h2 class="font-display text-3xl md:text-4xl text-[rgb(245,245,245)] tracking-tight">
                            Aprende en directo con AKAWonder
                        </h2>
                        <p class="text-[rgb(82,82,91)] text-base md:text-lg leading-relaxed max-w-lg mx-auto">
                            Cada stream es una clase magistral de TFT. No te pierdas las explicaciones en directo de cada jugada.
                        </p>
                        <div class="flex flex-col sm:flex-row justify-center gap-3 pt-4">
                            <a
                                href="https://www.twitch.tv/akawonder"
                                target="_blank"
                                class="group inline-flex items-center justify-center gap-2.5 px-6 py-3 rounded-md bg-purple-600 text-white text-sm font-semibold hover:bg-purple-500 transition-all hover:shadow-[0_0_24px_-4px_rgba(147,51,234,0.4)]"
                            >
                                <i class="fa-brands fa-twitch text-sm"></i>
                                Twitch
                            </a>
                            <a
                                href="https://x.com/aka_wonder"
                                target="_blank"
                                class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-md text-sm font-medium text-[rgb(163,163,170)] border border-white/[0.08] hover:border-white/20 hover:text-[rgb(245,245,245)] transition-all"
                            >
                                <i class="fa-brands fa-x-twitter text-xs"></i>
                                X / Twitter
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </Container>
    </section>
</Layout>
