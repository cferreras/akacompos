---
import Layout from "../../layouts/Layout.astro";
import Container from "../../components/ui/Container.astro";
import CompositionList from "../../components/compositions/CompositionList.astro";
import Spinner from "../../components/ui/Spinner.astro";
import { getComposition } from "../../lib/strapi";
import {
  getCompositionPath,
  normalizeCompositionSet,
} from "../../utils/compositionPaths";

export const prerender = false;

const { set, slug } = Astro.params;
const decodedSlug = slug ? decodeURIComponent(slug) : undefined;
const normalizedSet = normalizeCompositionSet(set);

if (!decodedSlug || !normalizedSet) {
  return Astro.redirect("/compositions");
}

const { data: composition } = await getComposition(decodedSlug);

if (!composition) {
  return Astro.redirect("/compositions");
}

const canonicalPath = getCompositionPath(composition);
const fallbackPath = `/compositions?comp=${encodeURIComponent(decodedSlug)}`;

if (canonicalPath !== Astro.url.pathname) {
  return Astro.redirect(
    canonicalPath.startsWith("/compositions/")
      ? fallbackPath
      : canonicalPath,
    301,
  );
}

const initialExpandedSlug = decodedSlug;
---

<Layout
    title="El Tomo de Composiciones - AKACompos"
    description="Lista completa de las mejores composiciones de Teamfight Tactics (TFT) para el parche actual. Encuentra tu estrategia ganadora."
>
    <div class="relative overflow-hidden border-b border-[#292524] bg-[#0c0a09] pt-32 pb-20">
        <div class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/stardust.png')] opacity-[0.05] pointer-events-none"></div>
        <div class="absolute left-1/2 top-0 -translate-x-1/2 w-[800px] h-[400px] bg-[#d4af37] opacity-[0.05] blur-[150px] rounded-[100%] pointer-events-none"></div>

        <Container maxWidth="xl">
            <div class="relative max-w-4xl space-y-8 text-center mx-auto">
                <div class="inline-flex items-center gap-3 border border-[#d4af37]/30 px-5 py-2 bg-[#1c1917]/80 backdrop-blur-md mx-auto">
                    <i class="fa-solid fa-layer-group text-[#d4af37] text-sm" />
                    <span class="text-[10px] tracking-[0.25em] text-[#d4af37] uppercase font-bold">Tier List del Meta Actual</span>
                </div>

                <h1 class="font-serif text-5xl md:text-7xl text-[#f5f5f4] leading-tight">
                    EL TOMO DE<br />
                    <span class="italic text-[#d4af37] font-light">ESTRATEGIAS</span>
                </h1>

                <p class="max-w-2xl mx-auto text-lg text-[#a8a29e] font-light leading-relaxed">
                    Las mejores composiciones curadas por AKAWonder.
                    Inspecciona cada formación para revelar el tablero final, sinergias ocultas, artefactos óptimos y el plan maestro.
                </p>

                <div class="w-24 h-px bg-[#d4af37]/50 mx-auto mt-4"></div>
            </div>
        </Container>
    </div>

    <div class="py-20 bg-[#1c1917] min-h-screen">
        <Container maxWidth="xl">
            <CompositionList initialExpandedSlug={initialExpandedSlug}>
                <div slot="fallback" class="flex flex-col justify-center items-center py-32 gap-6">
                    <Spinner size="lg" color="primary" />
                    <p class="text-[#a8a29e] font-serif text-xl italic animate-pulse">Traduciendo runas...</p>
                </div>
            </CompositionList>
        </Container>
    </div>
</Layout>