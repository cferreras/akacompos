---
import Layout from "../../layouts/Layout.astro";
import Card from "../../components/ui/Card.astro";
import Badge from "../../components/ui/Badge.astro";
import Section from "../../components/ui/Section.astro";
import Container from "../../components/ui/Container.astro";
import { championAssets } from "../../utils/assets";
import { getCompositions } from "../../lib/strapi";
import { Image } from "astro:assets";
import dayjs from "dayjs";
import utc from "dayjs/plugin/utc";
import relativeTime from "dayjs/plugin/relativeTime";
import es from "dayjs/locale/es";

dayjs.locale(es);
dayjs.extend(utc);
dayjs.extend(relativeTime);

// Obtener composiciones desde Strapi
const { data: compositions, error } = await getCompositions();

// Group compositions by tier
const compositionsByTier = compositions
    ? compositions.reduce(
          (acc, comp) => {
              const tier = comp.tier;
              if (!acc[tier]) {
                  acc[tier] = [];
              }
              acc[tier].push(comp);
              return acc;
          },
          {} as Record<string, typeof compositions>,
      )
    : {};

// Define tier order
const tierOrder = ["S Tier", "A Tier", "B Tier", "C Tier"];

// Mapear tier a variante de badge
function getTierBadgeVariant(tier: string) {
    switch (tier) {
        case "S Tier":
            return "primary";
        case "A Tier":
            return "success";
        case "B Tier":
            return "warning";
        case "C Tier":
            return "default";
        default:
            return "default";
    }
}

// Mapear tier de card
function getCardTier(tier: string): "gold" | "silver" | "bronze" | null {
    switch (tier) {
        case "S Tier":
            return "gold";
        case "A Tier":
            return "silver";
        case "B Tier":
            return "bronze";
        default:
            return null;
    }
}

// Function to get badge variant based on tag
function getTagVariant(
    tag: string,
): "fast" | "reroll" | "aggressive" | "defensive" | "primary" {
    const lowerTag = tag.toLowerCase();
    if (lowerTag.includes("fast")) return "fast";
    if (lowerTag.includes("reroll")) return "reroll";
    if (lowerTag.includes("aggressive") || lowerTag.includes("agresivo"))
        return "aggressive";
    if (lowerTag.includes("defensive") || lowerTag.includes("defensivo"))
        return "defensive";
    return "primary";
}

// Function to format tags
function formatTags(tags: any): string[] {
    if (typeof tags === "string") {
        return tags
            .split(",")
            .map((tag) => tag.trim())
            .slice(0, 3);
    } else if (Array.isArray(tags)) {
        return tags.slice(0, 3);
    }
    return [];
}

function getUpdateTime(composition: any) {
    return dayjs(composition.updatedAt || composition.createdAt)
        .utc()
        .fromNow();
}
---

<Layout title="TFT Compositions by AKAWonder">

        <Container maxWidth="xl">
            <!-- Hero Section -->
            <Section
                title="TFT Compositions"
                subtitle="Las mejores composiciones de AKAWonder actualizadas para el meta actual"
                variant="gradient"
                spacing="xl"
                divider={true}
                dividerPosition="bottom"
            >
                {
                    error && (
                        <Card
                            variant="outlined"
                            padding="lg"
                            className="border-red-500/50 bg-red-500/10"
                        >
                            <div class="text-red-400">
                                <h3 class="text-lg font-bold mb-2">
                                    <i class="fa-solid fa-exclamation-triangle mr-2" />
                                    Error al cargar las composiciones
                                </h3>
                                <p class="mb-3">
                                    No se pudieron cargar las composiciones
                                    desde Strapi. Por favor, verifica la
                                    configuración.
                                </p>
                                <div class="text-sm space-y-1">
                                    <p class="font-semibold">
                                        Asegúrate de que:
                                    </p>
                                    <ul class="ml-4 list-disc space-y-1 text-red-300">
                                        <li>
                                            El content type 'compositions'
                                            existe en Strapi
                                        </li>
                                        <li>
                                            Los permisos públicos están
                                            habilitados para ese content type
                                        </li>
                                        <li>
                                            O tienes un token válido configurado
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </Card>
                    )
                }
            </Section>

            <!-- Compositions by Tier -->
            {
                compositions &&
                    tierOrder.map((tier) => {
                        const tieredComps = compositionsByTier[tier] || [];
                        if (tieredComps.length === 0) return null;

                        return (
                            <Section
                                title={tier}
                                spacing="lg"
                                variant="default"
                                id={tier.toLowerCase().replace(" ", "-")}
                            >
                                <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:gap-8">
                                    {tieredComps.map((comp: any) => (
                                        <Card
                                            as="a"
                                            href={`/compositions/${comp.slug}`}
                                            variant="gradient"
                                            hover={true}
                                            rounded="xl"
                                            shadow="lg"
                                            padding="none"
                                            tier={getCardTier(tier)}
                                            className="group"
                                        >
                                            {/* Cover Image */}
                                            <div class="aspect-[16/9] w-full overflow-hidden rounded-t-xl relative">
                                                {comp.cover ? (
                                                    <img
                                                        src={comp.cover}
                                                        alt={comp.title}
                                                        class="h-full w-full object-cover object-center transition-transform duration-300 group-hover:scale-110"
                                                        loading="lazy"
                                                        decoding="async"
                                                    />
                                                ) : (
                                                    <Image
                                                        src={
                                                            championAssets.Aatrox
                                                        }
                                                        alt={comp.title}
                                                        class="h-full w-full object-cover object-center transition-transform duration-300 group-hover:scale-110"
                                                        width={480}
                                                        height={270}
                                                        quality={80}
                                                        loading="lazy"
                                                        decoding="async"
                                                    />
                                                )}
                                                <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent" />

                                                {/* Tier Badge Overlay */}
                                                <div class="absolute top-3 left-3">
                                                    <Badge
                                                        variant={getTierBadgeVariant(
                                                            tier,
                                                        )}
                                                        icon="star"
                                                        size="sm"
                                                    >
                                                        {tier}
                                                    </Badge>
                                                </div>
                                            </div>

                                            {/* Content */}
                                            <div class="p-4">
                                                <h3 class="text-lg font-bold text-white mb-3 line-clamp-2 min-h-[3.5rem]">
                                                    {comp.title}
                                                </h3>

                                                {/* Tags */}
                                                {comp.tags && (
                                                    <div class="flex flex-wrap gap-2 mb-3">
                                                        {formatTags(
                                                            comp.tags,
                                                        ).map((tag: string) => (
                                                            <Badge
                                                                variant={getTagVariant(
                                                                    tag,
                                                                )}
                                                                size="xs"
                                                            >
                                                                {tag}
                                                            </Badge>
                                                        ))}
                                                    </div>
                                                )}

                                                {/* Update Time */}
                                                <div class="flex items-center gap-2 text-sm text-slate-400">
                                                    <i class="fa-solid fa-clock text-xs" />
                                                    <span>
                                                        Actualizado{" "}
                                                        {getUpdateTime(comp)}
                                                    </span>
                                                </div>
                                            </div>
                                        </Card>
                                    ))}
                                </div>
                            </Section>
                        );
                    })
            }

            <!-- Empty State -->
            {
                compositions && compositions.length === 0 && (
                    <Section spacing="xl">
                        <Card
                            variant="glass"
                            padding="xl"
                            className="text-center"
                        >
                            <div class="flex flex-col items-center gap-4">
                                <div class="text-6xl opacity-50">
                                    <i class="fa-solid fa-folder-open" />
                                </div>
                                <h3 class="text-2xl font-bold text-white">
                                    No hay composiciones disponibles
                                </h3>
                                <p class="text-slate-400 max-w-md">
                                    No hay composiciones disponibles en este
                                    momento. Vuelve más tarde para ver las
                                    últimas estrategias.
                                </p>
                            </div>
                        </Card>
                    </Section>
                )
            }
        </Container>

</Layout>

<style>
    /* Animación suave para las cards */
    @media (prefers-reduced-motion: no-preference) {
        .group {
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
    }

    /* Line clamp para títulos */
    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>
