---
import Layout from "../../layouts/Layout.astro";
import Container from "../../components/ui/Container.astro";
import CompositionList from "../../components/compositions/CompositionList.astro";
import Spinner from "../../components/ui/Spinner.astro";

export const prerender = true;
---

<Layout
    title="Composiciones TFT - AKACompos"
    description="Lista completa de las mejores composiciones de Teamfight Tactics (TFT) para el parche actual. Encuentra tu estrategia ganadora."
>
    <!-- Header -->
    <div class="relative overflow-hidden border-b border-white/5 bg-slate-900 pt-24 pb-12">
        <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_top_left,rgba(234,179,8,0.18),transparent_48%),radial-gradient(circle_at_80%_10%,rgba(59,130,246,0.12),transparent_40%)]" />
        <Container maxWidth="xl">
            <div class="relative max-w-4xl space-y-6">
                <div class="inline-flex items-center gap-2 rounded-full border border-amber-400/30 bg-amber-400/10 px-3 py-1 text-xs font-medium text-amber-300">
                    <i class="fa-solid fa-layer-group text-[10px]" />
                    Tier list del meta actual
                </div>

                <h1 class="font-display text-4xl md:text-5xl font-semibold text-white leading-tight">
                    Composiciones TFT
                    <span class="block text-gradient">mas claras y accionables</span>
                </h1>

                <p class="max-w-3xl text-base md:text-lg text-slate-300">
                    Las mejores composiciones de AKAWonder actualizadas para el meta actual.
                    Abre cada composicion para ver tablero final, sinergias, objetos y plan de juego en
                    un solo vistazo.
                </p>

                <p class="text-sm text-slate-400">
                    Elige un tier, abre una composicion y aplica la guia directamente en partida.
                </p>
            </div>
        </Container>
    </div>

    <!-- Content -->
    <div class="py-10">
        <Container maxWidth="xl">
            <CompositionList server:defer>
                <div slot="fallback" class="flex justify-center items-center py-20">
                    <Spinner size="lg" color="primary" />
                </div>
            </CompositionList>
        </Container>
    </div>
</Layout>
