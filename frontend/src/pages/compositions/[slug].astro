---
import Layout from "../../layouts/Layout.astro";
import Card from "../../components/ui/Card.astro";
import Badge from "../../components/ui/Badge.astro";
import Button from "../../components/ui/Button.astro";
import Section from "../../components/ui/Section.astro";
import Container from "../../components/ui/Container.astro";
import TFTBoardFromData from "../../components/TFTBoardFromData.astro";
import TraitsDisplay from "../../components/TraitsDisplay.astro";
import { getCompositions, getComposition } from "../../lib/strapi";
import ItemWithImage from "../../components/ItemWithImage.astro";
import AugmentGrid from "../../components/AugmentGrid.astro";
import dayjs from "dayjs";
import utc from "dayjs/plugin/utc";
import relativeTime from "dayjs/plugin/relativeTime";
import es from "dayjs/locale/es";
import {
    getChampionImage,
    getChampionNames,
    getItemImage,
    getItemNames,
} from "../../utils/assets.ts";
dayjs.locale(es);
dayjs.extend(utc);
dayjs.extend(relativeTime);

export async function getStaticPaths() {
    const { data: compositions } = await getCompositions();

    return compositions
        ? compositions.map((composition: any) => ({
              params: { slug: composition.slug },
              props: { composition },
          }))
        : [];
}

const { composition } = Astro.props;
const { slug } = Astro.params;

// Fallback para SSR si no se encontró en getStaticPaths
if (!composition && slug) {
    const { data: fetchedComposition, error } = await getComposition(
        slug as string,
    );
    if (error || !fetchedComposition) {
        return Astro.redirect("/404");
    }
    Astro.props.composition = fetchedComposition;
}

const currentComposition = Astro.props.composition;

if (!currentComposition) {
    return Astro.redirect("/404");
}

const lastModified = dayjs(
    currentComposition.updatedAt || currentComposition.createdAt,
)
    .utc()
    .fromNow();

// Parsear board si es un string JSON
let boardData = currentComposition.board;
if (typeof boardData === "string") {
    try {
        boardData = JSON.parse(boardData);
    } catch (e) {
        console.error("Error parsing board JSON:", e);
        boardData = null;
    }
}

// Parsear coreItems si es un string JSON
let coreItemsData = currentComposition.coreItems;
if (typeof coreItemsData === "string") {
    try {
        coreItemsData = JSON.parse(coreItemsData);
    } catch (e) {
        console.error("Error parsing coreItems JSON:", e);
        coreItemsData = [];
    }
}

// Parsear augments si es un string JSON
let augmentsData = currentComposition.augments;
if (typeof augmentsData === "string") {
    try {
        augmentsData = JSON.parse(augmentsData);
    } catch (e) {
        console.error("Error parsing augments JSON:", e);
        augmentsData = [];
    }
}

// Augments can be strings (IDs) or objects
// Leave them as-is, AugmentGrid will handle both formats

// Extraer lista de campeones del board
const championsList = boardData?.champions
    ? boardData.champions.map((champ: any) => champ.name)
    : [];

// Función para determinar variante de badge según tier
function getTierBadgeVariant(
    tier: string,
): "primary" | "success" | "warning" | "default" {
    switch (tier) {
        case "S Tier":
            return "primary";
        case "A Tier":
            return "success";
        case "B Tier":
            return "warning";
        default:
            return "default";
    }
}

// Función para determinar tier de card
function getCardTier(tier: string): "gold" | "silver" | "bronze" | null {
    switch (tier) {
        case "S Tier":
            return "gold";
        case "A Tier":
            return "silver";
        case "B Tier":
            return "bronze";
        default:
            return null;
    }
}

// Función para determinar variante de badge por tag
function getTagVariant(
    tag: string,
): "fast" | "reroll" | "aggressive" | "defensive" | "primary" {
    const lowerTag = tag.toLowerCase();
    if (lowerTag.includes("fast")) return "fast";
    if (lowerTag.includes("reroll")) return "reroll";
    if (lowerTag.includes("aggressive") || lowerTag.includes("agresivo"))
        return "aggressive";
    if (lowerTag.includes("defensive") || lowerTag.includes("defensivo"))
        return "defensive";
    return "primary";
}

export function parseImages(description: any): string {
    let result: string;
    if (typeof description === "string") {
        result = description;
    } else if (Array.isArray(description)) {
        result = description
            .map((block) => {
                if (block.children && Array.isArray(block.children)) {
                    return block.children
                        .map((child) => child.text || "")
                        .join("");
                }
                return "";
            })
            .join("\n");
    } else {
        result = "";
    }
    const allKeywords = getItemNames().concat(getChampionNames());
    for (const matchName of allKeywords) {
        result = result.replace(
            new RegExp(`\\b${matchName}\\b`, "gi"),
            `<b>${matchName}</b> <img src="${getChampionNames().includes(matchName) ? getChampionImage(matchName) : getItemImage(matchName)}" alt="${matchName}" class="rounded-full aspect-square h-7 inline align-middle border-2 border-primary object-fill drop-shadow-md"/>`,
        );
    }
    return result;
}

// SEO Logic
const seoTitle = `${currentComposition.tier} - ${currentComposition.title} | AKACompos`;
const seoDescription = `Guía completa para la composición ${currentComposition.title} (${currentComposition.tier}) en TFT. Descubre los mejores objetos, aumentos y posicionamiento para ganar con esta estrategia.`;
let seoImage = "/akawonder.png";
if (championsList.length > 0) {
    seoImage = getChampionImage(championsList[0]);
}
---

<Layout title={seoTitle} description={seoDescription} image={seoImage}>
    <!-- Header Section -->
    <Section
        variant="gradient"
        spacing="lg"
        divider={true}
        dividerPosition="bottom"
    >
        <Container maxWidth="xl">
            <div
                class="flex flex-col md:flex-row md:items-start md:justify-between gap-4"
            >
                <div class="flex-1">
                    <div class="flex items-center gap-3 mb-3">
                        <Badge
                            variant={getTierBadgeVariant(
                                currentComposition.tier,
                            )}
                            icon="star"
                            size="md"
                        >
                            {currentComposition.tier}
                        </Badge>
                    </div>
                    <h1 class="text-3xl md:text-5xl font-bold text-white mb-3">
                        {currentComposition.title}
                    </h1>
                    <div class="flex items-center gap-2 text-sm text-slate-400">
                        <i class="fa-solid fa-clock"></i>
                        <span>Actualizado {lastModified}</span>
                        <span class="text-slate-600">•</span>
                        <span
                            >por <a
                                class="font-medium text-primary hover:underline"
                                href="#">{currentComposition.author}</a
                            ></span
                        >
                    </div>
                </div>
                <div>
                    <div>
                        {
                            currentComposition.compCode && (
                                <Button
                                    id="copy-btn"
                                    variant="primary"
                                    size="lg"
                                    icon="copy"
                                    iconPosition="left"
                                    data-comp-code={currentComposition.compCode}
                                >
                                    <span id="copy-text">Copiar Código</span>
                                </Button>
                            )
                        }
                    </div>
                </div>
            </div>
            {
                currentComposition.tags && (
                    <div class="mt-6 flex flex-wrap gap-2">
                        {(Array.isArray(currentComposition.tags)
                            ? currentComposition.tags
                            : typeof currentComposition.tags === "string"
                              ? currentComposition.tags
                                    .split(",")
                                    .map((t) => t.trim())
                              : []
                        ).map((tag: string) => (
                            <Badge variant={getTagVariant(tag)} size="sm">
                                {tag}
                            </Badge>
                        ))}
                    </div>
                )
            }
        </Container>
    </Section>

    <!-- Main Content -->
    <Section spacing="lg">
        <Container maxWidth="xl">
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 lg:gap-8">
                <!-- Left Column: Board and Description -->
                <div class="lg:col-span-2 space-y-6">
                    <!-- Traits Display -->
                    {
                        championsList.length > 0 && (
                            <Card variant="gradient" padding="lg">
                                <h2 class="text-2xl font-bold text-white mb-4 flex items-center gap-2">
                                    <i class="fa-solid fa-sparkles text-primary" />
                                    Traits Activos
                                </h2>
                                <TraitsDisplay champions={championsList} />
                            </Card>
                        )
                    }

                    <!-- Board -->
                    <Card
                        variant="gradient"
                        padding="lg"
                        tier={getCardTier(currentComposition.tier)}
                    >
                        <h2
                            class="text-2xl font-bold text-white mb-4 flex items-center gap-2"
                        >
                            <i class="fa-solid fa-chess-board text-primary"></i>
                            Tablero
                        </h2>
                        {
                            boardData ? (
                                <div class="tft-board-wrapper">
                                    <TFTBoardFromData
                                        boardSize="large"
                                        boardData={boardData}
                                    />
                                </div>
                            ) : (
                                <div class="text-center py-12">
                                    <i class="fa-solid fa-chess-board text-6xl text-slate-600 mb-4" />
                                    <p class="text-slate-400">
                                        Board no configurado aún
                                    </p>
                                </div>
                            )
                        }
                    </Card>

                    <!-- Description Cards -->
                    <div class="space-y-6">
                        <Card variant="glass" padding="lg">
                            <h3
                                class="text-xl font-bold text-white mb-4 flex items-center gap-2"
                            >
                                <i class="fa-solid fa-lightbulb text-yellow-400"
                                ></i>
                                Cuándo jugarla
                            </h3>
                            <div
                                class="text-sm text-slate-300 leading-relaxed prose prose-invert max-w-none"
                            >
                                <Fragment
                                    set:html={parseImages(
                                        currentComposition.description,
                                    )}
                                />
                            </div>
                        </Card>

                        <Card variant="glass" padding="lg">
                            <h3
                                class="text-xl font-bold text-white mb-4 flex items-center gap-2"
                            >
                                <i class="fa-solid fa-gamepad text-blue-400"
                                ></i>
                                Modo de juego
                            </h3>
                            <div
                                class="text-sm text-slate-300 leading-relaxed prose prose-invert max-w-none"
                            >
                                <Fragment
                                    set:html={parseImages(
                                        currentComposition.gameplayMode,
                                    )}
                                />
                            </div>
                        </Card>
                    </div>
                </div>

                <!-- Right Column: Items and Augments -->
                <div class="space-y-6">
                    <!-- Core Items -->
                    {
                        coreItemsData &&
                            Array.isArray(coreItemsData) &&
                            coreItemsData.length > 0 && (
                                <Card variant="gradient" padding="lg">
                                    <h2 class="text-2xl font-bold text-white mb-4 flex items-center gap-2">
                                        <i class="fa-solid fa-gem text-purple-400" />
                                        Core Items
                                    </h2>
                                    <div class="space-y-3">
                                        {coreItemsData.map((item: any) => (
                                            <Card
                                                variant="default"
                                                padding="md"
                                                hover={true}
                                            >
                                                <ItemWithImage
                                                    itemName={item.name}
                                                    description={
                                                        item.description
                                                    }
                                                    size="medium"
                                                />
                                            </Card>
                                        ))}
                                    </div>
                                </Card>
                            )
                    }

                    <!-- Recommended Augments -->
                    {
                        augmentsData &&
                            Array.isArray(augmentsData) &&
                            augmentsData.length > 0 && (
                                <Card variant="gradient" padding="lg">
                                    <h2 class="text-2xl font-bold text-white mb-4 flex items-center gap-2">
                                        <i class="fa-solid fa-wand-magic-sparkles text-amber-400" />
                                        Augmentos Recomendados
                                    </h2>
                                    <AugmentGrid augments={augmentsData} />
                                </Card>
                            )
                    }
                </div>
            </div>
        </Container>
    </Section></Layout
>

<style>
    /* Controlar z-index del board para que los tooltips puedan estar encima */
    .tft-board-wrapper {
        isolation: isolate;
        z-index: 1;
    }

    /* Estilos para el contenido HTML parseado */
    .prose :global(b) {
        color: rgb(var(--color-primary));
        font-weight: 600;
    }

    .prose :global(img) {
        display: inline;
        margin: 0 0.25rem;
    }

    @keyframes copied {
        0% {
            transform: scale(1);
        }
        50% {
            transform: scale(1.1);
        }
        100% {
            transform: scale(1);
        }
    }

    .animate-copied {
        animation: copied 0.3s ease-in-out;
    }
</style>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const copyBtn = document.getElementById(
            "copy-btn",
        ) as HTMLButtonElement;
        const copyText = document.getElementById("copy-text");

        if (copyBtn && copyText) {
            copyBtn.addEventListener("click", async () => {
                const compCode = copyBtn.getAttribute("data-comp-code");

                if (!compCode) {
                    console.error("No comp code found");
                    alert("No se encontró el código de la composición.");
                    return;
                }

                try {
                    await navigator.clipboard.writeText(compCode);

                    // Add animation class
                    copyBtn.classList.add("animate-copied");

                    // Change text temporarily
                    const icon = copyBtn.querySelector("i");
                    if (icon) {
                        icon.classList.remove("fa-copy");
                        icon.classList.add("fa-check");
                    }
                    copyText.textContent = "¡Copiado!";

                    // Remove animation class after animation completes
                    setTimeout(() => {
                        copyBtn.classList.remove("animate-copied");
                    }, 300);

                    // Revert back to original after 2 seconds
                    setTimeout(() => {
                        if (icon) {
                            icon.classList.remove("fa-check");
                            icon.classList.add("fa-copy");
                        }
                        copyText.textContent = "Copiar Código";
                    }, 2000);
                } catch (err) {
                    console.error("Failed to copy:", err);
                    copyText.textContent = "Error al copiar";
                    setTimeout(() => {
                        copyText.textContent = "Copiar Código";
                    }, 2000);
                }
            });
        }
    });
</script>
