---
import Layout from "../../layouts/Layout.astro";
import Card from "../../components/ui/Card.astro";
import Badge from "../../components/ui/Badge.astro";
import Section from "../../components/ui/Section.astro";
import Container from "../../components/ui/Container.astro";
import TFTBoardFromData from "../../components/TFTBoardFromData.astro";
import TraitsDisplay from "../../components/TraitsDisplay.astro";
import { getCompositions, getComposition } from "../../lib/strapi";
import ItemWithImage from "../../components/ItemWithImage.astro";
import AugmentGrid from "../../components/AugmentGrid.astro";
import dayjs from "dayjs";
import utc from "dayjs/plugin/utc";
import relativeTime from "dayjs/plugin/relativeTime";
import es from "dayjs/locale/es";
import {
    getChampionImage,
    getChampionNames,
    getItemImage,
    getItemNames,
} from "../../utils/assets.ts";
import { getTraitByName } from "../../utils/traits.ts";
dayjs.locale(es);
dayjs.extend(utc);
dayjs.extend(relativeTime);

export async function getStaticPaths() {
    const { data: compositions } = await getCompositions();

    return compositions
        ? compositions.map((composition: any) => ({
              params: { slug: composition.slug },
              props: { composition },
          }))
        : [];
}

const { composition } = Astro.props;
const { slug } = Astro.params;

if (!composition && slug) {
    const { data: fetchedComposition, error } = await getComposition(
        slug as string,
    );
    if (error || !fetchedComposition) {
        return Astro.redirect("/404");
    }
    Astro.props.composition = fetchedComposition;
}

const currentComposition = Astro.props.composition;

if (!currentComposition) {
    return Astro.redirect("/404");
}

const lastModified = dayjs(
    currentComposition.updatedAt || currentComposition.createdAt,
)
    .utc()
    .fromNow();

let boardData = currentComposition.board;
if (typeof boardData === "string") {
    try {
        boardData = JSON.parse(boardData);
    } catch (e) {
        boardData = null;
    }
}

let coreItemsData = currentComposition.coreItems;
if (typeof coreItemsData === "string") {
    try {
        coreItemsData = JSON.parse(coreItemsData);
    } catch (e) {
        coreItemsData = [];
    }
}

let augmentsData = currentComposition.augments;
if (typeof augmentsData === "string") {
    try {
        augmentsData = JSON.parse(augmentsData);
    } catch (e) {
        augmentsData = [];
    }
}

const championsList = boardData?.champions
    ? boardData.champions.map((champ: any) => champ.name)
    : [];

const hasRightColumn =
    (coreItemsData && Array.isArray(coreItemsData) && coreItemsData.length > 0) ||
    (augmentsData && Array.isArray(augmentsData) && augmentsData.length > 0);

function getTierBadgeVariant(tier: string): "primary" | "success" | "warning" | "default" {
    switch (tier) {
        case "S Tier": return "primary";
        case "A Tier": return "success";
        case "B Tier": return "warning";
        default: return "default";
    }
}

function getTagIcon(tag: string) {
    const champImg = getChampionImage(tag);
    if (champImg && champImg !== tag) return { src: champImg, isTrait: false };

    const trait = getTraitByName(tag);
    if (trait && trait.icon) {
        return { 
            src: typeof trait.icon === "string" ? trait.icon : trait.icon.src, 
            isTrait: true 
        };
    }
    return null;
}

export function parseImages(description: any): string {
    let result: string;
    if (typeof description === "string") {
        result = description;
    } else if (Array.isArray(description)) {
        result = description
            .map((block) => {
                if (block.children && Array.isArray(block.children)) {
                    return block.children.map((child) => child.text || "").join("");
                }
                return "";
            })
            .join("\n");
    } else {
        result = "";
    }
    const allKeywords = getItemNames().concat(getChampionNames());
    for (const matchName of allKeywords) {
        result = result.replace(
            new RegExp(`\\b${matchName}\\b`, "gi"),
            `<b>${matchName}</b> <img src="${getChampionNames().includes(matchName) ? getChampionImage(matchName) : getItemImage(matchName)}" alt="${matchName}" class="rounded-full aspect-square h-5 inline align-middle border border-slate-600"/>`,
        );
    }
    return result;
}

const seoTitle = `${currentComposition.tier} - ${currentComposition.title} | AKACompos`;
const seoDescription = `Guía completa para la composición ${currentComposition.title} (${currentComposition.tier}) en TFT. Descubre los mejores objetos, aumentos y posicionamiento.`;
let seoImage = "/akawonder.png";
if (championsList.length > 0) {
    seoImage = getChampionImage(championsList[0]);
}
---

<Layout title={seoTitle} description={seoDescription} image={seoImage}>
    <!-- Header Section -->
    <div class="relative bg-slate-900 border-b border-white/5 pt-24 pb-12">
        {currentComposition.cover && (
            <div class="absolute inset-0 z-0">
                <img 
                    src={currentComposition.cover} 
                    alt="" 
                    class="w-full h-full object-cover opacity-20"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/90 to-slate-950/70"></div>
            </div>
        )}
        
        <Container maxWidth="xl" className="relative z-10">
            <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6">
                <div class="flex-1 space-y-4">
                    <div class="flex flex-wrap items-center gap-2">
                        <Badge variant={getTierBadgeVariant(currentComposition.tier)} size="md">
                            {currentComposition.tier}
                        </Badge>
                        {
                            currentComposition.tags && (
                                (Array.isArray(currentComposition.tags)
                                    ? currentComposition.tags
                                    : typeof currentComposition.tags === "string"
                                      ? currentComposition.tags.split(",").map((t) => t.trim())
                                      : []
                                ).map((tag: string) => {
                                    const tagIcon = getTagIcon(tag);
                                    return (
                                        <Badge variant="default" size="sm">
                                            {tagIcon && (
                                                <img 
                                                    src={tagIcon.src} 
                                                    alt={tag} 
                                                    class={`w-4 h-4 rounded-full object-cover mr-1 ${tagIcon.isTrait ? 'invert brightness-200' : ''}`}
                                                />
                                            )}
                                            {tag}
                                        </Badge>
                                    );
                                })
                            )
                        }
                    </div>
                    
                    <h1 class="text-3xl md:text-5xl font-bold text-white">
                        {currentComposition.title}
                    </h1>
                    
                    <div class="flex flex-wrap items-center gap-4 text-sm text-slate-400">
                        <span>Actualizado {lastModified}</span>
                        <span class="text-slate-600">•</span>
                        <span>por {currentComposition.author}</span>
                    </div>
                </div>

                {currentComposition.compCode && (
                    <button
                        id="copy-btn"
                        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-primary text-white font-medium hover:bg-primary-dark transition-colors"
                        data-comp-code={currentComposition.compCode}
                    >
                        <i class="fa-solid fa-copy"></i>
                        <span id="copy-text">Copiar código</span>
                    </button>
                )}
            </div>
        </Container>
    </div>

    <!-- Main Content -->
    <Section spacing="lg" className="py-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
            <!-- Left Column -->
            <div class={hasRightColumn ? "lg:col-span-8 space-y-8" : "lg:col-span-12 space-y-8"}>
                <!-- Board Section -->
                <Card variant="default" padding="none">
                    <div class="p-4 border-b border-white/5 flex items-center justify-between">
                        <h2 class="text-lg font-semibold text-white flex items-center gap-2">
                            <i class="fa-solid fa-chess-board text-primary"></i>
                            Tablero Final
                        </h2>
                    </div>
                    
                    <div class="p-4">
                        {boardData ? (
                            <div class="flex justify-center overflow-x-auto">
                                <TFTBoardFromData
                                    boardSize="large"
                                    boardData={boardData}
                                    fullWidth={!hasRightColumn}
                                />
                            </div>
                        ) : (
                            <div class="text-center py-12">
                                <i class="fa-solid fa-chess-board text-4xl text-slate-700 mb-3" />
                                <p class="text-slate-500">Configuración de tablero pendiente</p>
                            </div>
                        )}
                    </div>
                    
                    {championsList.length > 0 && (
                        <div class="p-4 bg-slate-900/50 border-t border-white/5">
                            <h3 class="text-sm font-medium text-slate-400 mb-3">Sinergias Activas</h3>
                            <TraitsDisplay champions={championsList} />
                        </div>
                    )}
                </Card>

                <!-- Strategy Guide -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <Card variant="glass" padding="lg">
                        <h3 class="text-lg font-semibold text-white mb-4 flex items-center gap-2">
                            <i class="fa-solid fa-lightbulb text-yellow-500"></i>
                            Cuándo jugarla
                        </h3>
                        <div class="text-slate-300 text-sm leading-relaxed prose prose-invert max-w-none">
                            <Fragment set:html={parseImages(currentComposition.description)} />
                        </div>
                    </Card>

                    <Card variant="glass" padding="lg">
                        <h3 class="text-lg font-semibold text-white mb-4 flex items-center gap-2">
                            <i class="fa-solid fa-gamepad text-blue-500"></i>
                            Modo de juego
                        </h3>
                        <div class="text-slate-300 text-sm leading-relaxed prose prose-invert max-w-none">
                            <Fragment set:html={parseImages(currentComposition.gameplayMode)} />
                        </div>
                    </Card>
                </div>
            </div>

            <!-- Right Column -->
            {hasRightColumn && (
                <div class="lg:col-span-4 space-y-6">
                    {coreItemsData && Array.isArray(coreItemsData) && coreItemsData.length > 0 && (
                        <Card variant="surface" padding="lg">
                            <h2 class="text-lg font-semibold text-white mb-4 flex items-center gap-2">
                                <i class="fa-solid fa-gem text-purple-500"></i>
                                Core Items
                            </h2>
                            <div class="space-y-2">
                                {coreItemsData.map((item: any) => (
                                    <div class="p-2 rounded-lg hover:bg-white/5 transition-colors">
                                        <ItemWithImage
                                            itemName={item.name}
                                            description={item.description}
                                            size="medium"
                                        />
                                    </div>
                                ))}
                            </div>
                        </Card>
                    )}

                    {augmentsData && Array.isArray(augmentsData) && augmentsData.length > 0 && (
                        <Card variant="surface" padding="lg">
                            <h2 class="text-lg font-semibold text-white mb-4 flex items-center gap-2">
                                <i class="fa-solid fa-wand-magic-sparkles text-amber-500"></i>
                                Aumentos
                            </h2>
                            <AugmentGrid augments={augmentsData} />
                        </Card>
                    )}
                </div>
            )}
        </div>
    </Section>
</Layout>

<style>
    .prose :global(b) {
        color: rgb(var(--color-primary));
        font-weight: 600;
    }
    .prose :global(img) {
        display: inline;
        margin: 0 0.25rem;
    }
</style>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const copyBtn = document.getElementById("copy-btn") as HTMLButtonElement;
        const copyText = document.getElementById("copy-text");

        if (copyBtn && copyText) {
            copyBtn.addEventListener("click", async () => {
                const compCode = copyBtn.getAttribute("data-comp-code");

                if (!compCode) {
                    alert("No se encontró el código de la composición.");
                    return;
                }

                try {
                    await navigator.clipboard.writeText(compCode);
                    const icon = copyBtn.querySelector("i");
                    if (icon) {
                        icon.classList.remove("fa-copy");
                        icon.classList.add("fa-check");
                    }
                    copyText.textContent = "¡Copiado!";

                    setTimeout(() => {
                        if (icon) {
                            icon.classList.remove("fa-check");
                            icon.classList.add("fa-copy");
                        }
                        copyText.textContent = "Copiar código";
                    }, 2000);
                } catch (err) {
                    copyText.textContent = "Error al copiar";
                    setTimeout(() => {
                        copyText.textContent = "Copiar código";
                    }, 2000);
                }
            });
        }
    });
</script>
