---
import Layout from "../layouts/Layout.astro";
import LegalPage from "../components/legal/LegalPage.astro";

export const prerender = true;

const sections = [
    {
        id: "uso-del-sitio",
        title: "Uso permitido del sitio",
        body: [
            "AKACompos es una herramienta informativa para consultar composiciones, estudiar el meta y aprender de la curación estratégica de AKAWonder. El uso esperado es normal, respetuoso y orientado a la consulta de contenido.",
            "No está permitido utilizar la plataforma para intentar degradar el servicio, interferir con su funcionamiento, automatizar accesos abusivos o apropiarse del contenido como si fuera propio.",
        ],
        bullets: [
            "Puedes usar AKACompos para informarte, aprender y consultar estrategias.",
            "No puedes intentar romper la web, saturarla o usarla con fines malintencionados.",
            "No puedes redistribuir el trabajo editorial de la plataforma como si fuera tuyo.",
        ],
    },
    {
        id: "propiedad-intelectual",
        title: "Propiedad intelectual y atribución",
        body: [
            "Teamfight Tactics, sus nombres, personajes, marcas y activos relacionados pertenecen a Riot Games. AKACompos funciona como proyecto de comunidad y mantiene ese marco de referencia.",
            "La selección, curación, redacción y presentación de composiciones publicada en el sitio forma parte del trabajo propio de AKACompos y AKAWonder.",
        ],
        note: "Respetar la autoría del contenido y el marco de Riot es parte de usar la plataforma con buen criterio.",
    },
    {
        id: "limites-y-cambios",
        title: "Disponibilidad, cambios y sentido común",
        body: [
            "El meta cambia, las composiciones evolucionan y la plataforma puede actualizar su contenido, estructura o funcionamiento cuando sea necesario. AKACompos intenta mantenerse útil y preciso, pero no promete disponibilidad absoluta ni ausencia total de errores en todo momento.",
            "Si continúas usando la web, entendemos que aceptas estas reglas básicas de uso razonable y convivencia con el trabajo de quienes mantienen el proyecto.",
        ],
        note: "La regla de oro sigue siendo la más simple: usa la web con respeto y deja el tryhard para la partida, no para romper el sitio.",
    },
];
---

<Layout 
    title="Términos de Servicio - AKACompos"
    description="Condiciones de uso de AKACompos explicadas con claridad y en el mismo tono editorial del sitio."
>
    <LegalPage
        eyebrow="Términos"
        title="Términos de Servicio"
        intro="Las reglas fuera del tablero: un marco simple para usar AKACompos con normalidad, respetar el contenido y entender los límites razonables de la plataforma."
        outro="Menos jerga legal, más claridad para que puedas volver al juego cuanto antes."
        sections={sections}
    />
</Layout>