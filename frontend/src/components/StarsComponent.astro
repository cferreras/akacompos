---
interface Props {
    stars: number;
}

const {stars} = Astro.props;
---

{stars > 1 && (
    <div class="flex items-center justify-center gap-0.5 px-1 py-0.5 rounded bg-yellow-500">
        {Array.from({length: stars}, (_) => (
            <span class="text-xs text-slate-900 font-bold">★</span>
        ))}
    </div>
)}
