---
interface Props {
    stars: number;
}

const {stars} = Astro.props;
---
{stars > 1 && (
<div class="star-container flex w-[90%] flex-row items-center justify-center gap-0.5 rounded-[4px] bg-yellow-400 py-1 shadow-lg border border-yellow-500/30">

    {Array.from({length: stars}, (_) => (
            <span class="star flex items-center justify-center">★</span>
    ))}

</div>
    )}

<style>
    .star-container {
        /* Remove -skew if it makes stars look bad or keep it if desired */
        /* background: linear-gradient(180deg, #facc15 0%, #eab308 100%); */
    }
    .star {
        color: #1a1a2e;
        font-size: clamp(16px, calc(var(--size) * 0.22), 24px);
        line-height: 1;
        font-weight: bold;
        text-shadow: 0 1px 1px rgba(255, 255, 255, 0.3);
    }
</style>
