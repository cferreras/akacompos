---
interface Props {
    stars: number;
}

const {stars} = Astro.props;
---
{stars > 1 && (
<div class="star-container flex items-center justify-center gap-0.5 rounded-[4px] bg-yellow-400 shadow-lg border border-yellow-500/30">
    {Array.from({length: stars}, (_) => (
            <span class="star flex items-center justify-center">★</span>
    ))}
</div>
    )}

<style>
    .star-container {
        width: fit-content;
        min-width: 60%;
        max-width: 95%;
        padding: 1px 4px;
    }
    .star {
        color: #1a1a2e;
        font-size: clamp(10px, calc(var(--size) * 0.18), 20px);
        line-height: 1;
        font-weight: bold;
        text-shadow: 0 1px 1px rgba(255, 255, 255, 0.3);
    }
</style>
