---
/**
 * Container Component - Componente de contenedor reutilizable
 *
 * @param maxWidth - Ancho máximo del contenedor: 'sm' | 'md' | 'lg' | 'xl' | '2xl' | '3xl' | '4xl' | '5xl' | 'full'
 * @param padding - Padding del contenedor: 'none' | 'sm' | 'md' | 'lg' | 'xl'
 * @param paddingY - Padding vertical específico (sobrescribe padding): 'none' | 'sm' | 'md' | 'lg' | 'xl' | '2xl' | '3xl'
 * @param paddingX - Padding horizontal específico (sobrescribe padding): 'none' | 'sm' | 'md' | 'lg' | 'xl'
 * @param center - Centrar el contenedor horizontalmente: boolean
 * @param className - Clases adicionales
 */

export interface Props {
    maxWidth?: 'sm' | 'md' | 'lg' | 'xl' | '2xl' | '3xl' | '4xl' | '5xl' | 'full';
    padding?: 'none' | 'sm' | 'md' | 'lg' | 'xl';
    paddingY?: 'none' | 'sm' | 'md' | 'lg' | 'xl' | '2xl' | '3xl';
    paddingX?: 'none' | 'sm' | 'md' | 'lg' | 'xl';
    center?: boolean;
    className?: string;
}

const {
    maxWidth = 'xl',
    padding = 'md',
    paddingY,
    paddingX,
    center = true,
    className = '',
} = Astro.props;

// Max width classes
const maxWidthClasses = {
    sm: 'max-w-screen-sm',
    md: 'max-w-screen-md',
    lg: 'max-w-screen-lg',
    xl: 'max-w-screen-xl',
    '2xl': 'max-w-screen-2xl',
    '3xl': 'max-w-7xl',
    '4xl': 'max-w-[1600px]',
    '5xl': 'max-w-[1920px]',
    full: 'max-w-full',
};

// Padding classes
const paddingClasses = {
    none: '',
    sm: 'p-2 sm:p-4',
    md: 'p-4 sm:p-6 lg:p-8',
    lg: 'p-6 sm:p-8 lg:p-12',
    xl: 'p-8 sm:p-12 lg:p-16',
};

// Padding Y classes
const paddingYClasses = {
    none: 'py-0',
    sm: 'py-2 sm:py-4',
    md: 'py-4 sm:py-6 lg:py-8',
    lg: 'py-6 sm:py-8 lg:py-12',
    xl: 'py-8 sm:py-12 lg:py-16',
    '2xl': 'py-12 sm:py-16 lg:py-24',
    '3xl': 'py-16 sm:py-24 lg:py-32',
};

// Padding X classes
const paddingXClasses = {
    none: 'px-0',
    sm: 'px-2 sm:px-4',
    md: 'px-4 sm:px-6 lg:px-8',
    lg: 'px-6 sm:px-8 lg:px-12',
    xl: 'px-8 sm:px-12 lg:px-16',
};

// Centrar
const centerClass = center ? 'mx-auto' : '';

// Combinar todas las clases
const classes = [
    'w-full',
    maxWidthClasses[maxWidth],
    centerClass,
    paddingY ? paddingYClasses[paddingY] : paddingX ? paddingXClasses[paddingX] : paddingClasses[padding],
    paddingY && paddingX ? `${paddingYClasses[paddingY]} ${paddingXClasses[paddingX]}` : '',
    className,
].filter(Boolean).join(' ');
---

<div class={classes}>
    <slot />
</div>

<style>
    /* Asegurar que el contenedor sea responsive */
    div {
        box-sizing: border-box;
    }
</style>
