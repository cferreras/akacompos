---
/**
 * Section Component - Componente de sección reutilizable
 */

import Container from "./Container.astro";

export interface Props {
    title?: string;
    subtitle?: string;
    id?: string;
    variant?: 'default' | 'gradient' | 'bordered';
    spacing?: 'none' | 'sm' | 'md' | 'lg' | 'xl';
    className?: string;
    maxWidth?: 'sm' | 'md' | 'lg' | 'xl' | '2xl' | 'full';
}

const {
    title,
    subtitle,
    id,
    variant = 'default',
    spacing = 'lg',
    className = '',
    maxWidth = 'xl',
} = Astro.props;

const variantClasses = {
    default: '',
    gradient: 'bg-gradient-to-b from-slate-900/50 to-slate-950/50',
    bordered: 'border-y border-white/5',
};

const spacingClasses = {
    none: 'py-0',
    sm: 'py-4',
    md: 'py-8',
    lg: 'py-12',
    xl: 'py-16 md:py-24',
};

const classes = [
    variantClasses[variant],
    spacingClasses[spacing],
    className,
].filter(Boolean).join(' ');
---

<section class={classes} id={id}>
    <Container maxWidth={maxWidth}>
        {(title || subtitle) && (
            <div class="mb-8 md:mb-12">
                {title && (
                    <h2 class="text-2xl md:text-3xl font-bold text-white mb-3">
                        {title}
                    </h2>
                )}
                {subtitle && (
                    <p class="text-slate-400 max-w-2xl">
                        {subtitle}
                    </p>
                )}
            </div>
        )}
        <slot />
    </Container>
</section>
