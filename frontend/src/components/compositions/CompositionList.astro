---
import Card from "../ui/Card.astro";
import Section from "../ui/Section.astro";
import { getCompositions } from "../../lib/strapi";
import { normalizeCompositionSet } from "../../utils/compositionPaths";
import { CompositionList as CompositionListReact } from "./CompositionList";

const {
    initialExpandedSlug,
    setFilter,
    compositions: providedCompositions,
} = Astro.props;

const normalizedSet = normalizeCompositionSet(setFilter);
const shouldFetch = providedCompositions === undefined;
const result = shouldFetch
    ? await getCompositions(normalizedSet ?? undefined)
    : { data: providedCompositions, error: null };
const { data: compositions, error } = result;
---

{
    error && (
        <Section spacing="lg">
            <Card
                variant="outlined"
                padding="lg"
                className="border-red-500/50 bg-red-500/10"
            >
                <div class="text-red-400">
                    <h3 class="text-lg font-bold mb-2">
                        <i class="fa-solid fa-exclamation-triangle mr-2" />
                        Error al cargar las composiciones
                    </h3>
                    <p class="mb-3">
                        No se pudieron cargar las composiciones desde Strapi.
                        Por favor, verifica la configuración.
                    </p>
                    <div class="text-sm space-y-1">
                        <p class="font-semibold">Asegúrate de que:</p>
                        <ul class="ml-4 list-disc space-y-1 text-red-300">
                            <li>
                                El content type 'compositions' existe en Strapi
                            </li>
                            <li>
                                Los permisos públicos están habilitados para ese
                                content type
                            </li>
                            <li>O tienes un token válido configurado</li>
                        </ul>
                    </div>
                </div>
            </Card>
        </Section>
    )
}

{
    compositions && (
        <CompositionListReact
            compositions={compositions}
            initialExpandedSlug={initialExpandedSlug}
            client:load
        />
    )
}