---
import TFTBoardCharacter from "./TFTBoardCharacter.astro";
import {championRarity} from "../utils/assets.ts";

interface ChampionData {
    name: string;
    position: { row: number; col: number };
    items?: string[];
    stars?: number;
}

interface BoardData {
    champions: ChampionData[];
}

interface Props {
    boardData: BoardData;
    boardSize?: 'small' | 'medium' | 'large';
    fullWidth?: boolean;
}

const { boardData, boardSize = 'medium', fullWidth = false } = Astro.props;

const getBorderColor = (champ : ChampionData): "purple" | "blue" | "yellow" | "green" | "gray" | "empty" => {
    switch (championRarity[champ.name]) {
        case 5: return "yellow";
        case 4: return "purple";
        case 3: return "blue";
        case 2: return "green";
        case 1: return "gray";
        default: return "empty";
    }
};

const champions = boardData.champions.map(champ => {
    return {
        champion: champ.name,
        borderColor: getBorderColor(champ),
        items: champ.items || [],
        position: champ.position,
        stars: champ.stars || 1
    };
});

const createBoard = () => {
    const board = Array(4).fill(null).map(() => Array(7).fill(null));
    champions.forEach(champion => {
        if (champion.position.row < 4 && champion.position.col < 7) {
            board[champion.position.row][champion.position.col] = champion;
        }
    });
    return board;
};

const board = createBoard();
---

<div class={`tft-board board-size-${boardSize} ${fullWidth ? 'is-full-width' : ''}`}>
    <div class="board-container">
        {board.map((row, rowIndex) => (
            <div 
                class={`board-row ${rowIndex % 2 === 1 ? 'offset' : ''}`}
                style={`z-index: ${10 - rowIndex};`}
            >
                {row.map((cell, colIndex) => (
                    <div class="board-cell" data-row={rowIndex} data-col={colIndex}>
                        {cell ? (
                            <TFTBoardCharacter
                                champion={cell.champion as any}
                                borderColor={cell.borderColor}
                                items={cell.items as any}
                                size="var(--hex-size)"
                                stars={cell.stars}
                            />
                        ) : (
                            <TFTBoardCharacter
                                borderColor="empty"
                                size="var(--hex-size)"
                            />
                        )}
                    </div>
                ))}
            </div>
        ))}
    </div>
</div>

<style>
    :root {
        --hex-size: 72px;
        --board-gap: 8px;
        --board-offset: 40px;
    }

    @media (min-width: 1024px) {
        .is-full-width {
            --hex-size: 88px;
            --board-gap: 10px;
            --board-offset: 50px;
        }
    }

    @media (min-width: 1400px) {
        .is-full-width {
            --hex-size: 96px;
            --board-gap: 12px;
            --board-offset: 55px;
        }
    }

    .tft-board {
        padding: 1rem;
    }

    .board-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: var(--board-gap);
    }

    .board-row {
        display: flex;
        gap: var(--board-gap);
        justify-content: center;
        align-items: flex-start;
        position: relative;
    }

    .board-row.offset {
        transform: translateX(calc(var(--hex-size) / 2 + var(--board-gap) / 2));
    }

    .board-cell {
        width: var(--hex-size);
        /* Altura fija para evitar saltos */
        height: calc(var(--hex-size) + 12px);
        flex-shrink: 0;
    }

    /* Responsive */
    @media (max-width: 1280px) {
        :root {
            --hex-size: 64px;
            --board-gap: 6px;
        }
    }

    @media (max-width: 768px) {
        :root {
            --hex-size: 56px;
            --board-gap: 5px;
        }
    }

    @media (max-width: 640px) {
        :root {
            --hex-size: 44px;
            --board-gap: 4px;
        }
    }

    @media (max-width: 480px) {
        :root {
            --hex-size: 36px;
            --board-gap: 3px;
        }
    }
</style>
