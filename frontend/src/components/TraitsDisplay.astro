---
import {
    calculateActiveTraits,
    type Trait,
    type TraitTier,
    type ActiveTrait,
} from "../utils/traits";
import { Image } from "astro:assets";
import { getChampionImageMeta } from "../utils/assets";

interface Props {
    champions: string[];
}

const { champions } = Astro.props;

const activeTraits = calculateActiveTraits(champions);
---

<div class="traits-display">
    {
        activeTraits.length === 0 ? (
            <div class="p-4 bg-slate-800/20 rounded-lg border border-slate-700">
                <p class="text-slate-400 text-sm">
                    No se encontraron traits activos. Champions:{" "}
                    {champions.length > 0 ? champions.join(", ") : "Ninguno"}
                </p>
            </div>
        ) : (
            <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-3">
                {activeTraits.map(({ trait, count, activeTier, tierIndex }) => (
                    <div
                        class="trait-card relative rounded-lg p-3 bg-slate-800/50 border-2 border-slate-800"
                        data-trait-name={trait.name}
                        data-trait-description={trait.description}
                        data-trait-icon={trait.icon.src}
                        data-trait-tiers={JSON.stringify(trait.tiers)}
                        data-trait-tier-index={tierIndex}
                        data-active-count={count}
                        data-trait-champions={JSON.stringify(trait.champions)}
                        data-all-champions={JSON.stringify(champions)}
                    >
                        <div class="flex items-center gap-2">
                            <div class="relative flex-shrink-0">
                                <Image
                                    src={trait.icon}
                                    alt={trait.name}
                                    width={40}
                                    height={40}
                                    class="w-10 h-10 rounded-md trait-icon-white"
                                />
                                <span class="absolute -bottom-1 -right-1 bg-slate-900 border-2 border-current rounded-full w-5 h-5 flex items-center justify-center text-xs font-bold">
                                    {count}
                                </span>
                            </div>
                            <div class="flex-1 min-w-0">
                                <p class="font-semibold text-white text-sm truncate">
                                    {trait.name}
                                </p>
                                <p class="text-xs text-slate-300 opacity-80">
                                    {trait.type === "origin"
                                        ? "Origin"
                                        : trait.type === "class"
                                          ? "Class"
                                          : "Unique"}
                                </p>
                            </div>
                        </div>
                    </div>
                ))}
            </div>
        )
    }
</div>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const traitCards = document.querySelectorAll(".trait-card");
        let currentTooltip: HTMLDivElement | null = null;
        let updateInterval: number | null = null;
        let removeTimeout: number | null = null;

        const createTooltip = (card: HTMLElement): HTMLDivElement => {
            const tooltip = document.createElement("div");
            tooltip.className = "trait-tooltip-custom";

            // Obtener datos del trait
            const name = card.dataset.traitName || "";
            const description = card.dataset.traitDescription || "";
            const iconSrc = card.dataset.traitIcon || "";
            const tiers = JSON.parse(card.dataset.traitTiers || "[]");
            const tierIndex = parseInt(card.dataset.traitTierIndex || "0");
            const activeCount = parseInt(card.dataset.activeCount || "0");

            // Crear HTML del tooltip simplificado
            tooltip.innerHTML = `
        <div class="tooltip-inner-custom">
          <div class="tooltip-header-simple">
            <img src="${iconSrc}" alt="${name}" class="trait-icon-simple">
            <div>
              <h4 class="trait-name-simple">${name}</h4>
              <span class="trait-count-simple">${activeCount} activo${activeCount !== 1 ? "s" : ""}</span>
            </div>
          </div>
          <p class="trait-description-simple">${description}</p>
          <div class="trait-tiers-simple">
            ${tiers
                .map(
                    (tier: any, idx: number) => `
              <div class="tier-item-simple ${idx === tierIndex ? "tier-active-simple" : ""}">
                <span class="tier-count-badge">${tier.count}</span>
                <span class="tier-effect-text">${tier.effect}</span>
              </div>
            `,
                )
                .join("")}
          </div>
        </div>
        <div class="tooltip-arrow-custom"></div>
      `;

            return tooltip;
        };

        const positionTooltip = (
            tooltip: HTMLDivElement,
            card: HTMLElement,
        ) => {
            const cardRect = card.getBoundingClientRect();
            const tooltipRect = tooltip.getBoundingClientRect();

            // Centrar horizontalmente respecto al card
            let left =
                cardRect.left + cardRect.width / 2 - tooltipRect.width / 2;

            // Ajustar si se sale de la pantalla
            const margin = 10;
            if (left < margin) left = margin;
            if (left + tooltipRect.width > window.innerWidth - margin) {
                left = window.innerWidth - tooltipRect.width - margin;
            }

            // Posicionar debajo del card
            const top = cardRect.bottom + 8;

            tooltip.style.left = `${left}px`;
            tooltip.style.top = `${top}px`;

            // Posicionar la flecha
            const arrow = tooltip.querySelector(
                ".tooltip-arrow-custom",
            ) as HTMLElement;
            if (arrow) {
                const arrowLeft = cardRect.left + cardRect.width / 2 - left - 6;
                arrow.style.left = `${arrowLeft}px`;
            }
        };

        traitCards.forEach((card) => {
            card.addEventListener("mouseenter", () => {
                // Cancelar cualquier timeout de eliminación pendiente
                if (removeTimeout) {
                    clearTimeout(removeTimeout);
                    removeTimeout = null;
                }

                // Limpiar tooltip anterior inmediatamente
                if (currentTooltip) {
                    currentTooltip.remove();
                }
                if (updateInterval) {
                    clearInterval(updateInterval);
                }

                // Crear nuevo tooltip
                currentTooltip = createTooltip(card as HTMLElement);

                // Agregar al body con opacity 0
                currentTooltip.style.opacity = "0";
                document.body.appendChild(currentTooltip);

                // Posicionar después de que se agregue al DOM
                requestAnimationFrame(() => {
                    if (currentTooltip) {
                        positionTooltip(currentTooltip, card as HTMLElement);

                        // Hacer visible en el siguiente frame
                        requestAnimationFrame(() => {
                            if (currentTooltip) {
                                currentTooltip.style.opacity = "1";
                            }
                        });

                        // Actualizar posición continuamente
                        updateInterval = window.setInterval(() => {
                            if (currentTooltip) {
                                positionTooltip(
                                    currentTooltip,
                                    card as HTMLElement,
                                );
                            }
                        }, 16);
                    }
                });
            });

            card.addEventListener("mouseleave", () => {
                if (currentTooltip) {
                    const tooltipToRemove = currentTooltip;
                    tooltipToRemove.style.opacity = "0";

                    // Guardar el timeout para poder cancelarlo
                    removeTimeout = window.setTimeout(() => {
                        tooltipToRemove.remove();
                        if (currentTooltip === tooltipToRemove) {
                            currentTooltip = null;
                        }
                        removeTimeout = null;
                    }, 150);
                }
                if (updateInterval) {
                    clearInterval(updateInterval);
                    updateInterval = null;
                }
            });
        });
    });
</script>

<style>
    .trait-icon-white {
        filter: brightness(0) invert(1);
    }

    .trait-card {
        backdrop-filter: blur(8px);
        transition: all var(--transition-base);
        cursor: pointer;
    }

    .trait-card:hover {
        transform: scale(1.05);
        background-color: rgb(30 41 59);
        border-color: rgba(164, 107, 255, 0.5);
        box-shadow:
            0 10px 15px -3px rgba(164, 107, 255, 0.3),
            0 4px 6px -2px rgba(164, 107, 255, 0.3);
        z-index: 10;
    }

    /* Estilos globales para tooltips (se agregan al body) */
    :global(.trait-tooltip-custom) {
        position: fixed;
        z-index: var(--z-tooltip);
        pointer-events: none;
        transition: opacity var(--transition-fast) ease;
    }

    :global(.tooltip-inner-custom) {
        min-width: 200px;
        max-width: 280px;
        background: rgba(15, 23, 42, 0.98);
        border: 2px solid rgb(var(--color-primary));
        border-radius: var(--radius-lg);
        padding: var(--spacing-md);
        box-shadow:
            0 8px 32px rgba(0, 0, 0, 0.8),
            inset 0 1px 0 rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
    }

    :global(.tooltip-header-simple) {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin-bottom: 0.75rem;
    }

    :global(.trait-icon-simple) {
        width: 2.5rem;
        height: 2.5rem;
        filter: brightness(0) invert(1);
        border-radius: var(--radius-md);
        flex-shrink: 0;
    }

    :global(.trait-name-simple) {
        font-size: 0.875rem;
        font-weight: 700;
        color: white;
        margin: 0;
        line-height: 1.2;
    }

    :global(.trait-count-simple) {
        font-size: 0.75rem;
        color: rgb(var(--color-primary));
        font-weight: 600;
    }

    :global(.trait-description-simple) {
        color: rgb(203 213 225);
        font-size: 0.75rem;
        margin: 0 0 0.75rem 0;
        line-height: 1.4;
    }

    :global(.trait-tiers-simple) {
        display: flex;
        flex-direction: column;
        gap: 0.375rem;
    }

    :global(.tier-item-simple) {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.375rem 0.5rem;
        border-radius: var(--radius-sm);
        background: rgba(71, 85, 105, 0.2);
        transition: all var(--transition-fast);
    }

    :global(.tier-item-simple.tier-active-simple) {
        background: linear-gradient(
            135deg,
            rgba(234, 179, 8, 0.3),
            rgba(202, 138, 4, 0.25)
        );
        border: 1px solid rgba(234, 179, 8, 0.6);
        box-shadow: 0 0 12px rgba(234, 179, 8, 0.25);
    }

    :global(.tier-count-badge) {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 1.5rem;
        height: 1.5rem;
        padding: 0 0.375rem;
        background: rgba(148, 163, 184, 0.2);
        border-radius: var(--radius-sm);
        font-size: 0.75rem;
        font-weight: 700;
        color: rgb(203 213 225);
    }

    :global(.tier-active-simple .tier-count-badge) {
        background: rgba(234, 179, 8, 0.3);
        color: rgb(250, 204, 21);
    }

    :global(.tier-effect-text) {
        flex: 1;
        font-size: 0.75rem;
        color: rgb(226 232 240);
        line-height: 1.3;
    }

    :global(.tier-active-simple .tier-effect-text) {
        color: rgb(254 240 138);
        font-weight: 500;
    }

    :global(.tooltip-arrow-custom) {
        position: absolute;
        top: -6px;
        width: 12px;
        height: 12px;
        background: linear-gradient(
            135deg,
            rgba(15, 23, 42, 0.98),
            rgba(30, 41, 59, 0.98)
        );
        border-left: 2px solid rgba(148, 163, 184, 0.5);
        border-top: 2px solid rgba(148, 163, 184, 0.5);
        transform: rotate(45deg);
        z-index: -1;
    }
</style>
