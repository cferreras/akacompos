---
import {
    calculateActiveTraits,
    type Trait,
    type TraitTier,
    type ActiveTrait,
} from "../utils/traits";

import { getChampionImageMeta, resolveChampionName } from "../utils/assets";

import Tooltip from "./ui/Tooltip.astro";

interface Props {
    champions: string[];
}

const { champions } = Astro.props;

const activeTraits = calculateActiveTraits(champions);
---

<div class="traits-display">
    {
        activeTraits.length === 0 ? (
            <div class="p-4 bg-surface-dark/30 backdrop-blur-sm rounded-lg border border-white/5 text-center">
                <p class="text-slate-400 text-sm">
                    No se encontraron traits activos. Champions:{" "}
                    {champions.length > 0 ? champions.join(", ") : "Ninguno"}
                </p>
            </div>
        ) : (
            <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-3">
                {activeTraits.map(({ trait, count, activeTier, tierIndex }) => (
                    <Tooltip
                        position="bottom"
                        className="w-full"
                        triggerClassName="w-full"
                        tooltipClassName="w-[280px] bg-surface-dark/95 backdrop-blur-xl border-white/10 shadow-2xl"
                    >
                        <div slot="content" class="flex flex-col gap-3 p-1">
                            <div class="flex items-center gap-3 border-b border-white/5 pb-3">
                                <div
                                    class={`p-1 rounded-md ${activeTier ? "bg-primary/20" : "bg-slate-800"}`}
                                >
                                    <img
                                        src={trait.icon.src || trait.icon}
                                        alt={trait.name}
                                        width={40}
                                        height={40}
                                        class="w-8 h-8 brightness-0 invert"
                                    />
                                </div>
                                <div>
                                    <h4 class="font-bold text-white text-sm leading-tight">
                                        {trait.name}
                                    </h4>
                                    <span class="text-xs font-semibold text-primary">
                                        {count} activo{count !== 1 ? "s" : ""}
                                    </span>
                                </div>
                            </div>
                            <p class="text-xs text-slate-300 leading-relaxed">
                                {trait.description}
                            </p>
                            <div class="flex flex-col gap-1.5 bg-black/20 rounded-lg p-2">
                                {trait.tiers.map((tier, idx) => (
                                    <div
                                        class={`flex items-center gap-2 p-1.5 rounded transition-colors ${idx === tierIndex ? "bg-primary/20 border border-primary/30" : "bg-transparent"}`}
                                    >
                                        <span
                                            class={`inline-flex items-center justify-center min-w-[1.5rem] h-6 px-1.5 rounded text-xs font-bold ${idx === tierIndex ? "bg-primary text-white shadow-lg shadow-primary/20" : "bg-slate-700/40 text-slate-400"}`}
                                        >
                                            {tier.count}
                                        </span>
                                        <span
                                            class={`text-xs flex-1 leading-tight ${idx === tierIndex ? "text-white font-medium" : "text-slate-400"}`}
                                        >
                                            {tier.effect}
                                        </span>
                                    </div>
                                ))}
                            </div>

                            <div class="pt-2 mt-1 border-t border-white/5">
                                <p class="text-[10px] uppercase tracking-wider text-slate-500 font-bold mb-2">
                                    Campeones
                                </p>
                                <div class="flex flex-wrap gap-1.5">
                                    {trait.champions.map((champName) => {
                                        // Resolve both names to ensure correct matching
                                        const resolvedChampName =
                                            resolveChampionName(champName);
                                        const isActive = champions.some(
                                            (c) =>
                                                resolveChampionName(c) ===
                                                resolvedChampName,
                                        );

                                        const champImage =
                                            getChampionImageMeta(champName);
                                        if (!champImage) return null;

                                        return (
                                            <div
                                                class={`relative transition-all duration-200 ${isActive ? "opacity-100 scale-105" : "opacity-30 grayscale hover:opacity-70 hover:grayscale-0"}`}
                                            >
                                                <img
                                                    src={
                                                        champImage.src ||
                                                        champImage
                                                    }
                                                    alt={champName}
                                                    width={32}
                                                    height={32}
                                                    class={`w-8 h-8 rounded border-2 ${isActive ? "border-primary shadow-lg shadow-primary/20" : "border-slate-600"}`}
                                                    title={champName}
                                                />
                                            </div>
                                        );
                                    })}
                                </div>
                            </div>
                        </div>

                        <div
                            class={`trait-card relative rounded-xl p-3 border flex items-center gap-3 transition-all duration-300 cursor-pointer w-full group overflow-hidden
                                ${
                                    activeTier
                                        ? "bg-surface-dark/60 backdrop-blur-md border-primary/40 hover:border-primary hover:shadow-lg hover:shadow-primary/10"
                                        : "bg-surface-dark/30 backdrop-blur-sm border-white/5 opacity-70 hover:opacity-100 hover:bg-surface-dark/50 hover:border-white/20"
                                }
                            `}
                        >
                            {activeTier && (
                                <div class="absolute inset-0 bg-gradient-to-br from-primary/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500" />
                            )}

                            <div class="relative flex-shrink-0">
                                <div
                                    class={`w-10 h-10 rounded-lg flex items-center justify-center transition-colors ${activeTier ? "bg-primary/20" : "bg-slate-800/50"}`}
                                >
                                    <img
                                        src={trait.icon.src || trait.icon}
                                        alt={trait.name}
                                        width={24}
                                        height={24}
                                        class={`w-6 h-6 brightness-0 invert transition-transform group-hover:scale-110 duration-300 ${!activeTier && "opacity-60"}`}
                                    />
                                </div>
                                <span
                                    class={`absolute -bottom-1 -right-1 border-2 border-surface-dark rounded-full w-5 h-5 flex items-center justify-center text-[10px] font-bold shadow-sm
                                    ${
                                        activeTier
                                            ? "bg-primary text-white"
                                            : "bg-slate-700 text-slate-400"
                                    }
                                `}
                                >
                                    {count}
                                </span>
                            </div>
                            <div class="flex-1 min-w-0 relative z-10">
                                <p
                                    class={`font-bold text-sm truncate transition-colors ${activeTier ? "text-white" : "text-slate-300 group-hover:text-white"}`}
                                >
                                    {trait.name}
                                </p>
                                <p class="text-[10px] text-slate-400 uppercase tracking-wider font-medium">
                                    {trait.type === "origin"
                                        ? "Origin"
                                        : trait.type === "class"
                                          ? "Class"
                                          : "Unique"}
                                </p>
                            </div>
                        </div>
                    </Tooltip>
                ))}
            </div>
        )
    }
</div>

<style>
    /* Custom styles removed as they are replaced by Tailwind and Tooltip component */
</style>
