---
import {
    calculateActiveTraits,
    type Trait,
    type TraitTier,
    type ActiveTrait,
} from "../utils/traits";
import { Image } from "astro:assets";
import { getChampionImageMeta } from "../utils/assets";

import Tooltip from "./ui/Tooltip.astro";

interface Props {
    champions: string[];
}

const { champions } = Astro.props;

const activeTraits = calculateActiveTraits(champions);
---

<div class="traits-display">
    {
        activeTraits.length === 0 ? (
            <div class="p-4 bg-slate-800/20 rounded-lg border border-slate-700">
                <p class="text-slate-400 text-sm">
                    No se encontraron traits activos. Champions:{" "}
                    {champions.length > 0 ? champions.join(", ") : "Ninguno"}
                </p>
            </div>
        ) : (
            <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-3">
                {activeTraits.map(({ trait, count, activeTier, tierIndex }) => (
                    <Tooltip position="bottom" className="w-full" tooltipClassName="min-w-[240px] max-w-[280px]">
                        <div slot="content" class="flex flex-col gap-3">
                             <div class="flex items-center gap-3">
                                <Image
                                    src={trait.icon}
                                    alt={trait.name}
                                    width={40}
                                    height={40}
                                    class="w-10 h-10 rounded-md brightness-0 invert"
                                />
                                <div>
                                    <h4 class="font-bold text-white text-sm leading-tight">{trait.name}</h4>
                                    <span class="text-xs font-semibold text-primary">
                                        {count} activo{count !== 1 ? "s" : ""}
                                    </span>
                                </div>
                            </div>
                            <p class="text-xs text-slate-300 leading-relaxed">{trait.description}</p>
                            <div class="flex flex-col gap-1.5">
                                {trait.tiers.map((tier, idx) => (
                                    <div class={`flex items-center gap-2 p-1.5 rounded ${idx === tierIndex ? "bg-amber-500/20 border border-amber-500/50 shadow-[0_0_12px_rgba(234,179,8,0.25)]" : "bg-slate-700/20"}`}>
                                        <span class={`inline-flex items-center justify-center min-w-[1.5rem] h-6 px-1.5 rounded text-xs font-bold ${idx === tierIndex ? "bg-amber-500/30 text-amber-300" : "bg-slate-700/40 text-slate-300"}`}>
                                            {tier.count}
                                        </span>
                                        <span class={`text-xs flex-1 leading-tight ${idx === tierIndex ? "text-amber-100 font-medium" : "text-slate-300"}`}>
                                            {tier.effect}
                                        </span>
                                    </div>
                                ))}
                            </div>
                        </div>

                        <div
                            class="trait-card relative rounded-lg p-3 bg-slate-800/50 border-2 border-slate-800 flex items-center gap-2 hover:bg-slate-800 hover:border-primary/50 hover:shadow-lg hover:shadow-primary/20 hover:scale-105 transition-all duration-200 cursor-pointer w-full"
                        >
                            <div class="relative flex-shrink-0">
                                <Image
                                    src={trait.icon}
                                    alt={trait.name}
                                    width={40}
                                    height={40}
                                    class="w-10 h-10 rounded-md brightness-0 invert"
                                />
                                <span class="absolute -bottom-1 -right-1 bg-slate-900 border-2 border-current rounded-full w-5 h-5 flex items-center justify-center text-xs font-bold text-white">
                                    {count}
                                </span>
                            </div>
                            <div class="flex-1 min-w-0">
                                <p class="font-semibold text-white text-sm truncate">
                                    {trait.name}
                                </p>
                                <p class="text-xs text-slate-300 opacity-80">
                                    {trait.type === "origin"
                                        ? "Origin"
                                        : trait.type === "class"
                                          ? "Class"
                                          : "Unique"}
                                </p>
                            </div>
                        </div>
                    </Tooltip>
                ))}
            </div>
        )
    }
</div>

<style>
    /* Custom styles removed as they are replaced by Tailwind and Tooltip component */
</style>
