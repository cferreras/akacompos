---
import { calculateActiveTraits } from "../utils/traits";
import { getChampionImageMeta, resolveChampionName } from "../utils/assets";
import { Image } from "astro:assets";

interface Props {
    champions: string[];
}

const { champions } = Astro.props;

const getTraitColor = (tierIndex: number, totalTiers: number) => {
    if (totalTiers === 1) return "text-red-400";
    if (totalTiers === 2) {
        return tierIndex === 0 ? "text-amber-600" : "text-yellow-400";
    }
    if (tierIndex === 0) return "text-amber-600";
    if (tierIndex === 1) return "text-slate-300";
    if (tierIndex === 2) return "text-yellow-400";
    return "text-fuchsia-400";
};

const getTraitBg = (tierIndex: number, totalTiers: number) => {
    if (totalTiers === 1) return "bg-red-400/20";
    if (totalTiers === 2) {
        return tierIndex === 0 ? "bg-amber-600/20" : "bg-yellow-400/20";
    }
    if (tierIndex === 0) return "bg-amber-600/20";
    if (tierIndex === 1) return "bg-slate-300/20";
    if (tierIndex === 2) return "bg-yellow-400/20";
    return "bg-fuchsia-400/20";
};

const activeTraits = calculateActiveTraits(champions);
---

<div class="traits">
    {
        activeTraits.length === 0 ? (
            <div class="p-3 bg-slate-800/30 rounded-lg text-center">
                <p class="text-slate-400 text-xs">No se encontraron traits activos</p>
            </div>
        ) : (
            <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-2">
                {activeTraits.map(({ trait, count, activeTier, tierIndex }) => (
                    <div class={`group p-2 rounded-lg flex items-center gap-2 ${activeTier ? "bg-slate-800/40" : "bg-slate-800/20 opacity-60"}`}>
                        <div class="relative flex-shrink-0">
                            <div class={`w-8 h-8 rounded-lg flex items-center justify-center ${activeTier ? getTraitBg(tierIndex, trait.tiers.length) : "bg-slate-700/50"}`}>
                                <div
                                    class={`w-5 h-5 ${activeTier ? getTraitColor(tierIndex, trait.tiers.length) : "text-slate-500"}`}
                                    style={{
                                        maskImage: `url(${trait.icon.src})`,
                                        maskSize: "contain",
                                        maskRepeat: "no-repeat",
                                        maskPosition: "center",
                                        WebkitMaskImage: `url(${trait.icon.src})`,
                                        WebkitMaskSize: "contain",
                                        WebkitMaskRepeat: "no-repeat",
                                        WebkitMaskPosition: "center",
                                        backgroundColor: 'currentColor'
                                    }}
                                />
                            </div>
                            <span class={`absolute -bottom-1 -right-1 w-4 h-4 flex items-center justify-center text-[10px] font-semibold rounded-full border border-slate-900 ${activeTier ? "bg-primary text-white" : "bg-slate-700 text-slate-400"}`}>
                                {count}
                            </span>
                        </div>
                        <div class="flex-1 min-w-0">
                            <p class={`font-medium text-sm truncate ${activeTier ? "text-white" : "text-slate-400"}`}>
                                {trait.name}
                            </p>
                            <p class="text-[10px] text-slate-500 uppercase">
                                {trait.type}
                            </p>
                        </div>
                    </div>
                ))}
            </div>
        )
    }
</div>

<style>
    .traits {
        width: 100%;
    }
</style>
