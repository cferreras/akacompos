---
import { getAugment } from "../utils/augments.ts";
import Tooltip from "./ui/Tooltip.astro";
import { Image } from "astro:assets";

interface Props {
    augments: Array<
        | string
        | {
              name: string;
              description: string;
              icon?: string;
          }
    >;
}

const { augments } = Astro.props;

const augmentsWithImages =
    augments
        ?.map((aug) => {
            if (typeof aug === "string") {
                const foundAugment = getAugment(aug);
                if (foundAugment) {
                    return {
                        name: foundAugment.name,
                        description: foundAugment.description,
                        image: foundAugment.image,
                        tier: foundAugment.tier,
                        hasImage: true,
                    };
                }
                console.warn(`Augment not found: ${aug}`);
                return null;
            }

            if (aug && aug.name) {
                const foundAugment = getAugment(aug.name);
                if (foundAugment) {
                    return {
                        name: foundAugment.name,
                        description: foundAugment.description,
                        image: foundAugment.image,
                        tier: foundAugment.tier,
                        hasImage: true,
                    };
                }
                return {
                    ...aug,
                    image: undefined,
                    tier: "gold",
                    hasImage: false,
                };
            }
            return null;
        })
        .filter((aug): aug is NonNullable<typeof aug> => aug !== null) || [];

const getTierBorder = (tier: string) => {
    switch (tier) {
        case "silver": return "border-slate-400";
        case "gold": return "border-amber-400";
        case "prismatic": return "border-purple-400";
        default: return "border-slate-600";
    }
};

const getTierBg = (tier: string) => {
    switch (tier) {
        case "silver": return "bg-slate-400/10";
        case "gold": return "bg-amber-400/10";
        case "prismatic": return "bg-purple-400/10";
        default: return "bg-slate-800";
    }
};
---

<div class="grid grid-cols-3 gap-2">
    {
        augmentsWithImages.map((augment) => (
            <Tooltip
                position="top"
                className="w-full"
                tooltipClassName="w-[240px]"
            >
                <div slot="content" class="flex flex-col gap-2 p-2">
                    <div class="flex items-center gap-2 border-b border-white/10 pb-2">
                        <div class={`w-10 h-10 rounded-lg overflow-hidden p-1 bg-slate-900 border ${getTierBorder(augment.tier)}`}>
                            {augment.hasImage ? (
                                <Image
                                    src={augment.image}
                                    alt={augment.name}
                                    class="w-full h-full object-contain"
                                    width={40}
                                    height={40}
                                    loading="eager"
                                    decoding="async"
                                    format="webp"
                                    quality={80}
                                />
                            ) : (
                                <div class="w-full h-full bg-slate-800 flex items-center justify-center">
                                    <span class="text-slate-400 text-[8px] font-bold text-center uppercase">
                                        {augment.name.substring(0, 3)}
                                    </span>
                                </div>
                            )}
                        </div>
                        <div>
                            <h4 class="font-semibold text-white text-sm">
                                {augment.name}
                            </h4>
                            <span class={`text-[10px] uppercase font-medium ${getTierBorder(augment.tier).replace('border-', 'text-')}`}>
                                {augment.tier}
                            </span>
                        </div>
                    </div>
                    <p class="text-xs text-slate-300 leading-relaxed">
                        {augment.description}
                    </p>
                </div>

                <div class={`group cursor-pointer rounded-lg p-2 border border-white/5 hover:border-white/20 hover:bg-slate-800/50 transition-colors ${getTierBg(augment.tier)}`}>
                    <div class={`aspect-square rounded-lg overflow-hidden mb-1.5 border ${getTierBorder(augment.tier)} bg-slate-950`}>
                        {augment.hasImage ? (
                            <Image
                                src={augment.image}
                                alt={augment.name}
                                class="w-full h-full object-contain"
                                width={80}
                                height={80}
                                loading="lazy"
                                decoding="async"
                                format="webp"
                                quality={80}
                            />
                        ) : (
                            <div class="w-full h-full bg-slate-800 flex items-center justify-center">
                                <span class="text-slate-500 text-[8px] font-bold text-center uppercase">
                                    {augment.name}
                                </span>
                            </div>
                        )}
                    </div>
                    <p class="text-[10px] font-medium text-slate-300 text-center line-clamp-2 uppercase">
                        {augment.name}
                    </p>
                </div>
            </Tooltip>
        ))
    }
</div>
