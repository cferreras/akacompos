---
import { getAugment } from "../utils/augments.ts";
import { Image } from "astro:assets";

interface Props {
    augments: Array<
        | string
        | {
              name: string;
              description: string;
              icon?: string;
          }
    >;
}

const { augments } = Astro.props;

const augmentsWithImages =
    augments
        ?.map((aug) => {
            if (typeof aug === "string") {
                const foundAugment = getAugment(aug);
                if (foundAugment) {
                    return {
                        name: foundAugment.name,
                        description: foundAugment.description,
                        image: foundAugment.image,
                        tier: foundAugment.tier,
                        hasImage: true,
                    };
                }
                return null;
            }

            if (aug && aug.name) {
                const foundAugment = getAugment(aug.name);
                if (foundAugment) {
                    return {
                        name: foundAugment.name,
                        description: foundAugment.description,
                        image: foundAugment.image,
                        tier: foundAugment.tier,
                        hasImage: true,
                    };
                }
                return {
                    ...aug,
                    image: undefined,
                    tier: "gold",
                    hasImage: false,
                };
            }
            return null;
        })
        .filter((aug): aug is NonNullable<typeof aug> => aug !== null) || [];

const getTierColor = (tier: string) => {
    switch (tier) {
        case "silver":
            return "text-slate-400";
        case "gold":
            return "text-amber-400";
        case "prismatic":
            return "text-purple-400";
        default:
            return "text-slate-500";
    }
};

const getTierBg = (tier: string) => {
    switch (tier) {
        case "silver":
            return "bg-slate-400/20";
        case "gold":
            return "bg-amber-400/20";
        case "prismatic":
            return "bg-purple-400/20";
        default:
            return "bg-slate-700";
    }
};
---

<div class="space-y-2">
    {
        augmentsWithImages.map((augment) => (
            <div class="group flex items-center gap-3 p-2 rounded-lg bg-slate-800/30 hover:bg-slate-800/60 transition-colors">
                <div
                    class={`w-10 h-10 rounded-lg overflow-hidden flex-shrink-0 ${getTierBg(augment.tier)}`}
                >
                    {augment.hasImage ? (
                        <Image
                            src={augment.image}
                            alt={augment.name}
                            class="w-full h-full object-contain"
                            width={40}
                            height={40}
                            loading="lazy"
                            decoding="async"
                            format="webp"
                            quality={80}
                        />
                    ) : (
                        <div class="w-full h-full flex items-center justify-center">
                            <span class="text-xs font-bold uppercase text-slate-400">
                                {augment.name.substring(0, 2)}
                            </span>
                        </div>
                    )}
                </div>

                <div class="flex-1 min-w-0">
                    <div class="flex items-center gap-2">
                        <h4 class="text-sm font-medium text-white truncate">
                            {augment.name}
                        </h4>
                        <span
                            class={`text-[10px] font-semibold uppercase ${getTierColor(augment.tier)}`}
                        >
                            {augment.tier}
                        </span>
                    </div>
                    <p class="text-xs text-slate-400 line-clamp-2 mt-0.5">
                        {augment.description}
                    </p>
                </div>
            </div>
        ))
    }
</div>
