---
import Container from "./ui/Container.astro";

// Get version from build-time environment variable injected by Vite plugin
const version = import.meta.env.GIT_COMMIT_HASH || "unknown";
---

<footer
    class="bg-background-darker border-t border-slate-800/50 mt-auto relative overflow-hidden"
>
    <!-- Decorative gradient -->
    <div
        class="absolute inset-0 bg-gradient-to-b from-transparent via-primary/5 to-transparent pointer-events-none"
    >
    </div>

    <Container maxWidth="xl" paddingY="lg" paddingX="md">
        <!-- Main Footer Content -->
        <div
            class="relative grid grid-cols-1 md:grid-cols-3 gap-12 pb-12 border-b border-slate-800/50"
        >
            <!-- Brand Section -->
            <div class="space-y-6">
                <div class="flex items-center gap-2">
                    <span
                        class="text-primary font-black text-2xl bg-gradient-to-r from-primary to-purple-400 bg-clip-text text-transparent"
                    >
                        AKACompos
                    </span>
                </div>
                <p class="text-sm text-slate-400 leading-relaxed max-w-sm">
                    Las mejores composiciones de TFT por AKAWonder. Actualizadas
                    constantemente para el meta actual.
                </p>

                <!-- Social Link -->
                <a
                    href="https://www.twitch.tv/akawonder"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-3 px-4 py-3 rounded-xl glass-card glass-card-hover text-sm text-slate-300 transition-all group max-w-fit"
                >
                    <div
                        class="w-10 h-10 rounded-lg bg-gradient-primary flex items-center justify-center shadow-glow-sm group-hover:shadow-glow-md transition-all"
                    >
                        <i class="fa-brands fa-twitch text-lg text-white"></i>
                    </div>
                    <div class="flex-1">
                        <div class="font-semibold text-white">Twitch</div>
                        <div class="text-xs text-slate-400">@akawonder</div>
                    </div>
                    <i
                        class="fa-solid fa-arrow-up-right-from-square text-xs opacity-0 group-hover:opacity-100 transition-opacity"
                    ></i>
                </a>
            </div>

            <!-- Quick Links -->
            <div>
                <h3
                    class="text-white font-bold mb-6 flex items-center gap-2 text-lg"
                >
                    <i class="fa-solid fa-link text-primary text-sm"></i>
                    Enlaces Rápidos
                </h3>
                <ul class="space-y-3">
                    <li>
                        <a
                            href="/"
                            class="text-sm text-slate-400 hover:text-primary transition-colors flex items-center gap-3 group"
                        >
                            <i
                                class="fa-solid fa-home text-xs w-5 text-center group-hover:scale-110 transition-transform"
                            ></i>
                            <span>Inicio</span>
                        </a>
                    </li>
                    <li>
                        <a
                            href="/compositions"
                            class="text-sm text-slate-400 hover:text-primary transition-colors flex items-center gap-3 group"
                        >
                            <i
                                class="fa-solid fa-chess text-xs w-5 text-center group-hover:scale-110 transition-transform"
                            ></i>
                            <span>Composiciones</span>
                        </a>
                    </li>
                </ul>
            </div>

            <!-- Info Section -->
            <div>
                <h3
                    class="text-white font-bold mb-6 flex items-center gap-2 text-lg"
                >
                    <i class="fa-solid fa-circle-info text-primary text-sm"></i>
                    Información
                </h3>
                <div class="space-y-4">
                    <p class="text-sm text-slate-400 leading-relaxed">
                        Proyecto desarrollado con <i
                            class="fa-solid fa-heart text-red-500 text-xs animate-pulse"
                        ></i> por
                        <span class="text-primary font-medium"
                            >Carlos Ferreras</span
                        > y
                        <span class="text-primary font-medium">Jota</span>
                    </p>

                    <!-- Version Badge -->
                    <a
                        href={`https://github.com/cferreras/akacompos/commit/${version}`}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-2 px-3 py-2 rounded-lg glass-card hover:glass-card-hover transition-all text-xs font-mono text-slate-400 hover:text-primary group"
                    >
                        <i
                            class="fa-solid fa-code-branch text-[10px] group-hover:rotate-12 transition-transform"
                        ></i>
                        <span>v{version}</span>
                    </a>
                </div>
            </div>
        </div>

        <!-- Bottom Footer -->
        <div
            class="relative pt-8 flex flex-col md:flex-row items-center justify-center gap-2 text-sm text-slate-500"
        >
            <span>© {new Date().getFullYear()} AKACompos</span>
            <span class="hidden md:inline text-slate-700">•</span>
            <span>Todos los derechos reservados</span>
        </div>
    </Container>
</footer>

<style>
    /* Smooth animations */
    footer a {
        transition: all var(--transition-base);
    }

    /* Icon hover effects */
    footer i {
        transition: transform var(--transition-base);
    }

    /* Gradient text animation */
    @media (prefers-reduced-motion: no-preference) {
        .bg-gradient-to-r {
            background-size: 200% auto;
            animation: shimmer 3s linear infinite;
        }
    }

    @keyframes shimmer {
        0% {
            background-position: 0% center;
        }
        100% {
            background-position: 200% center;
        }
    }
</style>
