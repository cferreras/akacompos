---
import Container from "./ui/Container.astro";
import { getLatestCommit } from "../utils/github";

const version = await getLatestCommit();
const year = new Date().getFullYear();
---

<footer class="relative mt-auto">
    <!-- Top accent line -->
    <div class="h-px bg-gradient-to-r from-transparent via-amber-500/20 to-transparent"></div>

    <div class="bg-[rgb(10,10,12)]">
        <Container maxWidth="xl" paddingX="md">
            <!-- Main footer content -->
            <div class="py-12 md:py-16">
                <div class="grid grid-cols-1 md:grid-cols-12 gap-10 md:gap-8">
                    <!-- Brand — wider column -->
                    <div class="md:col-span-5 space-y-4">
                        <a href="/" class="inline-flex items-center gap-2.5 group">
                            <div class="w-7 h-7 rounded-md bg-amber-500/10 border border-amber-500/20 flex items-center justify-center">
                                <span class="font-display text-amber-400 text-xs font-bold">A</span>
                            </div>
                            <span class="font-display text-base tracking-tight">
                                <span class="text-[rgb(245,245,245)] font-semibold">AKA</span><span class="text-amber-400 font-semibold">COMPOS</span>
                            </span>
                        </a>
                        <p class="text-sm text-[rgb(82,82,91)] leading-relaxed max-w-xs">
                            Composiciones de TFT seleccionadas por AKAWonder.
                            Estrategias actualizadas para cada parche.
                        </p>
                    </div>

                    <!-- Nav links -->
                    <div class="md:col-span-3">
                        <h3 class="text-[11px] font-medium uppercase tracking-[0.15em] text-[rgb(82,82,91)] mb-4">Navegación</h3>
                        <ul class="space-y-2.5">
                            <li>
                                <a href="/" class="text-sm text-[rgb(113,113,122)] hover:text-[rgb(245,245,245)] transition-colors">
                                    Inicio
                                </a>
                            </li>
                            <li>
                                <a href="/compositions" class="text-sm text-[rgb(113,113,122)] hover:text-[rgb(245,245,245)] transition-colors">
                                    Composiciones
                                </a>
                            </li>
                        </ul>
                    </div>

                    <!-- Social -->
                    <div class="md:col-span-2">
                        <h3 class="text-[11px] font-medium uppercase tracking-[0.15em] text-[rgb(82,82,91)] mb-4">Social</h3>
                        <ul class="space-y-2.5">
                            <li>
                                <a href="https://www.twitch.tv/akawonder" target="_blank" class="inline-flex items-center gap-2 text-sm text-[rgb(113,113,122)] hover:text-purple-400 transition-colors">
                                    <i class="fa-brands fa-twitch text-xs w-4"></i>
                                    Twitch
                                </a>
                            </li>
                            <li>
                                <a href="https://x.com/aka_wonder" target="_blank" class="inline-flex items-center gap-2 text-sm text-[rgb(113,113,122)] hover:text-[rgb(245,245,245)] transition-colors">
                                    <i class="fa-brands fa-x-twitter text-xs w-4"></i>
                                    X / Twitter
                                </a>
                            </li>
                        </ul>
                    </div>

                    <!-- Info -->
                    <div class="md:col-span-2">
                        <h3 class="text-[11px] font-medium uppercase tracking-[0.15em] text-[rgb(82,82,91)] mb-4">Info</h3>
                        <div class="space-y-2.5 text-sm text-[rgb(113,113,122)]">
                            <p>
                                Hecho por <a href="https://www.carlosferreras.com" target="_blank" class="text-[rgb(163,163,170)] hover:text-amber-400 transition-colors">Carlos Ferreras</a>
                            </p>
                            <a
                                href={`https://github.com/cferreras/akacompos/commit/${version}`}
                                target="_blank"
                                class="inline-flex items-center gap-1.5 text-xs font-mono text-[rgb(52,52,58)] hover:text-amber-400/60 transition-colors"
                            >
                                <i class="fa-solid fa-code-branch text-[10px]"></i>
                                <span>{version}</span>
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Bottom bar -->
            <div class="py-5 border-t border-white/[0.04] flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-[rgb(52,52,58)]">
                <span>&copy; {year} AKACompos</span>
                <div class="flex items-center gap-5">
                    <a href="/privacy" class="hover:text-[rgb(113,113,122)] transition-colors">Privacidad</a>
                    <a href="/terms" class="hover:text-[rgb(113,113,122)] transition-colors">Términos</a>
                </div>
            </div>
        </Container>
    </div>
</footer>
