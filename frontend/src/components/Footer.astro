---
import Container from "./ui/Container.astro";
import { getLatestCommit } from "../utils/github";

const version = await getLatestCommit().catch(() => "v1.0.0");
const year = new Date().getFullYear();
---

<footer class="border-t border-[#292524] bg-[#0c0a09] pt-24 pb-12 mt-20 relative overflow-hidden">
    <!-- Decorative magical glow -->
    <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-[800px] h-[300px] bg-[#d4af37] opacity-[0.03] blur-[150px] rounded-[100%] pointer-events-none"></div>
    <div class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/stardust.png')] opacity-[0.05] pointer-events-none"></div>

    <Container maxWidth="xl" className="relative z-10">
        <div class="flex flex-col items-center text-center max-w-3xl mx-auto mb-20">
            <h2 class="font-serif text-4xl text-[#f5f5f4] mb-6 ornament-line w-full">AKACOMPOS</h2>
            <p class="text-[#a8a29e] font-light leading-relaxed text-lg">
                Forjado en el fuego de la competición. Las estrategias más refinadas y efectivas de Teamfight Tactics, documentadas minuciosamente por el Gran Maestro AKAWonder.
            </p>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-12 border-t border-[#292524] pt-12">
            <div>
                <h3 class="font-serif text-xl text-[#d4af37] mb-6">El Tomo</h3>
                <ul class="space-y-4">
                    <li><a href="/" class="text-sm tracking-wider text-[#a8a29e] hover:text-[#f5f5f4] hover:pl-2 transition-all block">Portada</a></li>
                    <li><a href="/compositions" class="text-sm tracking-wider text-[#a8a29e] hover:text-[#f5f5f4] hover:pl-2 transition-all block">Estrategias</a></li>
                </ul>
            </div>
            <div>
                <h3 class="font-serif text-xl text-[#d4af37] mb-6">La Taberna</h3>
                <ul class="space-y-4">
                    <li><a href="https://www.twitch.tv/akawonder" target="_blank" class="text-sm tracking-wider text-[#a8a29e] hover:text-[#9146FF] hover:pl-2 transition-all flex items-center gap-2">Twitch <i class="fa-solid fa-arrow-up-right-from-square text-[10px]"></i></a></li>
                    <li><a href="https://x.com/aka_wonder" target="_blank" class="text-sm tracking-wider text-[#a8a29e] hover:text-[#f5f5f4] hover:pl-2 transition-all flex items-center gap-2">X / Twitter <i class="fa-solid fa-arrow-up-right-from-square text-[10px]"></i></a></li>
                </ul>
            </div>
            <div>
                <h3 class="font-serif text-xl text-[#d4af37] mb-6">Forja</h3>
                <ul class="space-y-4 text-sm tracking-wider text-[#a8a29e]">
                    <li>Artífice: <a href="https://www.carlosferreras.com" class="text-[#f5f5f4] hover:text-[#d4af37] transition-colors">Carlos Ferreras</a></li>
                    <li>Edición: <span class="font-mono text-xs text-[#d4af37]/70 border border-[#d4af37]/30 px-2 py-1 rounded-sm bg-[#1c1917]">{version}</span></li>
                </ul>
            </div>
            <div>
                <h3 class="font-serif text-xl text-[#d4af37] mb-6">Legado</h3>
                <ul class="space-y-4">
                    <li><a href="/privacy" class="text-sm tracking-wider text-[#a8a29e] hover:text-[#f5f5f4] hover:pl-2 transition-all block">Privacidad</a></li>
                    <li><a href="/terms" class="text-sm tracking-wider text-[#a8a29e] hover:text-[#f5f5f4] hover:pl-2 transition-all block">Términos</a></li>
                </ul>
            </div>
        </div>

        <div class="mt-24 pt-8 border-t border-[#292524]/50 flex flex-col md:flex-row items-center justify-between gap-4">
            <div class="text-[10px] text-[#57534e] tracking-[0.2em] uppercase">
                &copy; {year} AKACOMPOS. TODOS LOS DERECHOS RESERVADOS.
            </div>
            <div class="flex gap-2">
                <div class="w-2 h-2 rounded-full border border-[#d4af37]/50"></div>
                <div class="w-2 h-2 rounded-full border border-[#d4af37]/50"></div>
                <div class="w-2 h-2 rounded-full border border-[#d4af37]/50"></div>
            </div>
        </div>
    </Container>
</footer>
