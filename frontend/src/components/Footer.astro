---
import Container from "./ui/Container.astro";
import { getLatestCommit } from "../utils/github";

const version = await getLatestCommit();
---

<footer class="bg-slate-950 border-t border-white/5 mt-auto">
    <Container maxWidth="xl" paddingY="lg" paddingX="md">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 pb-8 border-b border-white/5">
            <!-- Brand -->
            <div class="space-y-4">
                <a href="/" class="text-white font-bold text-xl tracking-tight">
                    AKA<span class="text-primary">COMPOS</span>
                </a>
                <p class="text-sm text-slate-400 leading-relaxed max-w-xs">
                    Las mejores composiciones de TFT por AKAWonder. 
                    Estrategias actualizadas para dominar el meta.
                </p>
            </div>

            <!-- Links -->
            <div>
                <h3 class="text-white font-semibold mb-4 text-sm">Enlaces</h3>
                <ul class="space-y-2">
                    <li>
                        <a href="/" class="text-sm text-slate-400 hover:text-white transition-colors">
                            Inicio
                        </a>
                    </li>
                    <li>
                        <a href="/compositions" class="text-sm text-slate-400 hover:text-white transition-colors">
                            Composiciones
                        </a>
                    </li>
                    <li>
                        <a href="https://www.twitch.tv/akawonder" target="_blank" class="text-sm text-slate-400 hover:text-white transition-colors">
                            Twitch
                        </a>
                    </li>
                </ul>
            </div>

            <!-- Info -->
            <div>
                <h3 class="text-white font-semibold mb-4 text-sm">Información</h3>
                <div class="space-y-3 text-sm text-slate-400">
                    <p>Desarrollado por <a href="https://www.carlosferreras.com" target="_blank" class="text-slate-300 hover:opacity-70 transition-opacity">Carlos Ferreras</a></p>
                    <a 
                        href={`https://github.com/cferreras/akacompos/commit/${version}`}
                        target="_blank"
                        class="inline-flex items-center gap-2 text-xs font-mono text-slate-500 hover:text-primary transition-colors"
                    >
                        <i class="fa-solid fa-code-branch"></i>
                        <span>{version}</span>
                    </a>
                </div>
            </div>
        </div>

        <!-- Bottom -->
        <div class="pt-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-slate-500">
            <span>© {new Date().getFullYear()} AKACompos</span>
            <div class="flex items-center gap-6">
                <a href="/privacy" class="hover:text-slate-300 transition-colors">Privacidad</a>
                <a href="/terms" class="hover:text-slate-300 transition-colors">Términos</a>
            </div>
        </div>
    </Container>
</footer>
