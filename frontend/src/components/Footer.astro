---
import Container from "./ui/Container.astro";

// Get version from build-time environment variable injected by Vite plugin
const version = import.meta.env.GIT_COMMIT_HASH || "unknown";
---

<footer class="bg-background-darker border-t border-slate-800 mt-auto">
    <Container maxWidth="xl" paddingY="lg" paddingX="md">
        <!-- Main Footer Content -->
        <div
            class="grid grid-cols-1 md:grid-cols-3 gap-8 pb-8 border-b border-slate-800"
        >
            <!-- Brand Section -->
            <div class="space-y-4">
                <div class="flex items-center gap-2">
                    <span
                        class="text-primary font-black text-xl bg-gradient-to-r from-primary to-purple-400 bg-clip-text text-transparent"
                    >
                        AKACompos
                    </span>
                </div>
                <p class="text-sm text-slate-400 leading-relaxed">
                    Las mejores composiciones de TFT por AKAWonder. Actualizadas
                    constantemente para el meta actual.
                </p>
            </div>

            <!-- Quick Links -->
            <div>
                <h3
                    class="text-white font-semibold mb-4 flex items-center gap-2"
                >
                    <i class="fa-solid fa-link text-primary text-sm"></i>
                    Enlaces Rápidos
                </h3>
                <ul class="space-y-2">
                    <li>
                        <a
                            href="/"
                            class="text-sm text-slate-400 hover:text-primary transition-colors flex items-center gap-2"
                        >
                            <i class="fa-solid fa-home text-xs w-4"></i>
                            Inicio
                        </a>
                    </li>
                    <li>
                        <a
                            href="/compositions"
                            class="text-sm text-slate-400 hover:text-primary transition-colors flex items-center gap-2"
                        >
                            <i class="fa-solid fa-chess text-xs w-4"></i>
                            Composiciones
                        </a>
                    </li>
                </ul>
            </div>

            <!-- Social & Contact -->
            <div>
                <h3
                    class="text-white font-semibold mb-4 flex items-center gap-2"
                >
                    <i class="fa-solid fa-share-nodes text-primary text-sm"></i>
                    Síguenos
                </h3>
                <div class="space-y-3">
                    <a
                        href="https://www.twitch.tv/akawonder"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="flex items-center gap-3 text-sm text-slate-400 hover:text-purple-400 transition-all group"
                    >
                        <div
                            class="w-10 h-10 rounded-lg bg-slate-800 flex items-center justify-center group-hover:bg-purple-500/20 transition-all"
                        >
                            <i class="fa-brands fa-twitch text-lg"></i>
                        </div>
                        <div class="flex-1">
                            <div class="font-medium text-white">Twitch</div>
                            <div class="text-xs">@akawonder</div>
                        </div>
                    </a>
                </div>
            </div>
        </div>

        <!-- Bottom Footer -->
        <div
            class="pt-6 flex flex-col md:flex-row items-center justify-between gap-4"
        >
            <div
                class="flex flex-col md:flex-row items-center gap-2 text-sm text-slate-500"
            >
                <span>© {new Date().getFullYear()} AKACompos</span>
                <span class="hidden md:inline text-slate-700">•</span>
                <span>
                    Hecho con <i class="fa-solid fa-heart text-red-500 text-xs"
                    ></i> por Carlos Ferreras y Jota
                </span>
            </div>

            <!-- Version -->
            <a
                href={`https://github.com/cferreras/akacompos/commit/${version}`}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-slate-800/50 hover:bg-slate-800 transition-all text-xs font-mono text-slate-400 hover:text-primary"
            >
                <i class="fa-solid fa-code-branch text-[10px]"></i>
                <span>v{version}</span>
            </a>
        </div>
    </Container>
</footer>

<style>
    /* Smooth animations */
    footer a {
        transition: all var(--transition-base);
    }

    /* Icon hover effects */
    footer i {
        transition: transform var(--transition-base);
    }

    footer a:hover i {
        transform: scale(1.1);
    }

    /* Gradient text animation */
    @media (prefers-reduced-motion: no-preference) {
        .bg-gradient-to-r {
            background-size: 200% auto;
            animation: shimmer 3s linear infinite;
        }
    }

    @keyframes shimmer {
        0% {
            background-position: 0% center;
        }
        100% {
            background-position: 200% center;
        }
    }
</style>
