---
import Button from "./ui/Button.astro";
import Container from "./ui/Container.astro";
---

<header
    class="sticky top-0 z-[100] bg-background-dark/80 backdrop-blur-strong border-b border-slate-800 shadow-lg"
>
    <Container maxWidth="xl" paddingY="none">
        <nav class="flex items-center justify-between h-16 p-4 sm:p-6 lg:p-8">
            <!-- Logo -->
            <div class="flex items-center gap-8">
                <a
                    href="/"
                    class="flex items-center gap-2 text-lg font-bold transition-all hover:scale-105 group"
                >
                    <span
                        class="text-primary font-black text-xl bg-gradient-to-r from-primary to-purple-400 bg-clip-text text-transparent"
                    >
                        AKACompos
                    </span>
                </a>

                <!-- Desktop Navigation -->
                <div class="hidden md:flex items-center gap-6">
                    <a
                        href="/"
                        class="nav-link text-sm font-medium text-slate-300 hover:text-primary transition-colors relative"
                    >
                        Inicio
                    </a>
                    <a
                        href="/compositions"
                        class="nav-link text-sm font-medium text-primary transition-colors relative"
                    >
                        Composiciones
                    </a>
                </div>
            </div>

            <!-- Right Side Actions -->
            <div class="flex items-center gap-4">
                <!-- Twitch Link -->
                <Button
                    as="a"
                    href="https://www.twitch.tv/akawonder"
                    target="_blank"
                    variant="ghost"
                    size="sm"
                    icon="twitch"
                    className="hidden sm:inline-flex"
                >
                    <span class="hidden lg:inline">Twitch</span>
                </Button>

                <!-- Mobile Twitch Icon -->
                <a
                    href="https://www.twitch.tv/akawonder"
                    target="_blank"
                    class="sm:hidden p-2 rounded-full text-slate-400 hover:text-purple-400 hover:bg-purple-400/10 transition-all"
                    aria-label="Twitch de AKAWonder"
                >
                    <i class="fa-brands fa-twitch text-xl"></i>
                </a>

                <!-- Mobile Menu Button -->
                <button
                    id="mobile-menu-button"
                    class="md:hidden p-2 rounded-lg text-slate-400 hover:text-white hover:bg-slate-700/50 transition-all"
                    aria-label="Menú"
                >
                    <i id="menu-icon" class="fa-solid fa-bars text-xl"></i>
                </button>
            </div>
        </nav>

        <!-- Mobile Menu -->
        <div
            id="mobile-menu"
            class="md:hidden overflow-hidden transition-all duration-300 ease-in-out"
            style="max-height: 0;"
        >
            <div class="py-4 space-y-2 border-t border-slate-800">
                <a
                    href="/"
                    class="block px-4 py-2 rounded-lg text-sm font-medium text-slate-300 hover:text-white hover:bg-slate-700/50 transition-all"
                >
                    <i class="fa-solid fa-home w-5 text-center mr-2"></i>
                    Inicio
                </a>
                <a
                    href="/compositions"
                    class="block px-4 py-2 rounded-lg text-sm font-medium text-primary hover:bg-primary/10 transition-all"
                >
                    <i class="fa-solid fa-chess w-5 text-center mr-2"></i>
                    Composiciones
                </a>
            </div>
        </div>
    </Container>
</header>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const menuButton = document.getElementById("mobile-menu-button");
        const mobileMenu = document.getElementById("mobile-menu");
        const menuIcon = document.getElementById("menu-icon");
        let isOpen = false;

        if (menuButton && mobileMenu && menuIcon) {
            menuButton.addEventListener("click", () => {
                isOpen = !isOpen;

                if (isOpen) {
                    mobileMenu.style.maxHeight = mobileMenu.scrollHeight + "px";
                    menuIcon.classList.remove("fa-bars");
                    menuIcon.classList.add("fa-times");
                } else {
                    mobileMenu.style.maxHeight = "0";
                    menuIcon.classList.remove("fa-times");
                    menuIcon.classList.add("fa-bars");
                }
            });

            // Close menu when clicking outside
            document.addEventListener("click", (e) => {
                if (
                    isOpen &&
                    !menuButton.contains(e.target as Node) &&
                    !mobileMenu.contains(e.target as Node)
                ) {
                    isOpen = false;
                    mobileMenu.style.maxHeight = "0";
                    menuIcon.classList.remove("fa-times");
                    menuIcon.classList.add("fa-bars");
                }
            });

            // Close menu when navigating
            const mobileLinks = mobileMenu.querySelectorAll("a");
            mobileLinks.forEach((link) => {
                link.addEventListener("click", () => {
                    isOpen = false;
                    mobileMenu.style.maxHeight = "0";
                    menuIcon.classList.remove("fa-times");
                    menuIcon.classList.add("fa-bars");
                });
            });
        }
    });
</script>

<style>
    /* Active nav link underline effect */
    .nav-link::after {
        content: "";
        position: absolute;
        bottom: -0.5rem;
        left: 0;
        right: 0;
        height: 2px;
        background: rgb(var(--color-primary));
        transform: scaleX(0);
        transition: transform var(--transition-base);
    }

    .nav-link:hover::after,
    .nav-link.active::after {
        transform: scaleX(1);
    }

    /* Current page indicator */
    a[href="/compositions"].nav-link::after {
        transform: scaleX(1);
    }

    /* Smooth transitions */
    #mobile-menu {
        transition: max-height 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    /* Logo animation */
    @media (prefers-reduced-motion: no-preference) {
        a[href="/"] {
            transition: transform 0.2s ease;
        }

        a[href="/"]:hover {
            transform: scale(1.05);
        }
    }
</style>
