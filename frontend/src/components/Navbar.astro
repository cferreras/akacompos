---
import Container from "./ui/Container.astro";

const pathname = Astro.url.pathname;
const isHome = pathname === "/";
const isCompositions = pathname.startsWith("/compositions");
---

<header
    class="fixed top-0 left-0 right-0 z-50 transition-all duration-300"
    id="main-header"
>
    <!-- Thin accent line at very top -->
    <div class="h-[2px] bg-gradient-to-r from-transparent via-amber-500/60 to-transparent"></div>

    <div class="bg-[rgb(10,10,12)]/80 backdrop-blur-xl border-b border-white/[0.04]">
        <Container maxWidth="xl" paddingX="md">
            <nav class="flex items-center justify-between h-14 md:h-16">
                <!-- Logo -->
                <a href="/" class="flex items-center gap-2.5 group">
                    <div class="w-8 h-8 rounded-md bg-amber-500/10 border border-amber-500/20 flex items-center justify-center group-hover:bg-amber-500/20 transition-colors">
                        <span class="font-display text-amber-400 text-sm font-bold tracking-tight">A</span>
                    </div>
                    <span class="font-display text-lg tracking-tight">
                        <span class="text-[rgb(245,245,245)] font-semibold">AKA</span><span class="text-amber-400 font-semibold">COMPOS</span>
                    </span>
                </a>

                <!-- Desktop Navigation -->
                <div class="hidden md:flex items-center gap-0.5">
                    <a
                        href="/"
                        class:list={[
                            "relative px-4 py-2 text-[13px] font-medium tracking-wide uppercase transition-colors",
                            isHome
                                ? "text-amber-400"
                                : "text-[rgb(113,113,122)] hover:text-[rgb(245,245,245)]",
                        ]}
                    >
                        Inicio
                        {isHome && <span class="absolute bottom-0 left-4 right-4 h-[2px] bg-amber-400 rounded-full"></span>}
                    </a>
                    <a
                        href="/compositions"
                        class:list={[
                            "relative px-4 py-2 text-[13px] font-medium tracking-wide uppercase transition-colors",
                            isCompositions
                                ? "text-amber-400"
                                : "text-[rgb(113,113,122)] hover:text-[rgb(245,245,245)]",
                        ]}
                    >
                        Composiciones
                        {isCompositions && <span class="absolute bottom-0 left-4 right-4 h-[2px] bg-amber-400 rounded-full"></span>}
                    </a>
                </div>

                <!-- Right Side -->
                <div class="flex items-center gap-2">
                    <!-- Twitch Link -->
                    <a
                        href="https://www.twitch.tv/akawonder"
                        target="_blank"
                        class="hidden sm:inline-flex items-center gap-2 px-3.5 py-1.5 rounded-md text-[13px] font-medium text-[rgb(163,163,170)] border border-white/[0.06] hover:border-purple-500/30 hover:text-purple-400 transition-all"
                    >
                        <i class="fa-brands fa-twitch text-xs"></i>
                        <span>Twitch</span>
                    </a>

                    <!-- CTA -->
                    <a
                        href="/compositions"
                        class="hidden md:inline-flex items-center gap-1.5 px-4 py-1.5 rounded-md text-[13px] font-semibold bg-amber-500 text-[rgb(10,10,12)] hover:bg-amber-400 transition-colors"
                    >
                        Ver Compos
                        <i class="fa-solid fa-arrow-right text-[10px]"></i>
                    </a>

                    <!-- Mobile Menu Button -->
                    <button
                        id="mobile-menu-button"
                        class="md:hidden w-9 h-9 flex items-center justify-center rounded-md border border-white/[0.06] text-[rgb(113,113,122)] hover:text-[rgb(245,245,245)] hover:border-white/10 transition-colors"
                        aria-label="Menú"
                    >
                        <i id="menu-icon" class="fa-solid fa-bars text-sm"></i>
                    </button>
                </div>
            </nav>

            <!-- Mobile Menu -->
            <div
                id="mobile-menu"
                class="md:hidden hidden border-t border-white/[0.04] py-3"
            >
                <div class="space-y-0.5">
                    <a
                        href="/"
                        class:list={[
                            "flex items-center gap-3 px-3 py-2.5 rounded-md text-sm font-medium transition-colors",
                            isHome
                                ? "text-amber-400 bg-amber-500/5"
                                : "text-[rgb(163,163,170)] hover:text-[rgb(245,245,245)] hover:bg-white/[0.03]",
                        ]}
                    >
                        <i class="fa-solid fa-home w-4 text-center text-xs"></i>
                        Inicio
                    </a>
                    <a
                        href="/compositions"
                        class:list={[
                            "flex items-center gap-3 px-3 py-2.5 rounded-md text-sm font-medium transition-colors",
                            isCompositions
                                ? "text-amber-400 bg-amber-500/5"
                                : "text-[rgb(163,163,170)] hover:text-[rgb(245,245,245)] hover:bg-white/[0.03]",
                        ]}
                    >
                        <i class="fa-solid fa-chess w-4 text-center text-xs"></i>
                        Composiciones
                    </a>
                    <div class="h-px bg-white/[0.04] my-2"></div>
                    <a
                        href="https://www.twitch.tv/akawonder"
                        target="_blank"
                        class="flex items-center gap-3 px-3 py-2.5 rounded-md text-sm font-medium text-[rgb(163,163,170)] hover:text-purple-400 transition-colors"
                    >
                        <i class="fa-brands fa-twitch w-4 text-center text-xs"></i>
                        Twitch
                    </a>
                </div>
            </div>
        </Container>
    </div>
</header>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const menuButton = document.getElementById("mobile-menu-button");
        const mobileMenu = document.getElementById("mobile-menu");
        const menuIcon = document.getElementById("menu-icon");
        const header = document.getElementById("main-header");

        if (menuButton && mobileMenu && menuIcon) {
            menuButton.addEventListener("click", () => {
                const isOpen = !mobileMenu.classList.contains("hidden");

                if (isOpen) {
                    mobileMenu.classList.add("hidden");
                    menuIcon.classList.remove("fa-times");
                    menuIcon.classList.add("fa-bars");
                } else {
                    mobileMenu.classList.remove("hidden");
                    menuIcon.classList.remove("fa-bars");
                    menuIcon.classList.add("fa-times");
                }
            });

            document.addEventListener("click", (e) => {
                if (
                    !mobileMenu.classList.contains("hidden") &&
                    !menuButton.contains(e.target as Node) &&
                    !mobileMenu.contains(e.target as Node)
                ) {
                    mobileMenu.classList.add("hidden");
                    menuIcon.classList.remove("fa-times");
                    menuIcon.classList.add("fa-bars");
                }
            });

            const mobileLinks = mobileMenu.querySelectorAll("a");
            mobileLinks.forEach((link) => {
                link.addEventListener("click", () => {
                    mobileMenu.classList.add("hidden");
                    menuIcon.classList.remove("fa-times");
                    menuIcon.classList.add("fa-bars");
                });
            });
        }
    });
</script>
