---
import Button from "./ui/Button.astro";
import Container from "./ui/Container.astro";

const pathname = Astro.url.pathname;
const isHome = pathname === "/";
const isCompositions = pathname.startsWith("/compositions");
---

<header
    class="sticky top-0 z-[100] bg-background-dark/40 backdrop-blur-xl border-b border-white/5 transition-all duration-500"
    id="main-header"
>
    <Container maxWidth="xl" paddingY="none" paddingX="md">
        <nav class="flex items-center justify-between h-16">
            <!-- Logo & Navigation -->
            <div class="flex items-center gap-12">
                <a
                    href="/"
                    class="flex items-center gap-2 transition-all hover:opacity-80"
                >
                    <span
                        class="text-white font-black text-xl tracking-tighter"
                    >
                        AKA<span class="text-primary">COMPOS</span>
                    </span>
                </a>

                <!-- Desktop Navigation -->
                <div class="hidden md:flex items-center gap-1">
                    <a
                        href="/"
                        class:list={[
                            "px-4 py-1.5 rounded-full text-xs font-black uppercase tracking-widest transition-all",
                            isHome
                                ? "bg-primary/10 text-primary shadow-[inset_0_0_10px_rgba(164,107,255,0.1)]"
                                : "text-slate-400 hover:text-white hover:bg-white/5",
                        ]}
                    >
                        Inicio
                    </a>
                    <a
                        href="/compositions"
                        class:list={[
                            "px-4 py-1.5 rounded-full text-xs font-black uppercase tracking-widest transition-all",
                            isCompositions
                                ? "bg-primary/10 text-primary shadow-[inset_0_0_10px_rgba(164,107,255,0.1)]"
                                : "text-slate-400 hover:text-white hover:bg-white/5",
                        ]}
                    >
                        Composiciones
                    </a>
                </div>
            </div>

            <!-- Right Side Actions -->
            <div class="flex items-center gap-4">
                <!-- Twitch Link -->
                <a
                    href="https://www.twitch.tv/akawonder"
                    target="_blank"
                    class="flex items-center gap-2 px-4 py-2 rounded-xl bg-purple-600/10 border border-purple-500/20 text-purple-400 text-xs font-black uppercase tracking-widest hover:bg-purple-600 hover:text-white hover:border-purple-600 transition-all duration-300 group"
                >
                    <i class="fa-brands fa-twitch text-sm group-hover:animate-bounce"></i>
                    <span class="hidden sm:inline">Live</span>
                </a>

                <!-- Mobile Menu Button -->
                <button
                    id="mobile-menu-button"
                    class="md:hidden w-10 h-10 flex items-center justify-center rounded-xl bg-white/5 text-slate-400 hover:text-white transition-all"
                    aria-label="Menú"
                >
                    <i
                        id="menu-icon"
                        class="fa-solid fa-bars text-lg"
                    ></i>
                </button>
            </div>
        </nav>

        <!-- Mobile Menu -->
        <div
            id="mobile-menu"
            class="md:hidden overflow-hidden transition-all duration-300 ease-in-out opacity-0 invisible"
            style="max-height: 0;"
        >
            <div
                class="py-4 space-y-2 border-t border-slate-800/50 bg-background-dark/95 backdrop-blur-xl rounded-b-2xl mb-4 mx-2 px-2 shadow-xl border border-slate-800/50"
            >
                <a
                    href="/"
                    class:list={[
                        "block px-4 py-3 rounded-xl text-sm font-medium transition-all flex items-center gap-3",
                        isHome
                            ? "bg-primary/10 text-primary"
                            : "text-slate-300 hover:text-white hover:bg-slate-700/50",
                    ]}
                >
                    <i class="fa-solid fa-home w-5 text-center"></i>
                    Inicio
                </a>
                <a
                    href="/compositions"
                    class:list={[
                        "block px-4 py-3 rounded-xl text-sm font-medium transition-all flex items-center gap-3",
                        isCompositions
                            ? "bg-primary/10 text-primary"
                            : "text-slate-300 hover:text-white hover:bg-slate-700/50",
                    ]}
                >
                    <i class="fa-solid fa-chess w-5 text-center"></i>
                    Composiciones
                </a>
            </div>
        </div>
    </Container>
</header>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const menuButton = document.getElementById("mobile-menu-button");
        const mobileMenu = document.getElementById("mobile-menu");
        const menuIcon = document.getElementById("menu-icon");
        const header = document.getElementById("main-header");
        let isOpen = false;

        // Scroll effect
        window.addEventListener("scroll", () => {
            if (window.scrollY > 10) {
                header?.classList.remove(
                    "bg-background-dark/60",
                    "backdrop-blur-md",
                    "border-slate-800/30",
                );
                header?.classList.add(
                    "bg-background-dark/95",
                    "backdrop-blur-xl",
                    "border-slate-800",
                    "shadow-elevation-2",
                );
            } else {
                header?.classList.remove(
                    "bg-background-dark/95",
                    "backdrop-blur-xl",
                    "border-slate-800",
                    "shadow-elevation-2",
                );
                header?.classList.add(
                    "bg-background-dark/60",
                    "backdrop-blur-md",
                    "border-slate-800/30",
                );
            }
        });

        if (menuButton && mobileMenu && menuIcon) {
            menuButton.addEventListener("click", () => {
                isOpen = !isOpen;

                if (isOpen) {
                    mobileMenu.style.maxHeight = mobileMenu.scrollHeight + "px";
                    mobileMenu.classList.remove("opacity-0", "invisible");
                    menuIcon.classList.remove("fa-bars");
                    menuIcon.classList.add("fa-times", "rotate-90");
                } else {
                    mobileMenu.style.maxHeight = "0";
                    mobileMenu.classList.add("opacity-0", "invisible");
                    menuIcon.classList.remove("fa-times", "rotate-90");
                    menuIcon.classList.add("fa-bars");
                }
            });

            // Close menu when clicking outside
            document.addEventListener("click", (e) => {
                if (
                    isOpen &&
                    !menuButton.contains(e.target as Node) &&
                    !mobileMenu.contains(e.target as Node)
                ) {
                    isOpen = false;
                    mobileMenu.style.maxHeight = "0";
                    mobileMenu.classList.add("opacity-0", "invisible");
                    menuIcon.classList.remove("fa-times", "rotate-90");
                    menuIcon.classList.add("fa-bars");
                }
            });

            // Close menu when navigating
            const mobileLinks = mobileMenu.querySelectorAll("a");
            mobileLinks.forEach((link) => {
                link.addEventListener("click", () => {
                    isOpen = false;
                    mobileMenu.style.maxHeight = "0";
                    mobileMenu.classList.add("opacity-0", "invisible");
                    menuIcon.classList.remove("fa-times", "rotate-90");
                    menuIcon.classList.add("fa-bars");
                });
            });
        }
    });
</script>

<style>
    /* Active nav link underline effect */
    .nav-link::after {
        content: "";
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        height: 2px;
        background: linear-gradient(
            90deg,
            transparent,
            rgb(var(--color-primary)),
            transparent
        );
        transform: scaleX(0);
        transition: transform var(--transition-base);
        opacity: 0;
    }

    .nav-link:hover::after {
        transform: scaleX(1);
        opacity: 0.5;
    }

    .nav-link.text-primary::after {
        transform: scaleX(1);
        opacity: 1;
    }

    /* Smooth transitions */
    #mobile-menu {
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .rotate-90 {
        transform: rotate(90deg);
    }

    /* Logo animation */
    @media (prefers-reduced-motion: no-preference) {
        a[href="/"] {
            transition: transform 0.2s ease;
        }

        a[href="/"]:hover {
            transform: scale(1.05);
        }

        .animate-gradient-x {
            background-size: 200% 200%;
            animation: gradient-x 3s ease infinite;
        }

        @keyframes gradient-x {
            0% {
                background-position: 0% 50%;
            }
            50% {
                background-position: 100% 50%;
            }
            100% {
                background-position: 0% 50%;
            }
        }
    }
</style>
