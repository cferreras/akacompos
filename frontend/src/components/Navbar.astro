---
import Container from "./ui/Container.astro";

const pathname = Astro.url.pathname;
const isHome = pathname === "/";
const isCompositions = pathname.startsWith("/compositions");
---

<header
    class="fixed top-0 left-0 right-0 z-50 bg-slate-950/90 backdrop-blur-md border-b border-white/5"
    id="main-header"
>
    <Container maxWidth="xl" paddingX="md">
        <nav class="flex items-center justify-between h-16">
            <!-- Logo -->
            <a href="/" class="flex items-center gap-2 group">
                <span class="text-white font-bold text-xl tracking-tight">
                    AKA<span class="text-primary">COMPOS</span>
                </span>
            </a>

            <!-- Desktop Navigation -->
            <div class="hidden md:flex items-center gap-1">
                <a
                    href="/"
                    class:list={[
                        "px-4 py-2 rounded-lg text-sm font-medium transition-colors",
                        isHome
                            ? "text-white bg-white/10"
                            : "text-slate-400 hover:text-white hover:bg-white/5",
                    ]}
                >
                    Inicio
                </a>
                <a
                    href="/compositions"
                    class:list={[
                        "px-4 py-2 rounded-lg text-sm font-medium transition-colors",
                        isCompositions
                            ? "text-white bg-white/10"
                            : "text-slate-400 hover:text-white hover:bg-white/5",
                    ]}
                >
                    Composiciones
                </a>
            </div>

            <!-- Right Side -->
            <div class="flex items-center gap-3">
                <!-- Twitch Link -->
                <a
                    href="https://www.twitch.tv/akawonder"
                    target="_blank"
                    class="hidden sm:flex items-center gap-2 px-3 py-1.5 rounded-lg bg-purple-600/20 text-purple-400 text-sm font-medium hover:bg-purple-600 hover:text-white transition-colors"
                >
                    <i class="fa-brands fa-twitch"></i>
                    <span>Twitch</span>
                </a>

                <!-- Mobile Menu Button -->
                <button
                    id="mobile-menu-button"
                    class="md:hidden w-9 h-9 flex items-center justify-center rounded-lg bg-white/5 text-slate-400 hover:text-white transition-colors"
                    aria-label="Menú"
                >
                    <i id="menu-icon" class="fa-solid fa-bars text-sm"></i>
                </button>
            </div>
        </nav>

        <!-- Mobile Menu -->
        <div
            id="mobile-menu"
            class="md:hidden hidden border-t border-white/5 mt-2 pt-2 pb-4"
        >
            <div class="space-y-1">
                <a
                    href="/"
                    class:list={[
                        "block px-4 py-3 rounded-lg text-sm font-medium transition-colors",
                        isHome
                            ? "text-white bg-white/10"
                            : "text-slate-400 hover:text-white hover:bg-white/5",
                    ]}
                >
                    <i class="fa-solid fa-home w-5"></i>
                    Inicio
                </a>
                <a
                    href="/compositions"
                    class:list={[
                        "block px-4 py-3 rounded-lg text-sm font-medium transition-colors",
                        isCompositions
                            ? "text-white bg-white/10"
                            : "text-slate-400 hover:text-white hover:bg-white/5",
                    ]}
                >
                    <i class="fa-solid fa-chess w-5"></i>
                    Composiciones
                </a>
                <a
                    href="https://www.twitch.tv/akawonder"
                    target="_blank"
                    class="flex items-center gap-2 px-4 py-3 rounded-lg text-sm font-medium text-purple-400 hover:bg-purple-600/20 transition-colors"
                >
                    <i class="fa-brands fa-twitch w-5"></i>
                    Twitch
                </a>
            </div>
        </div>
    </Container>
</header>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const menuButton = document.getElementById("mobile-menu-button");
        const mobileMenu = document.getElementById("mobile-menu");
        const menuIcon = document.getElementById("menu-icon");

        if (menuButton && mobileMenu && menuIcon) {
            menuButton.addEventListener("click", () => {
                const isOpen = !mobileMenu.classList.contains("hidden");

                if (isOpen) {
                    mobileMenu.classList.add("hidden");
                    menuIcon.classList.remove("fa-times");
                    menuIcon.classList.add("fa-bars");
                } else {
                    mobileMenu.classList.remove("hidden");
                    menuIcon.classList.remove("fa-bars");
                    menuIcon.classList.add("fa-times");
                }
            });

            // Close menu when clicking outside
            document.addEventListener("click", (e) => {
                if (
                    !mobileMenu.classList.contains("hidden") &&
                    !menuButton.contains(e.target as Node) &&
                    !mobileMenu.contains(e.target as Node)
                ) {
                    mobileMenu.classList.add("hidden");
                    menuIcon.classList.remove("fa-times");
                    menuIcon.classList.add("fa-bars");
                }
            });

            // Close menu when navigating
            const mobileLinks = mobileMenu.querySelectorAll("a");
            mobileLinks.forEach((link) => {
                link.addEventListener("click", () => {
                    mobileMenu.classList.add("hidden");
                    menuIcon.classList.remove("fa-times");
                    menuIcon.classList.add("fa-bars");
                });
            });
        }
    });
</script>
