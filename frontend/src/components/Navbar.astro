---
import Button from "./ui/Button.astro";
import Container from "./ui/Container.astro";

const pathname = Astro.url.pathname;
const isHome = pathname === "/";
const isCompositions = pathname.startsWith("/compositions");
---

<header
    class="fixed top-3 md:top-6 left-0 right-0 z-[1000] transition-all duration-500"
    id="main-header"
>
    <Container maxWidth="xl" paddingX="md">
        <div class="bg-slate-950/60 backdrop-blur-2xl border border-white/10 rounded-full px-6 py-2 shadow-2xl shadow-black/50">
            <nav class="flex items-center justify-between h-12">
                <!-- Logo & Navigation -->
                <div class="flex items-center gap-8">
                    <a
                        href="/"
                        class="flex items-center gap-2 transition-all hover:opacity-80"
                    >
                        <span
                            class="text-white font-black text-lg tracking-tighter"
                        >
                            AKA<span class="text-primary">COMPOS</span>
                        </span>
                    </a>

                    <!-- Desktop Navigation -->
                    <div class="hidden md:flex items-center gap-1">
                        <a
                            href="/"
                            class:list={[
                                "px-4 py-1.5 rounded-full text-[10px] font-black uppercase tracking-widest transition-all",
                                isHome
                                    ? "bg-primary/20 text-primary shadow-[inset_0_0_10px_rgba(164,107,255,0.1)]"
                                    : "text-slate-400 hover:text-white hover:bg-white/5",
                            ]}
                        >
                            Inicio
                        </a>
                        <a
                            href="/compositions"
                            class:list={[
                                "px-4 py-1.5 rounded-full text-[10px] font-black uppercase tracking-widest transition-all",
                                isCompositions
                                    ? "bg-primary/20 text-primary shadow-[inset_0_0_10px_rgba(164,107,255,0.1)]"
                                    : "text-slate-400 hover:text-white hover:bg-white/5",
                            ]}
                        >
                            Composiciones
                        </a>
                    </div>
                </div>

                <!-- Right Side Actions -->
                <div class="flex items-center gap-3">
                    <!-- Twitch Link -->
                    <a
                        href="https://www.twitch.tv/akawonder"
                        target="_blank"
                        class="flex items-center gap-2 px-4 py-1.5 rounded-full bg-purple-600/20 border border-purple-500/30 text-purple-400 text-[10px] font-black uppercase tracking-widest hover:bg-purple-600 hover:text-white hover:border-purple-600 transition-all duration-300 group"
                    >
                        <div class="w-2 h-2 bg-purple-500 rounded-full animate-pulse"></div>
                        <span class="hidden sm:inline">Live</span>
                    </a>

                    <!-- Mobile Menu Button -->
                    <button
                        id="mobile-menu-button"
                        class="md:hidden w-8 h-8 flex items-center justify-center rounded-full bg-white/5 text-slate-400 hover:text-white transition-all"
                        aria-label="Menú"
                    >
                        <i
                            id="menu-icon"
                            class="fa-solid fa-bars text-sm"
                        ></i>
                    </button>
                </div>
            </nav>
        </div>

        <!-- Mobile Menu -->
        <div
            id="mobile-menu"
            class="md:hidden overflow-hidden transition-all duration-300 ease-in-out opacity-0 invisible mt-2"
            style="max-height: 0;"
        >
            <div
                class="py-4 space-y-2 bg-slate-950/90 backdrop-blur-2xl rounded-3xl px-4 shadow-2xl border border-white/10"
            >
                <a
                    href="/"
                    class:list={[
                        "block px-4 py-3 rounded-xl text-sm font-medium transition-all flex items-center gap-3",
                        isHome
                            ? "bg-primary/10 text-primary"
                            : "text-slate-300 hover:text-white hover:bg-slate-700/50",
                    ]}
                >
                    <i class="fa-solid fa-home w-5 text-center"></i>
                    Inicio
                </a>
                <a
                    href="/compositions"
                    class:list={[
                        "block px-4 py-3 rounded-xl text-sm font-medium transition-all flex items-center gap-3",
                        isCompositions
                            ? "bg-primary/10 text-primary"
                            : "text-slate-300 hover:text-white hover:bg-slate-700/50",
                    ]}
                >
                    <i class="fa-solid fa-chess w-5 text-center"></i>
                    Composiciones
                </a>
            </div>
        </div>
    </Container>
</header>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const menuButton = document.getElementById("mobile-menu-button");
        const mobileMenu = document.getElementById("mobile-menu");
        const menuIcon = document.getElementById("menu-icon");
        const header = document.getElementById("main-header");
        let isOpen = false;
        let lastScrollY = window.scrollY;
        const scrollThreshold = 100;

        // Scroll effect
        window.addEventListener("scroll", () => {
            const currentScrollY = window.scrollY;

            // Hide/Show logic
            if (currentScrollY > lastScrollY && currentScrollY > scrollThreshold && !isOpen) {
                // Scrolling down
                header?.classList.add("-translate-y-[150%]", "opacity-0");
            } else {
                // Scrolling up
                header?.classList.remove("-translate-y-[150%]", "opacity-0");
            }

            if (currentScrollY > 20) {
                header?.classList.add("top-2");
                header?.classList.remove("top-3", "top-6");
            } else {
                if (window.innerWidth < 768) {
                    header?.classList.add("top-3");
                } else {
                    header?.classList.add("top-6");
                }
                header?.classList.remove("top-2");
            }

            lastScrollY = currentScrollY;
        });

        if (menuButton && mobileMenu && menuIcon) {
            menuButton.addEventListener("click", () => {
                isOpen = !isOpen;

                if (isOpen) {
                    mobileMenu.style.maxHeight = mobileMenu.scrollHeight + "px";
                    mobileMenu.classList.remove("opacity-0", "invisible");
                    menuIcon.classList.remove("fa-bars");
                    menuIcon.classList.add("fa-times", "rotate-90");
                } else {
                    mobileMenu.style.maxHeight = "0";
                    mobileMenu.classList.add("opacity-0", "invisible");
                    menuIcon.classList.remove("fa-times", "rotate-90");
                    menuIcon.classList.add("fa-bars");
                }
            });

            // Close menu when clicking outside
            document.addEventListener("click", (e) => {
                if (
                    isOpen &&
                    !menuButton.contains(e.target as Node) &&
                    !mobileMenu.contains(e.target as Node)
                ) {
                    isOpen = false;
                    mobileMenu.style.maxHeight = "0";
                    mobileMenu.classList.add("opacity-0", "invisible");
                    menuIcon.classList.remove("fa-times", "rotate-90");
                    menuIcon.classList.add("fa-bars");
                }
            });

            // Close menu when navigating
            const mobileLinks = mobileMenu.querySelectorAll("a");
            mobileLinks.forEach((link) => {
                link.addEventListener("click", () => {
                    isOpen = false;
                    mobileMenu.style.maxHeight = "0";
                    mobileMenu.classList.add("opacity-0", "invisible");
                    menuIcon.classList.remove("fa-times", "rotate-90");
                    menuIcon.classList.add("fa-bars");
                });
            });
        }
    });
</script>

<style>
    /* Active nav link underline effect */
    .nav-link::after {
        content: "";
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        height: 2px;
        background: linear-gradient(
            90deg,
            transparent,
            rgb(var(--color-primary)),
            transparent
        );
        transform: scaleX(0);
        transition: transform var(--transition-base);
        opacity: 0;
    }

    .nav-link:hover::after {
        transform: scaleX(1);
        opacity: 0.5;
    }

    .nav-link.text-primary::after {
        transform: scaleX(1);
        opacity: 1;
    }

    /* Smooth transitions */
    #mobile-menu {
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .rotate-90 {
        transform: rotate(90deg);
    }

    /* Logo animation */
    @media (prefers-reduced-motion: no-preference) {
        a[href="/"] {
            transition: transform 0.2s ease;
        }

        a[href="/"]:hover {
            transform: scale(1.05);
        }

        .animate-gradient-x {
            background-size: 200% 200%;
            animation: gradient-x 3s ease infinite;
        }

        @keyframes gradient-x {
            0% {
                background-position: 0% 50%;
            }
            50% {
                background-position: 100% 50%;
            }
            100% {
                background-position: 0% 50%;
            }
        }
    }
</style>
