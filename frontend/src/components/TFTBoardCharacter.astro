---
import { championAssets, itemAssets, championImagePositions } from "../utils/assets";
import StarsComponent from "./StarsComponent.astro";
import { Image } from "astro:assets";

const borderColors = {
    purple: "#8b5cf6",
    blue: "#3b82f6",
    yellow: "#eab308",
    green: "#22c55e",
    gray: "#6b7280",
    empty: "#1e293b",
} as const;

interface Props {
    champion?: keyof typeof championAssets;
    imageUrl?: string;
    borderColor?: keyof typeof borderColors | string;
    size?: string;
    items?: (keyof typeof itemAssets)[];
    stars?: number;
}

const {
    champion,
    imageUrl,
    borderColor = "gray",
    size = "72px",
    items = [],
    stars = 1,
} = Astro.props;

const finalImageSrc = champion ? championAssets[champion] : null;
const imagePosition = champion ? (championImagePositions[champion] || championImagePositions["Default"]) : championImagePositions["Default"];
const showEmptySlot = !champion && !imageUrl;
const finalBorderColor = borderColors[borderColor as keyof typeof borderColors];
const validItems = items.slice(0, 3).filter((item) => item in itemAssets);

const numericSize = size.includes("px") ? parseInt(size.replace("px", "")) : 72;

const getOptimizedSize = (size: string): number => {
    if (size.includes("var(")) return 128;
    const num = parseInt(size.replace("px", ""));
    if (isNaN(num)) return 96;
    if (num <= 48) return 48;
    if (num <= 72) return 72;
    if (num <= 96) return 96;
    return 128;
};

const optimizedSize = getOptimizedSize(size);
const optimizedItemSize = size.includes("var(") 
    ? 32 
    : Math.max(12, Math.min(32, Math.floor(numericSize * 0.25)));

// Calcular escala de fuente basada en la longitud del nombre
const nameLength = champion ? champion.length : 0;
let fontSize = "0.65rem";
if (nameLength > 12) {
    fontSize = "0.55rem";
} else if (nameLength > 8) {
    fontSize = "0.6rem";
}
---

<div
    class="character"
    style={`--border-color: ${finalBorderColor}; --size: ${size};`}
>
    <div class="stars">
        <StarsComponent stars={stars} />
    </div>
    
    <div class="hexagon-wrapper">
        <div class="hexagon">
            {
                finalImageSrc ? (
                    <Image
                        src={finalImageSrc}
                        alt={champion ? `${champion}` : "Champion"}
                        class="hexagon-img"
                        style={`object-position: ${imagePosition};`}
                        width={optimizedSize}
                        height={optimizedSize}
                        loading="lazy"
                        decoding="async"
                        format="webp"
                        quality={80}
                    />
                ) : imageUrl ? (
                    <img src={imageUrl} alt="Champion" class="hexagon-img" style={`object-position: ${imagePosition};`} />
                ) : (
                    <div class="empty" />
                )
            }
        </div>
    </div>

    {
        validItems.length > 0 && (
            <div class="items">
                {validItems.map((item) => (
                    <div class="item">
                        <Image
                            src={itemAssets[item]}
                            alt={`${item}`}
                            class="item-img"
                            width={optimizedItemSize}
                            height={optimizedItemSize}
                            loading="lazy"
                            decoding="async"
                            format="webp"
                            quality={75}
                        />
                    </div>
                ))}
            </div>
        )
    }

    {
        champion && (
            <div class="champion-name" style={`font-size: ${fontSize};`}>
                {champion}
            </div>
        )
    }
</div>

<style>
    .character {
        position: relative;
        width: var(--size);
        /* Altura fija: hexágono + espacio para nombre */
        height: calc(var(--size) + 20px);
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .hexagon-wrapper {
        position: relative;
        width: var(--size);
        height: var(--size);
        clip-path: polygon(50% 0%, 94% 25%, 94% 75%, 50% 100%, 6% 75%, 6% 25%);
        background: var(--border-color);
        padding: 2px;
        flex-shrink: 0;
    }

    .hexagon {
        width: 100%;
        height: 100%;
        background: #0f172a;
        clip-path: polygon(50% 0%, 94% 25%, 94% 75%, 50% 100%, 6% 75%, 6% 25%);
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }

    .hexagon-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .empty {
        width: 100%;
        height: 100%;
        background: rgba(255, 255, 255, 0.02);
    }

    .items {
        position: absolute;
        /* Posicionado desde arriba, justo debajo del hexágono */
        top: calc(var(--size) - 8px);
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        gap: 2px;
        z-index: 10;
    }

    .item {
        width: clamp(12px, calc(var(--size) * 0.22), 24px);
        height: clamp(12px, calc(var(--size) * 0.22), 24px);
        border-radius: 3px;
        border: 1px solid rgba(255, 255, 255, 0.2);
        background: #000;
        overflow: hidden;
    }

    .item-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .stars {
        position: absolute;
        top: -6px;
        left: 50%;
        transform: translateX(-50%);
        z-index: 10;
    }

    .champion-name {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        text-align: center;
        color: white;
        font-weight: 600;
        line-height: 1.2;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        text-shadow: 0 1px 2px rgba(0, 0, 0, 0.8);
        padding: 0 2px;
        display: flex;
        justify-content: center;
        align-items: center;
    }
    
    .champion-name::before,
    .champion-name::after {
        content: '';
        position: absolute;
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: currentColor;
        opacity: 0.7;
    }
    
    .champion-name::before {
        left: 4px;
    }
    
    .champion-name::after {
        right: 4px;
    }
</style>
