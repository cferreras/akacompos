---
import { championAssets, itemAssets, championImagePositions } from "../utils/assets";
import StarsComponent from "./StarsComponent.astro";
import { Image } from "astro:assets";
import { isSet17Champion } from "../utils/set17ChampionIcons";

const borderColors = {
    purple: "#7f1d1d", // Magic Crimson
    blue: "#0284c7",   // Deep Blue
    yellow: "#d4af37", // Gold
    green: "#166534",  // Deep Green
    gray: "#57534e",   // Stone Gray
    orange: "#b45309", // Bronze
    red: "#991b1b",    // Blood Red
    empty: "#1c1917",  // Dark Surface
} as const;

interface Props {
    champion?: keyof typeof championAssets;
    imageUrl?: string;
    borderColor?: keyof typeof borderColors | string;
    size?: string;
    items?: (keyof typeof itemAssets)[];
    stars?: number;
}

const {
    champion,
    imageUrl,
    borderColor = "gray",
    size = "72px",
    items = [],
    stars = 1,
} = Astro.props;

const finalImageSrc = champion ? championAssets[champion] : null;
const imagePosition = champion ? (championImagePositions[champion] || championImagePositions["Default"]) : championImagePositions["Default"];
const imageFit = champion && isSet17Champion(champion) ? "contain" : "cover";
const showEmptySlot = !champion && !imageUrl;
const finalBorderColor = borderColors[borderColor as keyof typeof borderColors] || borderColors.empty;
const validItems = items.slice(0, 3).filter((item) => item in itemAssets);

const numericSize = size.includes("px") ? parseInt(size.replace("px", "")) : 72;

const getOptimizedSize = (size: string): number => {
    if (size.includes("var(")) return 128;
    const num = parseInt(size.replace("px", ""));
    if (isNaN(num)) return 96;
    if (num <= 48) return 48;
    if (num <= 72) return 72;
    if (num <= 96) return 96;
    return 128;
};

const optimizedSize = getOptimizedSize(size);
const optimizedItemSize = size.includes("var(") 
    ? 32 
    : Math.max(12, Math.min(32, Math.floor(numericSize * 0.25)));

const nameLength = champion ? champion.length : 0;
let fontSize = "calc(var(--size) * 0.16)";
if (nameLength > 12) fontSize = "calc(var(--size) * 0.12)";
else if (nameLength > 8) fontSize = "calc(var(--size) * 0.14)";
---

<div
    class="character group"
    style={`--border-color: ${finalBorderColor}; --size: ${size}; --champion-fit: ${imageFit};`}
>
    <div class="stars">
        <StarsComponent stars={stars} />
    </div>
    
    <div class="hexagon-wrapper">
        <div class="hexagon">
            {
                finalImageSrc ? (
                    <>
                        <Image
                            src={finalImageSrc}
                            alt={champion ? `${champion}` : "Champion"}
                            class="hexagon-img"
                            style={`object-position: ${imagePosition}; object-fit: ${imageFit};`}
                            width={optimizedSize}
                            height={optimizedSize}
                            loading="lazy"
                            decoding="async"
                            format="webp"
                            quality={80}
                        />
                        <div class="hexagon-overlay"></div>
                    </>
                ) : imageUrl ? (
                    <>
                        <img src={imageUrl} alt="Champion" class="hexagon-img" style={`object-position: ${imagePosition}; object-fit: ${imageFit};`} />
                        <div class="hexagon-overlay"></div>
                    </>
                ) : (
                    <div class="empty" />
                )
            }
        </div>
    </div>

    {
        validItems.length > 0 && (
            <div class="items">
                {validItems.map((item, index) => (
                    <div class="item" style={`transition-delay: ${index * 50}ms`}>
                        <Image
                            src={itemAssets[item]}
                            alt={`${item}`}
                            class="item-img"
                            width={optimizedItemSize}
                            height={optimizedItemSize}
                            loading="lazy"
                            decoding="async"
                            format="webp"
                            quality={75}
                        />
                    </div>
                ))}
            </div>
        )
    }

    {
        champion && (
            <div class="champion-name" style={`font-size: ${fontSize};`}>
                {champion}
            </div>
        )
    }
</div>

<style>
    .character {
        position: relative;
        width: var(--size);
        height: calc(var(--size) + 12px);
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .hexagon-wrapper {
        position: relative;
        width: var(--size);
        height: var(--size);
        clip-path: polygon(50% 0%, 94% 25%, 94% 75%, 50% 100%, 6% 75%, 6% 25%);
        background: var(--border-color);
        padding: 1.5px;
        flex-shrink: 0;
        transition: all 0.3s ease;
    }
    
    .character:has(.hexagon-img):hover .hexagon-wrapper {
        transform: scale(1.03);
        box-shadow: 0 0 15px rgba(0,0,0,0.5);
    }

    .hexagon {
        width: 100%;
        height: 100%;
        background: #0c0a09;
        clip-path: polygon(50% 0%, 94% 25%, 94% 75%, 50% 100%, 6% 75%, 6% 25%);
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        position: relative;
    }

    .hexagon-img {
        width: 100%;
        height: 100%;
        object-fit: var(--champion-fit, cover);
        filter: contrast(1.1) grayscale(10%);
        transition: all 0.5s ease;
    }
    
    .character:hover .hexagon-img {
        filter: contrast(1.25) grayscale(0%);
    }
    
    .hexagon-overlay {
        position: absolute;
        inset: 0;
        background: radial-gradient(circle at center, rgba(12,10,9,0.7) 0%, transparent 70%);
        pointer-events: none;
    }

    .empty {
        width: 100%;
        height: 100%;
        background: url('https://www.transparenttextures.com/patterns/stardust.png');
        opacity: 0.05;
    }

    .items {
        position: absolute;
        top: calc(var(--size) - 8px);
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        gap: 2px;
        z-index: 10;
    }

    .item {
        width: clamp(14px, calc(var(--size) * 0.28), 26px);
        height: clamp(14px, calc(var(--size) * 0.28), 26px);
        border-radius: 1px;
        border: 1px solid rgba(212,175,55,0.4);
        background: #0c0a09;
        overflow: hidden;
        transition: transform 0.3s ease;
    }
    
    .character:hover .item {
        transform: translateY(-2px);
    }

    .item-img {
        width: 100%;
        height: 100%;
        object-fit: var(--champion-fit, cover);
    }

    .stars {
        position: absolute;
        top: -8px;
        left: 50%;
        transform: translateX(-50%);
        z-index: 10;
    }
    
    :global(.stars span) {
        color: #d4af37 !important;
        font-size: 0.55rem !important;
        letter-spacing: 2px !important;
        background: rgba(12,10,9,0.85) !important;
        border: 1px solid rgba(212,175,55,0.3) !important;
        border-radius: 2px !important;
        padding: 1px 4px !important;
        white-space: nowrap !important;
        backdrop-filter: blur(4px) !important;
    }

    .champion-name {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        left: 0;
        right: 0;
        text-align: center;
        color: #f5f5f4;
        font-family: "Inknut Antiqua", serif;
        font-weight: 600;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        line-height: 1.1;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        text-shadow: 0 2px 4px rgba(0,0,0,1), 0 0 10px rgba(0,0,0,0.9);
        padding: 0 4px;
        display: flex;
        justify-content: center;
        align-items: center;
        transition: color 0.3s ease;
        z-index: 5;
        pointer-events: none;
    }
    
    .character:hover .champion-name {
        color: #d4af37;
    }
</style>

