---
import { itemAssets } from "../utils/assets";
import { Image } from "astro:assets";

export interface Props {
  itemName: string;
  description?: string;
  size?: "small" | "medium" | "large";
  showLabel?: boolean;
}

const { itemName, description, size = "small", showLabel = true } = Astro.props;

const itemImage = itemAssets[itemName as keyof typeof itemAssets];
const sizeClasses = {
  small: "w-5 h-5",
  medium: "w-8 h-8",
  large: "w-12 h-12",
};
const sizePixels = {
  small: 20,
  medium: 32,
  large: 48,
};
---

<div class="flex items-center gap-3 py-1">
    <div class="flex-shrink-0">
        {
            itemImage ? (
                <Image
                    src={itemImage}
                    alt={itemName}
                    class={`${sizeClasses[size]} rounded border border-slate-600 bg-slate-800`}
                    width={sizePixels[size]}
                    height={sizePixels[size]}
                    loading="lazy"
                    decoding="async"
                    format="webp"
                    quality={75}
                />
            ) : (
                <div class={`${sizeClasses[size]} rounded border border-slate-700 bg-slate-800`} />
            )
        }
    </div>
    
    {
        showLabel && (
            <div class="flex flex-col min-w-0 flex-1">
                <span class="text-sm font-medium text-white truncate">{itemName}</span>
                {description && (
                    <span class="text-xs text-slate-400 line-clamp-2">{description}</span>
                )}
            </div>
        )
    }
</div>
